---
/**
 * Navbar — Shared navigation bar for public pages.
 * Responsive: desktop links hidden on mobile, hamburger menu shown.
 */
---

<nav
  class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl shadow-[0px_12px_32px_rgba(26,28,28,0.06)]"
  aria-label="Main navigation"
>
  <div class="flex justify-between items-center px-4 md:px-8 py-4 max-w-7xl mx-auto">
    <!-- Logo -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-3" aria-label="Digital Papyrus Home">
        <img src="/logo.png" alt="Digital Papyrus Logo" class="h-8 w-auto" width="32" height="32" loading="eager" />
        <span class="text-xl md:text-2xl font-headline font-bold tracking-tight text-primary">
          Digital Papyrus
        </span>
      </a>
    </div>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center gap-8 font-headline font-bold tracking-tight">
      <a class="text-primary/60 hover:text-tertiary transition-colors duration-300" href="/katalog">Katalog</a>
      <a class="text-primary/60 hover:text-tertiary transition-colors duration-300" href="/#layanan">Layanan</a>
      <a class="text-primary/60 hover:text-tertiary transition-colors duration-300" href="/#promo">Promo</a>
      <a class="text-primary/60 hover:text-tertiary transition-colors duration-300" href="/#contact">Kontak</a>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4 md:gap-6">
      <!-- Search (Desktop) -->
      <div class="hidden lg:flex relative items-center bg-surface-container px-3 py-2 rounded-lg transition-all focus-within:bg-surface-container-lowest focus-within:ring-1 focus-within:ring-primary/20">
        <span class="material-symbols-outlined text-outline text-base mr-2">search</span>
        <input
          id="navbarSearch"
          class="bg-transparent border-none outline-none focus:ring-0 focus:outline-none text-sm w-56 placeholder:text-outline-variant"
          placeholder="Cari literatur..."
          type="text"
          aria-label="Search books"
        />
        <!-- Search Results Dropdown -->
        <div
          id="searchResults"
          class="absolute top-full left-0 right-0 mt-1 bg-surface-container-low border border-outline-variant/20 rounded-md shadow-xl max-h-96 overflow-y-auto hidden z-50"
        >
          <div id="searchResultsContent" class="p-4"></div>
        </div>
      </div>

      <!-- Cart -->
      <div class="relative cursor-pointer group flex items-center justify-center w-10 h-10 rounded-full hover:bg-surface-container transition-colors" aria-label="Shopping cart">
        <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors text-[26px]">shopping_cart</span>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden text-primary"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-surface border-t border-outline-variant/20 px-6 py-4 space-y-4 font-headline font-bold">
    <a class="block text-primary/80 hover:text-tertiary py-2" href="/katalog">Katalog</a>
    <a class="block text-primary/80 hover:text-tertiary py-2" href="/#layanan">Layanan</a>
    <a class="block text-primary/80 hover:text-tertiary py-2" href="/#promo">Promo</a>
    <a class="block text-primary/80 hover:text-tertiary py-2" href="/#contact">Kontak</a>
  </div>
</nav>

<script>
  import { getBooks } from '../lib/api';

  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const navbarSearch = document.getElementById('navbarSearch') as HTMLInputElement;
  const searchResults = document.getElementById('searchResults');
  const searchResultsContent = document.getElementById('searchResultsContent');

  // Mobile menu toggle
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      toggleBtn.setAttribute('aria-expanded', String(!isOpen));
      const icon = toggleBtn.querySelector('span');
      if (icon) icon.textContent = isOpen ? 'menu' : 'close';
    });
  }

  // Search functionality with debounce
  let searchTimeout: ReturnType<typeof setTimeout>;
  if (navbarSearch) {
    navbarSearch.addEventListener('input', async (e) => {
      clearTimeout(searchTimeout);
      const query = (e.target as HTMLInputElement).value.trim();

      if (query.length < 2) {
        searchResults?.classList.add('hidden');
        return;
      }

      searchTimeout = setTimeout(async () => {
        try {
          const { books } = await getBooks({
            search: query,
            status: 'published',
            per_page: 6,
          });

          if (books.length === 0) {
            if (searchResultsContent) {
              searchResultsContent.innerHTML = '<div class="text-center py-4 text-on-surface-variant">Tidak ada hasil ditemukan</div>';
            }
          } else {
            if (searchResultsContent) {
              searchResultsContent.innerHTML = books
                .map(
                  (book) => `
                <a href="/katalog" class="flex items-start gap-3 p-3 hover:bg-surface-container rounded-md transition-colors border-b border-outline-variant/10 last:border-b-0">
                  <img src="${book.image_url}" alt="${book.title}" class="w-12 h-16 object-cover rounded" />
                  <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-bold text-primary truncate">${book.title}</h4>
                    <p class="text-xs text-on-surface-variant truncate">${book.author}</p>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-xs font-bold text-tertiary">Rp ${book.price.toLocaleString('id-ID')}</span>
                      <span class="text-xs text-on-surface-variant">★ ${book.rating}</span>
                    </div>
                  </div>
                </a>
              `
                )
                .join('');
            }
          }

          searchResults?.classList.remove('hidden');
        } catch (error) {
          console.error('Search error:', error);
          if (searchResultsContent) {
            searchResultsContent.innerHTML =
              '<div class="text-center py-4 text-error">Gagal memuat hasil</div>';
          }
        }
      }, 300);
    });

    // Hide results when clicking outside
    document.addEventListener('click', (e) => {
      if (!navbarSearch.contains(e.target as Node) && !searchResults?.contains(e.target as Node)) {
        searchResults?.classList.add('hidden');
      }
    });
  }
</script>
