---
/**
 * Footer — Shared footer for public pages.
 */
---

<footer
  class="w-full rounded-t-2xl bg-surface-container-low text-primary"
  role="contentinfo"
>
  <div
    class="flex flex-col md:flex-row justify-between items-center px-6 md:px-12 py-12 md:py-16 gap-8 max-w-7xl mx-auto"
  >
    <!-- Brand -->
    <div class="flex items-center gap-3">
      <img
        src="/logo.png"
        alt="Digital Papyrus Logo"
        class="h-6 w-auto opacity-80"
        width="24"
        height="24"
        loading="lazy"
      />
      <span class="text-lg font-body font-black text-primary">
        Digital Papyrus
      </span>
    </div>

    <!-- Links -->
    <nav
      class="flex flex-wrap justify-center gap-6 md:gap-8 font-body text-sm leading-relaxed"
      aria-label="Footer navigation"
    >
      <button
        id="openPrivacyModalBtn"
        type="button"
        class="opacity-70 hover:opacity-100 hover:text-tertiary transition-opacity duration-200 cursor-pointer"
        >Privacy Policy</button
      >
      <button
        id="openTermsModalBtn"
        type="button"
        class="opacity-70 hover:opacity-100 hover:text-tertiary transition-opacity duration-200 cursor-pointer"
        >Terms of Service</button
      >
      <a
        class="opacity-70 hover:opacity-100 hover:text-tertiary transition-opacity duration-200"
        href="/#contact">Contact</a
      >
    </nav>

    <!-- Copyright -->
    <div class="text-sm font-body opacity-70">&copy; 2026 Digital Papyrus</div>
  </div>
</footer>

<!-- Privacy Policy Modal -->
<div
  id="privacyModal"
  class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="privacyModalTitle"
>
  <div
    class="bg-surface-container-lowest border border-stone-200 rounded-2xl max-w-2xl w-full max-h-[85vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200"
  >
    <!-- Header -->
    <div
      class="p-5 md:p-6 border-b border-stone-200 flex items-center justify-between bg-surface-container-low"
    >
      <div class="flex items-center gap-2.5">
        <span class="material-symbols-outlined text-primary text-xl"
          >shield</span
        >
        <h3
          id="privacyModalTitle"
          class="text-base md:text-lg font-headline font-bold text-primary"
        >
          Kebijakan Privasi (Privacy Policy)
        </h3>
      </div>
      <button
        id="closePrivacyModalBtn"
        type="button"
        class="text-stone-400 hover:text-stone-700 p-1.5 rounded-lg hover:bg-stone-100 transition-colors cursor-pointer"
        aria-label="Tutup modal privasi"
      >
        <span class="material-symbols-outlined text-xl">close</span>
      </button>
    </div>
    <!-- Body -->
    <div
      class="p-5 md:p-6 overflow-y-auto space-y-4 font-body text-xs md:text-sm text-stone-700 leading-relaxed"
    >
      <div>
        <h4 class="font-bold text-stone-900 mb-1">
          1. Pengumpulan Data Penulis & Pelanggan
        </h4>
        <p>
          Digital Papyrus mengumpulkan data pribadi berupa nama lengkap, alamat
          email, nomor telepon (+62), alamat pengiriman, serta data naskah karya
          yang diunggah oleh Penulis untuk pemrosesan penerbitan, pendaftaran
          legalitas (ISBN/QRCBN/GGKEY), dan distribusi cetak.
        </p>
      </div>
      <div>
        <h4 class="font-bold text-stone-900 mb-1">
          2. Kerahasiaan Naskah & Hak Cipta (Nondisclosure)
        </h4>
        <p>
          Seluruh draft naskah dan aset karya literatur yang diunggah Penulis
          dijamin kerahasiaannya. Digital Papyrus tidak akan menyebarluaskan,
          memperbanyak, atau mempublikasikan naskah tanpa izin tertulis dari
          Penulis.
        </p>
      </div>
      <div>
        <h4 class="font-bold text-stone-900 mb-1">
          3. Penggunaan Data Operasional & Distribusi
        </h4>
        <p>
          Informasi pelanggan dan penulis digunakan terbatas untuk proses
          percetakan buku, verifikasi pesanan, pengiriman logistik via kurir
          ekspedisi, serta pencatatan royalti penerbitan secara transparan.
        </p>
      </div>
      <div>
        <h4 class="font-bold text-stone-900 mb-1">
          4. Hak Akses & Keamanan Data
        </h4>
        <p>
          Kami menerapkan standar enkripsi data untuk melindungi privasi
          pengguna. Penulis dan Pelanggan berhak memperbarui informasi profil
          atau meminta pembaharuan data melalui menu Pengaturan Profil.
        </p>
      </div>
    </div>
    <!-- Footer -->
    <div
      class="p-4 border-t border-stone-200 bg-surface-container-low flex justify-end"
    >
      <button
        id="confirmPrivacyBtn"
        type="button"
        class="px-5 py-2.5 bg-primary text-white text-xs font-bold rounded-xl hover:opacity-90 transition-opacity cursor-pointer"
      >
        Saya Mengerti
      </button>
    </div>
  </div>
</div>

<!-- Terms of Service Modal -->
<div
  id="termsModal"
  class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="termsModalTitle"
>
  <div
    class="bg-surface-container-lowest border border-stone-200 rounded-2xl max-w-2xl w-full max-h-[85vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200"
  >
    <!-- Header -->
    <div
      class="p-5 md:p-6 border-b border-stone-200 flex items-center justify-between bg-surface-container-low"
    >
      <div class="flex items-center gap-2.5">
        <span class="material-symbols-outlined text-primary text-xl">gavel</span
        >
        <h3
          id="termsModalTitle"
          class="text-base md:text-lg font-headline font-bold text-primary"
        >
          Syarat & Ketentuan (Terms of Service)
        </h3>
      </div>
      <button
        id="closeTermsModalBtn"
        type="button"
        class="text-stone-400 hover:text-stone-700 p-1.5 rounded-lg hover:bg-stone-100 transition-colors cursor-pointer"
        aria-label="Tutup modal syarat dan ketentuan"
      >
        <span class="material-symbols-outlined text-xl">close</span>
      </button>
    </div>
    <!-- Body -->
    <div
      class="p-5 md:p-6 overflow-y-auto space-y-4 font-body text-xs md:text-sm text-stone-700 leading-relaxed"
    >
      <div>
        <h4 class="font-bold text-stone-900 mb-1">1. Ketentuan Umum</h4>
        <p>
          Dengan melakukan transaksi di Digital Papyrus, Anda menyetujui seluruh
          ketentuan operasional layanan penjualan buku dan jasa penerbitan
          naskah.
        </p>
      </div>
      <div class="p-4 bg-rose-50 border-l-4 border-rose-600 rounded-r-xl">
        <h4 class="font-bold text-rose-900 mb-1 flex items-center gap-2">
          <span class="material-symbols-outlined text-sm">block</span> 2. Kebijakan
          Tanpa Pengembalian Dana (Non-Refundable Policy)
        </h4>
        <p class="text-rose-800 text-xs md:text-sm font-semibold">
          Seluruh pesanan yang <strong
            >SUDAH DIKONFIRMASI (Status Confirmed / Diproses) BERSIFAT FINAL DAN
            TIDAK DAPAT DIKEMBALIKAN DANA (NON-REFUNDABLE)</strong
          > dengan alasan apa pun. Pengajuan retur/refund hanya berlaku jika produk
          fisik terbukti rusak saat diterima dari kurir dan wajib menyertakan video
          unboxing.
        </p>
      </div>
      <div>
        <h4 class="font-bold text-stone-900 mb-1">
          3. Hak Cipta & Kekayaan Intelektual
        </h4>
        <p>
          Seluruh konten naskah dan buku dilindungi oleh undang-undang hak
          cipta. Penulis memegang hak cipta karya, sedangkan Digital Papyrus
          memiliki hak eksklusif percetakan dan distribusi sesuai perjanjian.
        </p>
      </div>
      <div>
        <h4 class="font-bold text-stone-900 mb-1">4. Perubahan Ketentuan</h4>
        <p>
          Digital Papyrus berhak memperbarui syarat dan ketentuan ini
          sewaktu-waktu tanpa pemberitahuan sebelumnya.
        </p>
      </div>
    </div>
    <!-- Footer -->
    <div
      class="p-4 border-t border-stone-200 bg-surface-container-low flex justify-end"
    >
      <button
        id="confirmTermsBtn"
        type="button"
        class="px-5 py-2.5 bg-primary text-white text-xs font-bold rounded-xl hover:opacity-90 transition-opacity cursor-pointer"
      >
        Saya Setuju
      </button>
    </div>
  </div>
</div>

<script>
  function setupModals() {
    const privacyModal = document.getElementById("privacyModal");
    const termsModal = document.getElementById("termsModal");

    function openModal(modal: HTMLElement | null) {
      if (!modal) return;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function closeModal(modal: HTMLElement | null) {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    }

    // Expose global functions
    (window as any).openPrivacyModal = () => openModal(privacyModal);
    (window as any).openTermsModal = () => openModal(termsModal);

    // Multi-trigger listeners for Privacy Modal
    document
      .querySelectorAll(
        "#openPrivacyModalBtn, .open-privacy-modal, [data-open-privacy]",
      )
      .forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          openModal(privacyModal);
        });
      });

    document
      .getElementById("closePrivacyModalBtn")
      ?.addEventListener("click", () => closeModal(privacyModal));
    document
      .getElementById("confirmPrivacyBtn")
      ?.addEventListener("click", () => closeModal(privacyModal));

    // Multi-trigger listeners for Terms Modal
    document
      .querySelectorAll(
        "#openTermsModalBtn, .open-terms-modal, [data-open-terms]",
      )
      .forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          openModal(termsModal);
        });
      });

    document
      .getElementById("closeTermsModalBtn")
      ?.addEventListener("click", () => closeModal(termsModal));
    document
      .getElementById("confirmTermsBtn")
      ?.addEventListener("click", () => closeModal(termsModal));

    // Backdrop click
    privacyModal?.addEventListener("click", (e) => {
      if (e.target === privacyModal) closeModal(privacyModal);
    });

    termsModal?.addEventListener("click", (e) => {
      if (e.target === termsModal) closeModal(termsModal);
    });

    // Escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeModal(privacyModal);
        closeModal(termsModal);
      }
    });

    // Check hash URL
    if (window.location.hash === "#privacy") openModal(privacyModal);
    if (window.location.hash === "#terms") openModal(termsModal);

    window.addEventListener("hashchange", () => {
      if (window.location.hash === "#privacy") openModal(privacyModal);
      if (window.location.hash === "#terms") openModal(termsModal);
    });
  }

  // Run on initial load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupModals);
  } else {
    setupModals();
  }
</script>
