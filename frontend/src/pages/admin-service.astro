---
/**
 * Admin Service Management Page
 * Route: /admin-service
 * Displays publishing service packages via the backend API.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Services & Packages | Digital Papyrus" activePage="service">

  <!-- ==================== CORE SERVICE MANAGEMENT ==================== -->
  <div class="flex flex-col md:flex-row items-start md:items-baseline justify-between mb-6 md:mb-8 gap-4 mt-8">
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-primary font-headline mb-2">Service Management</h2>
      <p class="text-stone-500 font-body text-sm max-w-xl">Manage the 'Layanan Kami' offerings displayed on the homepage.</p>
    </div>
    <div class="flex gap-3 md:gap-4 w-full md:w-auto">
      <button id="addCoreBtn" class="flex-1 md:flex-none px-4 md:px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-xs md:text-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/10">
        <span class="material-symbols-outlined text-sm">add</span> <span class="hidden sm:inline">Add New Service</span>
      </button>
    </div>
  </div>

  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-8 border border-stone-200/10 shadow-sm mb-12">
    <div class="overflow-x-auto">
      <table class="w-full text-left min-w-[700px]">
        <thead>
          <tr class="text-stone-400 font-label text-[10px] uppercase tracking-widest border-b border-stone-200/30">
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Service</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Description</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Status</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="coreTableBody" class="text-sm font-body">
          <tr id="loadingCoreRow">
            <td colspan="4" class="py-16 text-center">
              <div class="flex flex-col items-center gap-3">
                <span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span>
                <p class="text-stone-400 text-sm">Loading services...</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Core Service Modal -->
  <div id="addCoreModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-2xl mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="addCoreModalContent">
      <div class="px-6 md:px-8 py-6 border-b border-stone-200/50 flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Add New Service</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="addCoreModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6 max-h-[70vh] overflow-y-auto no-scrollbar">
        <div id="addCoreAlert" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"></div>
        <form id="addCoreForm" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            <div class="md:col-span-2 space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Service Title *</label>
              <input name="title" type="text" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: Jasa Editing Naskah" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Icon (Material Symbol)</label>
              <div class="flex gap-2">
                <div class="relative flex-1">
                  <span class="icon-preview absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-primary text-lg">design_services</span>
                  <input name="icon" type="text" class="icon-input w-full bg-surface py-2.5 pl-10 pr-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="e.g. edit_document" />
                </div>
                <button type="button" class="icon-picker-toggle px-3 py-2.5 bg-surface-container rounded-xl border border-stone-200 hover:bg-stone-200/50 transition-all text-stone-500 hover:text-primary" title="Browse icons">
                  <span class="material-symbols-outlined text-lg">apps</span>
                </button>
              </div>
              <div class="icon-picker-grid hidden mt-2 p-3 bg-surface-container rounded-xl border border-stone-200/50 max-h-48 overflow-y-auto no-scrollbar">
                <div class="grid grid-cols-8 gap-1"></div>
              </div>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Sort Order</label>
              <input name="sort_order" type="number" min="0" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: 1" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Status</label>
              <select name="is_active" class="w-full bg-surface py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
              </select>
            </div>
            <div class="md:col-span-2 space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Description</label>
              <textarea name="description" class="w-full bg-surface py-3 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all h-20 resize-none" placeholder="Example: Layanan editing naskah profesional dan cepat..."></textarea>
            </div>
          </div>
        </form>
      </div>
      <div class="px-6 md:px-8 py-5 bg-surface-container flex items-center justify-end gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn px-5 py-2.5 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="addCoreModal">Cancel</button>
        <button id="saveCoreBtn" class="px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-sm hover:opacity-90 transition-all shadow-lg shadow-primary/10" type="button">Save Service</button>
      </div>
    </div>
  </div>

  <!-- Edit Core Service Modal -->
  <div id="editCoreModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-2xl mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="editCoreModalContent">
      <div class="px-6 md:px-8 py-6 border-b border-stone-200/50 flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Edit Service</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="editCoreModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6 max-h-[70vh] overflow-y-auto no-scrollbar">
        <div id="editCoreAlert" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"></div>
        <form id="editCoreForm" class="space-y-6">
          <input type="hidden" name="id" />
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            <div class="md:col-span-2 space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Service Title *</label>
              <input name="title" type="text" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Icon (Material Symbol)</label>
              <div class="flex gap-2">
                <div class="relative flex-1">
                  <span class="icon-preview absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-primary text-lg">design_services</span>
                  <input name="icon" type="text" class="icon-input w-full bg-surface py-2.5 pl-10 pr-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="e.g. edit_document" />
                </div>
                <button type="button" class="icon-picker-toggle px-3 py-2.5 bg-surface-container rounded-xl border border-stone-200 hover:bg-stone-200/50 transition-all text-stone-500 hover:text-primary" title="Browse icons">
                  <span class="material-symbols-outlined text-lg">apps</span>
                </button>
              </div>
              <div class="icon-picker-grid hidden mt-2 p-3 bg-surface-container rounded-xl border border-stone-200/50 max-h-48 overflow-y-auto no-scrollbar">
                <div class="grid grid-cols-8 gap-1"></div>
              </div>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Sort Order</label>
              <input name="sort_order" type="number" min="0" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Status</label>
              <select name="is_active" class="w-full bg-surface py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
              </select>
            </div>
            <div class="md:col-span-2 space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Description</label>
              <textarea name="description" class="w-full bg-surface py-3 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all h-20 resize-none"></textarea>
            </div>
          </div>
        </form>
      </div>
      <div class="px-6 md:px-8 py-5 bg-surface-container flex items-center justify-end gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn px-5 py-2.5 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="editCoreModal">Cancel</button>
        <button id="updateCoreBtn" class="px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-sm hover:opacity-90 transition-all shadow-lg shadow-primary/10" type="button">Save Changes</button>
      </div>
    </div>
  </div>

  <!-- Delete Core Modal -->
  <div id="deleteCoreModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-sm mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="deleteCoreModalContent">
      <div class="p-6 md:p-8 text-center">
        <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-3xl text-red-500">delete_forever</span>
        </div>
        <h3 class="text-lg font-bold text-primary font-headline mb-2">Delete Service?</h3>
        <p class="text-sm text-stone-500">This action cannot be undone. The service "<span id="deleteCoreTitle" class="font-semibold text-stone-700"></span>" will be permanently removed.</p>
      </div>
      <div class="px-6 md:px-8 py-4 bg-surface-container flex items-center justify-center gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn flex-1 px-5 py-2.5 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="deleteCoreModal">Cancel</button>
        <button id="confirmDeleteCoreBtn" class="flex-1 px-5 py-2.5 bg-red-500 text-white font-bold rounded-xl text-sm hover:bg-red-600 transition-all">Delete</button>
      </div>
    </div>
  </div>

  <!-- ==================== END CORE SERVICE ==================== -->

  <!-- Header -->
  <div class="flex flex-col md:flex-row items-start md:items-baseline justify-between mb-6 md:mb-8 gap-4">
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-primary font-headline mb-2">Package Management</h2>
      <p class="text-stone-500 font-body text-sm max-w-xl">Manage publishing service packages, pricing tiers, and feature configurations.</p>
    </div>
    <div class="flex gap-3 md:gap-4 w-full md:w-auto">
      <button id="addServiceBtn" class="flex-1 md:flex-none px-4 md:px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-xs md:text-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/10">
        <span class="material-symbols-outlined text-sm">add</span> <span class="hidden sm:inline">Add New Package</span>
      </button>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-6 border border-stone-200/20 shadow-sm mb-6 md:mb-8 flex flex-col md:flex-row flex-wrap items-start md:items-center gap-3 md:gap-4 justify-between">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4 flex-1 w-full md:w-auto">
      <div class="relative w-full sm:max-w-sm">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm">search</span>
        <input id="searchInput" class="w-full bg-surface-container py-2.5 pl-10 pr-4 rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-stone-400" placeholder="Search by package title..." type="text" />
      </div>
      <div class="flex gap-3">
        <select id="tierFilter" class="bg-surface-container py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 text-stone-600 outline-none">
          <option value="">All Tiers</option>
          <option value="basic">Basic</option>
          <option value="silver">Silver</option>
          <option value="gold">Gold</option>
          <option value="platinum">Platinum</option>
        </select>
        <select id="statusFilter" class="bg-surface-container py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 text-stone-600 outline-none">
          <option value="">Any Status</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Data Table -->
  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-8 border border-stone-200/10 shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left min-w-[700px]">
        <thead>
          <tr class="text-stone-400 font-label text-[10px] uppercase tracking-widest border-b border-stone-200/30">
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Package</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Tier</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Price</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Featured</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Status</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="serviceTableBody" class="text-sm font-body">
          <tr id="loadingRow">
            <td colspan="6" class="py-16 text-center">
              <div class="flex flex-col items-center gap-3">
                <span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span>
                <p class="text-stone-400 text-sm">Loading packages...</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-stone-200/20 pt-6 gap-4">
      <p id="paginationInfo" class="text-xs text-stone-400 font-medium">Loading...</p>
      <div id="paginationControls" class="flex gap-1.5"></div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-6 right-6 z-[10000] hidden transform translate-y-4 opacity-0 transition-all duration-300">
    <div class="flex items-center gap-3 bg-stone-800 text-white px-5 py-3 rounded-xl shadow-2xl text-sm font-medium">
      <span id="toastIcon" class="material-symbols-outlined text-lg text-teal-400">check_circle</span>
      <span id="toastMsg">Operation successful</span>
    </div>
  </div>

  <!-- View Service Modal -->
  <div id="viewServiceModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-2xl mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="viewServiceModalContent">
      <div class="px-6 md:px-8 py-6 border-b border-stone-200/50 flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Package Details</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="viewServiceModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6 max-h-[70vh] overflow-y-auto no-scrollbar space-y-5">
        <div class="flex items-center gap-4">
          <div id="viewServiceIcon" class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl text-primary">design_services</span>
          </div>
          <div>
            <h4 id="viewServiceTitle" class="text-xl font-bold text-primary font-headline"></h4>
            <div class="flex items-center gap-2 mt-1">
              <span id="viewServiceTier" class="text-xs font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full"></span>
              <span id="viewServiceBadge" class="text-xs font-bold text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded-full hidden"></span>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-y-4">
          <div><p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Price</p><p id="viewServicePrice" class="text-sm font-bold text-primary"></p></div>
          <div><p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Status</p><p id="viewServiceStatus" class="text-sm font-medium"></p></div>
          <div><p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Sort Order</p><p id="viewServiceOrder" class="text-sm font-medium text-stone-700"></p></div>
          <div><p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Featured</p><p id="viewServiceFeatured" class="text-sm font-medium"></p></div>
        </div>
        <div>
          <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Description</p>
          <p id="viewServiceDesc" class="text-sm text-stone-600 leading-relaxed"></p>
        </div>
        <div>
          <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-2">Features</p>
          <ul id="viewServiceFeatures" class="space-y-1.5"></ul>
        </div>
      </div>
      <div class="px-6 md:px-8 py-5 bg-surface-container flex items-center justify-end gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn px-5 py-2.5 border border-stone-300 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="viewServiceModal">Close</button>
      </div>
    </div>
  </div>

  <!-- Add Service Modal -->
  <div id="addServiceModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-2xl mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="addServiceModalContent">
      <div class="px-6 md:px-8 py-6 border-b border-stone-200/50 flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Add New Package</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="addServiceModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6 max-h-[70vh] overflow-y-auto no-scrollbar">
        <div id="addServiceAlert" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"></div>
        <form id="addServiceForm" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            <div class="md:col-span-2 space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Package Title *</label>
              <input name="title" type="text" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: Paket Penerbitan Gold" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Tier *</label>
              <select name="tier" class="w-full bg-surface py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                <option value="basic">Basic</option>
                <option value="silver">Silver</option>
                <option value="gold">Gold</option>
                <option value="platinum">Platinum</option>
              </select>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Icon (Material Symbol)</label>
              <div class="flex gap-2">
                <div class="relative flex-1">
                  <span class="icon-preview absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-primary text-lg">design_services</span>
                  <input name="icon" type="text" class="icon-input w-full bg-surface py-2.5 pl-10 pr-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="e.g. edit_document" />
                </div>
                <button type="button" class="icon-picker-toggle px-3 py-2.5 bg-surface-container rounded-xl border border-stone-200 hover:bg-stone-200/50 transition-all text-stone-500 hover:text-primary" title="Browse icons">
                  <span class="material-symbols-outlined text-lg">apps</span>
                </button>
              </div>
              <div class="icon-picker-grid hidden mt-2 p-3 bg-surface-container rounded-xl border border-stone-200/50 max-h-48 overflow-y-auto no-scrollbar">
                <div class="grid grid-cols-8 gap-1"></div>
              </div>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Price (Rp)</label>
              <input name="price" type="number" min="0" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: 275000" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Price Label</label>
              <input name="price_label" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: Rp 275k" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Badge</label>
              <input name="badge" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: Terpopuler" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Sort Order</label>
              <input name="sort_order" type="number" min="0" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: 1" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Status</label>
              <select name="is_active" class="w-full bg-surface py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                <option value="true">Active</option>
