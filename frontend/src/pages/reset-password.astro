---
/**
 * Reset Password Page
 * Route: /reset-password
 */
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Reset Password | Digital Papyrus">
  <div class="w-full max-w-md bg-surface-container-lowest rounded-2xl shadow-xl p-8 md:p-10 border border-outline-variant/10">
    <div class="text-center mb-8 md:mb-10">
      <h2 class="font-headline text-2xl md:text-3xl font-bold tracking-tight text-primary">Reset Password</h2>
      <p class="text-on-surface-variant text-sm md:text-base mt-2">Enter your new password below.</p>
    </div>

    <form class="space-y-6" id="reset-form" novalidate>
      <!-- Password -->
      <div>
        <label class="block text-sm font-medium text-primary mb-2" for="password-input">New Password *</label>
        <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
          <span class="material-symbols-outlined text-outline text-lg mr-3">lock</span>
          <input id="password-input" type="password" placeholder="Min 6 characters" required class="bg-transparent w-full text-sm focus:outline-none text-on-surface placeholder:text-outline-variant" />
          <button type="button" id="toggle-password" class="text-outline hover:text-primary transition-colors ml-2 focus:outline-none flex items-center justify-center">
            <span class="material-symbols-outlined text-lg leading-none">visibility</span>
          </button>
        </div>
        <!-- Strength Indicator for Password -->
        <div id="password-strength-container" class="mt-2 hidden">
          <div class="flex justify-between items-center text-xs mb-1">
            <span class="text-on-surface-variant">Password Strength:</span>
            <span id="password-strength-label" class="font-bold"></span>
          </div>
          <div class="h-1.5 w-full bg-surface-container rounded-full overflow-hidden flex gap-1">
            <div id="password-bar-1" class="h-full w-1/3 rounded-full transition-all bg-surface-container-high"></div>
            <div id="password-bar-2" class="h-full w-1/3 rounded-full transition-all bg-surface-container-high"></div>
            <div id="password-bar-3" class="h-full w-1/3 rounded-full transition-all bg-surface-container-high"></div>
          </div>
        </div>
      </div>

      <!-- Confirm Password -->
      <div>
        <label class="block text-sm font-medium text-primary mb-2" for="confirm-password-input">Confirm Password *</label>
        <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
          <span class="material-symbols-outlined text-outline text-lg mr-3">lock</span>
          <input id="confirm-password-input" type="password" placeholder="Confirm your password" required class="bg-transparent w-full text-sm focus:outline-none text-on-surface placeholder:text-outline-variant" />
          <button type="button" id="toggle-confirm-password" class="text-outline hover:text-primary transition-colors ml-2 focus:outline-none flex items-center justify-center">
            <span class="material-symbols-outlined text-lg leading-none">visibility</span>
          </button>
        </div>
        <!-- Strength and Match Validation for Confirm Password -->
        <div id="confirm-password-strength-container" class="mt-2 hidden">
          <div class="flex justify-between items-center text-xs mb-1">
            <span id="confirm-password-match-label" class="font-bold text-red-500">Passwords do not match</span>
            <span id="confirm-password-strength-label" class="font-bold text-outline-variant"></span>
          </div>
          <div class="h-1.5 w-full bg-surface-container rounded-full overflow-hidden flex gap-1">
            <div id="confirm-bar-1" class="h-full w-1/3 rounded-full transition-all bg-surface-container-high"></div>
            <div id="confirm-bar-2" class="h-full w-1/3 rounded-full transition-all bg-surface-container-high"></div>
            <div id="confirm-bar-3" class="h-full w-1/3 rounded-full transition-all bg-surface-container-high"></div>
          </div>
        </div>
      </div>

      <button
        type="submit"
        id="submit-btn"
        disabled
        class="w-full py-4 bg-primary text-on-primary font-bold rounded-xl shadow-md hover:bg-primary/90 flex items-center justify-center gap-2 transition-all text-base disabled:opacity-40 disabled:grayscale disabled:cursor-not-allowed"
      >
        <span class="material-symbols-outlined text-sm" id="btn-icon">lock_reset</span>
        <span id="btn-text">Reset Password</span>
      </button>
    </form>
  </div>

  <!-- Custom Status Modal Popup -->
  <div id="status-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-900/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant/20 rounded-2xl max-w-sm w-full p-6 shadow-2xl scale-95 transition-transform duration-300" id="status-modal-content">
      <div class="flex flex-col items-center text-center">
        <!-- Status Icon Circle -->
        <div id="status-modal-icon-bg" class="w-16 h-16 rounded-full flex items-center justify-center mb-4">
          <span id="status-modal-icon" class="material-symbols-outlined text-3xl">info</span>
        </div>
        <h3 id="status-modal-title" class="font-headline font-bold text-lg text-primary mb-2">Notice</h3>
        <p id="status-modal-message" class="text-sm text-on-surface-variant leading-relaxed mb-6"></p>
        <button id="status-modal-close" class="w-full py-3 bg-primary text-on-primary font-bold rounded-xl shadow-md hover:bg-primary/90 transition-all text-sm">
          Okay
        </button>
      </div>
    </div>
  </div>
</AuthLayout>

<style is:global>
  input::-ms-reveal,
  input::-ms-clear {
    display: none;
  }
</style>

<script>
  import { resetPassword } from '../lib/api';

  // Read URL query params
  const urlParams = new URLSearchParams(window.location.search);
  const token = urlParams.get('token') || '';
  const email = urlParams.get('email') || '';

  const form = document.getElementById('reset-form') as HTMLFormElement;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const togglePasswordBtn = document.getElementById('toggle-password') as HTMLButtonElement;
  const confirmPasswordInput = document.getElementById('confirm-password-input') as HTMLInputElement;
  const toggleConfirmPasswordBtn = document.getElementById('toggle-confirm-password') as HTMLButtonElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnIcon = document.getElementById('btn-icon')!;
  const btnText = document.getElementById('btn-text')!;

  // Modal elements
  const statusModal = document.getElementById('status-modal')!;
  const statusModalContent = document.getElementById('status-modal-content')!;
  const statusModalIconBg = document.getElementById('status-modal-icon-bg')!;
  const statusModalIcon = document.getElementById('status-modal-icon')!;
  const statusModalTitle = document.getElementById('status-modal-title')!;
  const statusModalMessage = document.getElementById('status-modal-message')!;
  const statusModalClose = document.getElementById('status-modal-close')!;

  let redirectUrlOnClose = '';

  function showModal(title: string, message: string, type: 'info' | 'error' | 'success' = 'info', redirectUrl = '') {
    redirectUrlOnClose = redirectUrl;
    statusModalTitle.textContent = title;
    statusModalMessage.textContent = message;

    statusModalIconBg.className = 'w-16 h-16 rounded-full flex items-center justify-center mb-4';
    statusModalIcon.className = 'material-symbols-outlined text-3xl';

    if (type === 'success') {
      statusModalIconBg.classList.add('bg-green-500/10', 'text-green-600');
      statusModalIcon.textContent = 'check_circle';
      statusModalClose.className = 'w-full py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-xl shadow-md transition-all text-sm';
    } else if (type === 'error') {
      statusModalIconBg.classList.add('bg-red-500/10', 'text-red-600');
      statusModalIcon.textContent = 'error';
      statusModalClose.className = 'w-full py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl shadow-md transition-all text-sm';
    } else {
      statusModalIconBg.classList.add('bg-primary/10', 'text-primary');
      statusModalIcon.textContent = 'info';
      statusModalClose.className = 'w-full py-3 bg-primary hover:bg-primary/90 text-on-primary font-bold rounded-xl shadow-md transition-all text-sm';
    }

    statusModal.classList.remove('hidden');
    requestAnimationFrame(() => {
      statusModal.classList.remove('opacity-0');
      statusModal.classList.add('opacity-100');
      statusModalContent.classList.remove('scale-95');
      statusModalContent.classList.add('scale-100');
    });
  }

  function hideModal() {
    statusModal.classList.remove('opacity-100');
    statusModal.classList.add('opacity-0');
    statusModalContent.classList.remove('scale-100');
    statusModalContent.classList.add('scale-95');
    setTimeout(() => {
      statusModal.classList.add('hidden');
      if (redirectUrlOnClose) {
        window.location.href = redirectUrlOnClose;
      }
    }, 300);
  }

  if (statusModalClose) {
    statusModalClose.addEventListener('click', hideModal);
  }
  if (statusModal) {
    statusModal.addEventListener('click', (e) => {
      if (e.target === statusModal) {
        hideModal();
      }
    });
  }

  // Toggles
  if (togglePasswordBtn && passwordInput) {
    togglePasswordBtn.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      const icon = togglePasswordBtn.querySelector('.material-symbols-outlined');
      if (icon) icon.textContent = isPassword ? 'visibility_off' : 'visibility';
    });
  }

  if (toggleConfirmPasswordBtn && confirmPasswordInput) {
    toggleConfirmPasswordBtn.addEventListener('click', () => {
      const isPassword = confirmPasswordInput.type === 'password';
      confirmPasswordInput.type = isPassword ? 'text' : 'password';
      const icon = toggleConfirmPasswordBtn.querySelector('.material-symbols-outlined');
      if (icon) icon.textContent = isPassword ? 'visibility_off' : 'visibility';
    });
  }

  // Password Strength Logic
  function checkStrength(val: string) {
    if (!val) return { label: '', color: 'text-outline-variant', score: 0 };
    if (val.length < 6) {
      return { label: 'Weak (Min 6 chars)', color: 'text-red-500', score: 1 };
    }
    
    let score = 0;
    if (/[a-zA-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^a-zA-Z0-9]/.test(val)) score++;
    
    if (val.length >= 8 && score >= 3) {
      return { label: 'Strong', color: 'text-green-600', score: 3 };
    } else if (score >= 2) {
      return { label: 'Medium', color: 'text-yellow-600', score: 2 };
    }
    
    return { label: 'Weak', color: 'text-red-500', score: 1 };
  }

  function updateBarColors(bar1: HTMLElement, bar2: HTMLElement, bar3: HTMLElement, score: number) {
    bar1.className = 'h-full w-1/3 rounded-full transition-all';
    bar2.className = 'h-full w-1/3 rounded-full transition-all';
    bar3.className = 'h-full w-1/3 rounded-full transition-all';
    
    if (score === 1) {
      bar1.classList.add('bg-red-500');
      bar2.classList.add('bg-surface-container-high');
      bar3.classList.add('bg-surface-container-high');
    } else if (score === 2) {
      bar1.classList.add('bg-yellow-600');
      bar2.classList.add('bg-yellow-600');
      bar3.classList.add('bg-surface-container-high');
    } else if (score === 3) {
      bar1.classList.add('bg-green-600');
      bar2.classList.add('bg-green-600');
      bar3.classList.add('bg-green-600');
    } else {
      bar1.classList.add('bg-surface-container-high');
      bar2.classList.add('bg-surface-container-high');
      bar3.classList.add('bg-surface-container-high');
    }
  }

  const passwordStrengthContainer = document.getElementById('password-strength-container')!;
  const passwordStrengthLabel = document.getElementById('password-strength-label')!;
  const passwordBar1 = document.getElementById('password-bar-1')!;
  const passwordBar2 = document.getElementById('password-bar-2')!;
  const passwordBar3 = document.getElementById('password-bar-3')!;

  const confirmPasswordStrengthContainer = document.getElementById('confirm-password-strength-container')!;
  const confirmPasswordMatchLabel = document.getElementById('confirm-password-match-label')!;
  const confirmPasswordStrengthLabel = document.getElementById('confirm-password-strength-label')!;
  const confirmBar1 = document.getElementById('confirm-bar-1')!;
  const confirmBar2 = document.getElementById('confirm-bar-2')!;
  const confirmBar3 = document.getElementById('confirm-bar-3')!;

  function updateSubmitState() {
    const password = passwordInput.value;
    const confirmPassword = confirmPasswordInput.value;
    const passwordsMatch = password && (password === confirmPassword);
    const isPasswordValid = password.length >= 6;
    submitBtn.disabled = !(passwordsMatch && isPasswordValid && token && email);
  }

  function handlePasswordInput() {
    const val = passwordInput.value;
    if (!val) {
      passwordStrengthContainer.classList.add('hidden');
    } else {
      passwordStrengthContainer.classList.remove('hidden');
      const res = checkStrength(val);
      passwordStrengthLabel.textContent = res.label;
      passwordStrengthLabel.className = `font-bold ${res.color}`;
      updateBarColors(passwordBar1, passwordBar2, passwordBar3, res.score);
    }
    
    if (confirmPasswordInput.value) {
      handleConfirmPasswordInput();
    }
    updateSubmitState();
  }

  function handleConfirmPasswordInput() {
    const pVal = passwordInput.value;
    const cVal = confirmPasswordInput.value;
    
    if (!cVal) {
      confirmPasswordStrengthContainer.classList.add('hidden');
    } else {
      confirmPasswordStrengthContainer.classList.remove('hidden');
      if (pVal !== cVal) {
        confirmPasswordMatchLabel.textContent = 'Passwords do not match';
        confirmPasswordMatchLabel.className = 'font-bold text-red-500';
        confirmPasswordStrengthLabel.textContent = '';
        updateBarColors(confirmBar1, confirmBar2, confirmBar3, 0);
      } else {
        confirmPasswordMatchLabel.textContent = 'Passwords match';
        confirmPasswordMatchLabel.className = 'font-bold text-green-600';
        const res = checkStrength(cVal);
        confirmPasswordStrengthLabel.textContent = res.label;
        confirmPasswordStrengthLabel.className = `font-bold ${res.color}`;
        updateBarColors(confirmBar1, confirmBar2, confirmBar3, res.score);
      }
    }
    updateSubmitState();
  }

  passwordInput.addEventListener('input', handlePasswordInput);
  confirmPasswordInput.addEventListener('input', handleConfirmPasswordInput);

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Resetting password...' : 'Reset Password';
    btnIcon.textContent = loading ? 'hourglass_empty' : 'lock_reset';
    if (loading) btnIcon.classList.add('animate-spin');
    else btnIcon.classList.remove('animate-spin');
  }

  // Pre-validate params
  if (!token || !email) {
    showModal('Error', 'Link reset password tidak valid atau token tidak ditemukan.', 'error');
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = passwordInput.value;
      const confirmPassword = confirmPasswordInput.value;

      if (password !== confirmPassword) {
        showModal('Error', 'Password konfirmasi tidak cocok.', 'error');
        return;
      }

      if (password.length < 6) {
        showModal('Error', 'Password harus minimal 6 karakter.', 'error');
        return;
      }

      setLoading(true);

      try {
        await resetPassword({ email, token, password });
        setLoading(false);
        showModal('Success', 'Password berhasil diperbarui!', 'success', '/customer-login');
      } catch (err: any) {
        setLoading(false);
        showModal('Error', err.message || 'Gagal mengubah password. Token mungkin sudah kedaluwarsa.', 'error');
      }
    });
  }
</script>
