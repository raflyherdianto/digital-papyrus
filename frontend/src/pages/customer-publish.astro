---
/**
 * Customer Publish Page
 * Route: /customer-publish
 * Allows customers to publish a book by linking it to a confirmed invoice,
 * uploading a draft (doc/docx, max 10MB), and submitting details for admin review.
 */
import CustomerLayout from "../layouts/CustomerLayout.astro";
---

<CustomerLayout title="Publish Book | Digital Papyrus" activePage="publish">
  <!-- Header -->
  <div class="mb-8 md:mb-12">
    <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight text-primary font-headline">
      Publish Your Book
    </h2>
    <p class="text-stone-500 font-body text-sm md:text-lg max-w-xl mt-2">
      Select a confirmed invoice to link your manuscript, fill in the metadata, and upload your draft.
    </p>
  </div>

  <div class="space-y-10">


    <!-- Invoice Selection Section -->
    <div id="invoices-section" class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
        <h3 class="text-lg font-bold text-primary font-headline flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">receipt_long</span>
          1. Pilih Invoice Layanan Penerbitan *
        </h3>
        <p class="text-xs text-stone-500">Khusus pesanan terkonfirmasi untuk paket layanan penerbitan</p>
      </div>
      
      <!-- Loading State -->
      <div id="orders-loading" class="py-12 text-center bg-surface-container-lowest rounded-2xl border border-stone-200/10 shadow-sm">
        <span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span>
        <p class="text-stone-400 mt-2 font-medium">Memuat invoice layanan terkonfirmasi...</p>
      </div>

      <!-- Empty State -->
      <div id="orders-empty" class="hidden p-8 text-center bg-surface-container-lowest rounded-2xl border border-stone-200/10 shadow-sm space-y-4">
        <div class="w-16 h-16 bg-amber-500/10 text-amber-500 rounded-full flex items-center justify-center mx-auto">
          <span class="material-symbols-outlined text-3xl">receipt_long</span>
        </div>
        <div class="space-y-1">
          <h4 class="text-base font-bold text-primary">Belum Ada Invoice Layanan Terkonfirmasi</h4>
          <p class="text-stone-500 font-body text-sm max-w-md mx-auto">
            Anda harus memiliki pesanan paket layanan penerbitan yang sudah terkonfirmasi (Confirmed) untuk dapat mengajukan draf naskah.
          </p>
        </div>
        <a href="/katalog" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-white text-xs font-bold rounded-xl shadow-lg shadow-primary/10 hover:opacity-90 transition-all">
          Lihat Paket Layanan
        </a>
      </div>

      <!-- Orders Grid -->
      <div id="orders-grid" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Rendered dynamically as Invoice cards -->
      </div>
    </div>

    <!-- Publishing Form Section (Hidden until invoice is selected) -->
    <div id="publish-form-container" class="hidden space-y-6">
      <h3 class="text-lg font-bold text-primary font-headline flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">menu_book</span>
        <span id="form-step-title">2. Isi Detail Buku</span>
      </h3>

      <div class="max-w-5xl bg-surface-container-lowest rounded-2xl border border-stone-200/10 shadow-sm p-4 sm:p-6 md:p-8">
        <!-- Selected Invoice Badge Info -->
        <div id="selected-invoice-info" class="hidden mb-6 p-4 rounded-xl bg-primary/5 border border-primary/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">receipt_long</span>
            <div>
              <p class="text-xs text-stone-500 font-medium">Invoice Terpilih</p>
              <h5 id="selected-invoice-text" class="text-sm font-bold text-primary font-mono">--</h5>
            </div>
          </div>
          <span id="selected-invoice-status-badge" class="text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full border border-emerald-200">Pesanan Terkonfirmasi</span>
        </div>

        <!-- Status Box -->
        <div id="status-box" class="hidden mb-6 p-4 rounded-xl border flex items-center gap-3 text-sm font-medium">
          <span class="material-symbols-outlined text-lg" id="status-icon">info</span>
          <span id="status-message"></span>
        </div>

        <form id="publish-form" class="space-y-6" novalidate>
          <!-- Hidden selected order input -->
          <input type="hidden" id="selected-order-id" required />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Book Title -->
            <div class="md:col-span-2">
              <label class="block text-sm font-bold text-primary mb-2" for="title-input">Book Title *</label>
              <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
                <span class="material-symbols-outlined text-outline text-lg mr-3">title</span>
                <input id="title-input" type="text" required placeholder="e.g. The Path of Knowledge" class="bg-transparent w-full text-sm focus:outline-none text-on-surface" />
              </div>
            </div>

            <!-- Author Name -->
            <div>
              <label class="block text-sm font-bold text-primary mb-2" for="author-input">Author Name *</label>
              <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
                <span class="material-symbols-outlined text-outline text-lg mr-3">person</span>
                <input id="author-input" type="text" required placeholder="e.g. John Doe" class="bg-transparent w-full text-sm focus:outline-none text-on-surface" />
              </div>
            </div>

            <!-- Category -->
            <div>
              <label class="block text-sm font-bold text-primary mb-2" for="category-select">Category *</label>
              <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
                <span class="material-symbols-outlined text-outline text-lg mr-3">category</span>
                <select id="category-select" required class="bg-transparent w-full text-sm focus:outline-none text-on-surface cursor-pointer pr-8 appearance-none">
                  <option value="">Select a Category</option>
                  <!-- Populated dynamically -->
                </select>
                <span class="material-symbols-outlined text-outline text-lg absolute right-4 pointer-events-none">arrow_drop_down</span>
              </div>
            </div>

            <!-- Format -->
            <div>
              <label class="block text-sm font-bold text-primary mb-2" for="format-select">Format *</label>
              <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
                <span class="material-symbols-outlined text-outline text-lg mr-3">menu_book</span>
                <select id="format-select" required class="bg-transparent w-full text-sm focus:outline-none text-on-surface cursor-pointer pr-8 appearance-none">
                  <option value="Softcover">Softcover</option>
                  <option value="Hardcover">Hardcover</option>
                  <option value="E-Book">E-Book</option>
                </select>
                <span class="material-symbols-outlined text-outline text-lg absolute right-4 pointer-events-none">arrow_drop_down</span>
              </div>
            </div>

            <!-- Language -->
            <div>
              <label class="block text-sm font-bold text-primary mb-2" for="language-input">Language *</label>
              <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
                <span class="material-symbols-outlined text-outline text-lg mr-3">translate</span>
                <input id="language-input" required type="text" placeholder="e.g. Bahasa Indonesia" class="bg-transparent w-full text-sm focus:outline-none text-on-surface" />
              </div>
            </div>

            <!-- Publisher -->
            <div>
              <label class="block text-sm font-bold text-primary mb-2" for="publisher-input">Publisher</label>
              <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
                <span class="material-symbols-outlined text-outline text-lg mr-3">business</span>
                <input id="publisher-input" type="text" value="Digital Papyrus" disabled class="bg-transparent w-full text-sm focus:outline-none text-black font-bold cursor-not-allowed" />
              </div>
            </div>

            <!-- Description -->
            <div class="md:col-span-2">
              <label class="block text-sm font-bold text-primary mb-2" for="desc-input">Description *</label>
              <div class="relative flex items-start bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
                <span class="material-symbols-outlined text-outline text-lg mr-3 mt-1">description</span>
                <textarea id="desc-input" required rows="3" placeholder="Brief description of the book..." class="bg-transparent w-full text-sm focus:outline-none text-on-surface resize-none"></textarea>
              </div>
            </div>



            <!-- Existing Draft Banner (Separated) -->
            <div id="existing-draft-box" class="md:col-span-2 hidden space-y-2">
              <label class="block text-sm font-bold text-primary">Draf Naskah Terdaftar</label>
              <div class="bg-surface-container/60 border border-stone-200/60 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-xl">description</span>
                  </div>
                  <div>
                    <h5 class="text-sm font-bold text-primary" id="existing-draft-title">Draf Naskah Sebelumnya</h5>
                    <p class="text-xs text-stone-500 font-medium" id="existing-draft-filename">File naskah tersimpan di server.</p>
                  </div>
                </div>
                <a id="existing-draft-link" href="#" target="_blank" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white hover:bg-stone-50 text-primary font-bold text-xs rounded-xl border border-stone-200 shadow-sm transition-all hover:border-primary/40 shrink-0">
                  <span class="material-symbols-outlined text-sm">visibility</span>
                  <span>Lihat Draf Saat Ini</span>
                </a>
              </div>
            </div>

            <!-- Draft Upload Area -->
            <div id="draft-upload-wrapper" class="md:col-span-2 space-y-2">
              <label id="draft-upload-label" class="block text-sm font-bold text-primary mb-2">Book Draft Manuscript *</label>
              <div class="flex flex-col items-center justify-center border-2 border-dashed border-outline-variant/40 rounded-2xl p-6 bg-surface-container-low/50 hover:bg-surface-container transition-all relative" id="upload-zone">
                <input id="draft-input" type="file" required accept=".doc,.docx" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                <span class="material-symbols-outlined text-4xl text-outline mb-2" id="upload-icon">cloud_upload</span>
                <p class="text-sm font-bold text-primary" id="upload-title">Choose file or drag here</p>
                <p class="text-xs text-stone-500 mt-1" id="upload-subtitle">Only .doc or .docx formats allowed. Maximum size: 10MB.</p>
              </div>
            </div>
          </div>

          <div id="submit-container" class="flex justify-end gap-4 border-t border-stone-200/20 pt-6">
            <button type="submit" id="submit-btn" class="px-6 py-3 bg-primary text-white font-bold rounded-xl text-sm hover:opacity-90 transition-all flex items-center gap-2 shadow-lg shadow-primary/10">
              <span class="material-symbols-outlined text-sm" id="btn-icon">publish</span>
              <span id="btn-text">Submit Publish Request</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Success Success Modal -->
  <div id="success-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-surface-container-lowest rounded-2xl border border-stone-200/10 shadow-2xl p-8 max-w-sm w-full mx-4 text-center transform scale-95 transition-all duration-300">
      <div class="w-16 h-16 bg-green-500/10 text-green-500 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-4xl">check_circle</span>
      </div>
      <h3 class="text-xl font-bold text-primary font-headline mb-2">
        Permintaan Berhasil!
      </h3>
      <p class="text-stone-500 font-body text-sm mb-6">
        Permintaan publikasi dan draf Anda telah berhasil diunggah. Saat ini sedang menunggu validasi oleh admin.
      </p>
      <button id="close-modal-btn" class="w-full py-3 bg-primary text-white font-bold rounded-xl text-sm hover:opacity-90 transition-all shadow-lg shadow-primary/10">
        Tutup
      </button>
    </div>
  </div>
</CustomerLayout>

<script>
  import { getCustomerOrders, getCategories, createCustomerBook, updateCustomerBook, uploadDraft, getBooks, isAuthenticated } from "../lib/api";

  // Auth Guard
  if (!isAuthenticated()) {
    window.location.href = "/customer-login";
  }

  // DOM Elements
  const loadingEl = document.getElementById("orders-loading")!;
  const emptyEl = document.getElementById("orders-empty")!;
  const gridEl = document.getElementById("orders-grid")!;
  const formContainer = document.getElementById("publish-form-container")!;
  const invoicesSection = document.getElementById("invoices-section")!;
  const selectedOrderInput = document.getElementById("selected-order-id") as HTMLInputElement;

  const form = document.getElementById("publish-form") as HTMLFormElement;
  const titleInput = document.getElementById("title-input") as HTMLInputElement;
  const authorInput = document.getElementById("author-input") as HTMLInputElement;
  const categorySelect = document.getElementById("category-select") as HTMLSelectElement;
  const formatSelect = document.getElementById("format-select") as HTMLSelectElement;
  const languageInput = document.getElementById("language-input") as HTMLInputElement;
  const publisherInput = document.getElementById("publisher-input") as HTMLInputElement;
  const descInput = document.getElementById("desc-input") as HTMLTextAreaElement;

  const draftInput = document.getElementById("draft-input") as HTMLInputElement;
  const uploadZone = document.getElementById("upload-zone")!;
  const uploadIcon = document.getElementById("upload-icon")!;
  const uploadTitle = document.getElementById("upload-title")!;
  const uploadSubtitle = document.getElementById("upload-subtitle")!;

  const existingDraftBox = document.getElementById("existing-draft-box")!;
  const existingDraftLink = document.getElementById("existing-draft-link") as HTMLAnchorElement;
  const existingDraftTitle = document.getElementById("existing-draft-title");
  const existingDraftFilename = document.getElementById("existing-draft-filename");
  const draftUploadWrapper = document.getElementById("draft-upload-wrapper");
  const draftUploadLabel = document.getElementById("draft-upload-label");

  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const submitContainer = document.getElementById("submit-container");
  const formStepTitle = document.getElementById("form-step-title");
  const selectedInvoiceStatusBadge = document.getElementById("selected-invoice-status-badge");
  const btnIcon = document.getElementById("btn-icon")!;
  const btnText = document.getElementById("btn-text")!;
  const statusBox = document.getElementById("status-box")!;
  const statusIcon = document.getElementById("status-icon")!;
  const statusMsg = document.getElementById("status-message")!;

  const successModal = document.getElementById("success-modal")!;
  const closeModalBtn = document.getElementById("close-modal-btn")!;

  let selectedOrderId = "";
  let userDraftBooks: any[] = [];
  let userObj: any = null;

  // Helper: Status alert box
  function showStatus(message: string, type: "success" | "error") {
    statusMsg.textContent = message;
    statusBox.className = "mb-6 p-4 rounded-xl border flex items-center gap-3 text-sm font-medium";
    statusIcon.className = "material-symbols-outlined text-lg";

    if (type === "success") {
      statusBox.classList.add("bg-green-50", "border-green-200", "text-green-700");
      statusIcon.textContent = "check_circle";
    } else {
      statusBox.classList.add("bg-red-50", "border-red-200", "text-red-700");
      statusIcon.textContent = "error";
    }
    statusBox.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth" });
  }

  // Pre-fill user information if available
  const userStr = localStorage.getItem("dp_user");
  if (userStr) {
    try {
      userObj = JSON.parse(userStr);
      if (userObj && userObj.name && authorInput) {
        authorInput.value = userObj.name;
      }
    } catch (e) {
      console.error(e);
    }
  }

  // Load Invoices and Categories
  async function init() {
    try {
      // 0. Fetch user draft books
      let username = userObj ? userObj.name : "";
      if (username) {
        const { books } = await getBooks({ search: username, status: "draft", per_page: 50 });
        userDraftBooks = books || [];
      }

      function formatRupiah(amount: number): string {
        return 'Rp ' + Number(amount || 0).toLocaleString('id-ID');
      }

      // 1. Fetch Categories
      const categories = await getCategories();
      categorySelect.innerHTML = '<option value="">Select a Category</option>';
      categories.forEach(cat => {
        const opt = document.createElement("option");
        opt.value = cat.id;
        opt.textContent = cat.name;
        categorySelect.appendChild(opt);
      });

      // 2. Fetch Customer Orders
      const { orders } = await getCustomerOrders({ per_page: 100 });
      // Filter orders with status 'confirmed', 'processed', 'processing', 'completed' AND has at least one service item
      const eligibleOrders = (orders || []).filter(o => {
        const st = (o.status || "").toLowerCase();
        const isEligibleStatus = st === "confirmed" || st === "processed" || st === "processing" || st === "completed";
        const hasService = o.items && o.items.some((item: any) => (item.service_id && item.service_id.trim() !== "") || item.item_type === "service");
        return isEligibleStatus && hasService;
      });

      loadingEl.classList.add("hidden");

      if (eligibleOrders.length === 0) {
        emptyEl.classList.remove("hidden");
        return;
      }

      emptyEl.classList.add("hidden");

      // Render orders as cards
      gridEl.innerHTML = "";
      eligibleOrders.forEach(order => {
        const dateStr = new Date(order.created_at).toLocaleDateString("id-ID", {
          day: "numeric",
          month: "long",
          year: "numeric"
        });

        // Determine items preview
        const serviceItems = (order.items || []).filter((i: any) => (i.service_id && i.service_id.trim() !== "") || i.item_type === "service");
        const itemsText = serviceItems.map((i: any) => i.item_name).join(", ") || "Paket Layanan Penerbitan";
        const linkedDraft = userDraftBooks.find((b: any) => b.order_id === order.id);
        const isLinkedToDraft = !!linkedDraft;
        const valStatus = (linkedDraft?.validation_status || "").toLowerCase();
        const adminNotes = linkedDraft?.notes && linkedDraft.notes.trim() !== "" 
          ? linkedDraft.notes.trim() 
          : "Belum ada catatan dari admin.";

        const card = document.createElement("div");
        card.id = `order-card-${order.id}`;
        card.className = "bg-surface-container-lowest border border-stone-200/20 hover:border-primary/60 rounded-2xl p-6 shadow-sm cursor-pointer transition-all flex flex-col justify-between gap-4 hover:shadow-md group";
        card.innerHTML = `
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                  <span class="material-symbols-outlined text-lg">receipt_long</span>
                </div>
                <span class="text-xs font-mono font-bold text-stone-500 uppercase tracking-wider">Invoice</span>
              </div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>${order.status.toUpperCase()}
              </span>
            </div>
            <div>
              <h4 class="text-lg font-bold text-primary font-mono group-hover:text-primary/90">${order.invoice}</h4>
              <p class="text-stone-400 text-xs font-medium font-body mt-0.5 flex items-center gap-1">
                <span class="material-symbols-outlined text-xs">calendar_today</span>
                ${dateStr}
              </p>
            </div>
          </div>
          <div class="border-t border-stone-200/20 pt-3 space-y-2.5">
            <div>
              <p class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">Paket Layanan</p>
              <p class="text-sm font-semibold text-stone-800 truncate" title="${itemsText}">${itemsText}</p>
            </div>
            <div class="flex items-center justify-between pt-0.5">
              <span class="text-xs text-stone-500 font-medium">Total Biaya</span>
              <span class="text-xs font-bold text-emerald-600">${formatRupiah(order.total_price)}</span>
            </div>

            <!-- Catatan Admin -->
            <div class="rounded-xl p-3 text-xs space-y-1 ${valStatus === 'rejected' ? 'bg-red-50/60 border border-red-200/70' : valStatus === 'approved' ? 'bg-emerald-50/60 border border-emerald-200/70' : 'bg-stone-50 border border-stone-200/60'}">
              <div class="flex items-center gap-1 font-bold uppercase text-[10px] tracking-wider ${valStatus === 'rejected' ? 'text-red-600' : valStatus === 'approved' ? 'text-emerald-700' : 'text-stone-500'}">
                <span class="material-symbols-outlined text-xs ${valStatus === 'rejected' ? 'text-red-500' : valStatus === 'approved' ? 'text-emerald-600' : 'text-primary'}">notes</span> Catatan Admin
              </div>
              <p class="font-medium text-xs ${valStatus === 'rejected' ? 'text-red-800' : valStatus === 'approved' ? 'text-emerald-900' : (linkedDraft && linkedDraft.notes && linkedDraft.notes.trim() !== '' ? 'text-stone-800' : 'text-stone-400 italic')}">
                ${adminNotes}
              </p>
            </div>

            <div class="pt-2 border-t border-stone-100 flex items-center justify-between text-xs">
              ${isLinkedToDraft ? (
                valStatus === 'rejected' ? `
                  <span class="inline-flex items-center gap-1 text-[11px] font-bold text-red-700 bg-red-50 px-2.5 py-1 rounded-full border border-red-200">
                    <span class="material-symbols-outlined text-xs">cancel</span> Draf Ditolak
                  </span>
                ` : valStatus === 'approved' ? `
                  <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                    <span class="material-symbols-outlined text-xs">check_circle</span> Draf Disetujui
                  </span>
                ` : `
                  <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200">
                    <span class="material-symbols-outlined text-xs">hourglass_top</span> Pending Draf
                  </span>
                `
              ) : `
                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                  <span class="material-symbols-outlined text-xs">upload_file</span> Upload Draf
                </span>
              `}
              <span class="text-primary font-bold flex items-center gap-0.5 group-hover:translate-x-1 transition-transform text-xs">
                Pilih <span class="material-symbols-outlined text-sm">arrow_forward</span>
              </span>
            </div>
          </div>
        `;

        card.addEventListener("click", () => selectOrder(order.id, order.invoice));
        gridEl.appendChild(card);
      });

      gridEl.classList.remove("hidden");
    } catch (err: any) {
      console.error(err);
      loadingEl.innerHTML = `
        <span class="material-symbols-outlined text-4xl text-red-500">error</span>
        <p class="text-red-600 mt-2 font-medium">Failed to load publishing requirements. Please reload the page.</p>
      `;
    }
  }

  function selectOrder(orderId: string, invoice?: string) {
    // Deselect previously selected card
    if (selectedOrderId) {
      const prevCard = document.getElementById(`order-card-${selectedOrderId}`);
      if (prevCard) {
        prevCard.classList.remove("border-primary", "ring-2", "ring-primary/20", "bg-primary/5");
        prevCard.classList.add("border-stone-200/20");
      }
    }

    selectedOrderId = orderId;
    selectedOrderInput.value = orderId;

    const selectedCard = document.getElementById(`order-card-${orderId}`);
    if (selectedCard) {
      selectedCard.classList.remove("border-stone-200/20");
      selectedCard.classList.add("border-primary", "ring-2", "ring-primary/20", "bg-primary/5");
    }

    const selectedInvoiceInfo = document.getElementById("selected-invoice-info");
    const selectedInvoiceText = document.getElementById("selected-invoice-text");
    if (selectedInvoiceInfo && selectedInvoiceText && invoice) {
      selectedInvoiceInfo.classList.remove("hidden");
      selectedInvoiceText.textContent = invoice;
    }

    // Check if this order is linked to a draft book (Pending Draf / Ditolak / Disetujui)
    const linkedDraft = userDraftBooks.find((b: any) => b.order_id === orderId);
    const valStatus = (linkedDraft?.validation_status || "").toLowerCase();

    if (linkedDraft && valStatus === "rejected") {
      // Draf Ditolak Mode (Editable inputs & re-upload enabled)
      // 1. Fill form with values from database
      titleInput.value = linkedDraft.title || "";
      authorInput.value = linkedDraft.author || "";
      categorySelect.value = linkedDraft.category_id || "";
      formatSelect.value = linkedDraft.format || "Softcover";
      languageInput.value = linkedDraft.language || "Bahasa Indonesia";
      publisherInput.value = linkedDraft.publisher || "Digital Papyrus";
      descInput.value = linkedDraft.description || "";

      // 2. Enable form inputs for editing
      titleInput.disabled = false;
      authorInput.disabled = false;
      categorySelect.disabled = false;
      formatSelect.disabled = false;
      languageInput.disabled = false;
      publisherInput.disabled = true; // Publisher remains fixed
      descInput.disabled = false;

      // Remove disabled styling classes
      [titleInput, authorInput, categorySelect, formatSelect, languageInput, descInput].forEach(el => {
        el.classList.remove("cursor-not-allowed", "opacity-75");
      });

      // 3. Separate Existing Draft Banner
      existingDraftBox.classList.remove("hidden");
      if (linkedDraft.draft_url) {
        existingDraftLink.href = linkedDraft.draft_url;
        existingDraftLink.classList.remove("hidden");
        if (existingDraftTitle) existingDraftTitle.textContent = linkedDraft.title || "Draf Naskah Sebelumnya";
        if (existingDraftFilename) existingDraftFilename.textContent = linkedDraft.draft_url.split("/").pop() || "File naskah tersimpan di server.";
      } else {
        existingDraftLink.classList.add("hidden");
      }

      // 4. Draft file upload is dedicated for selecting new revision file
      draftUploadWrapper?.classList.remove("hidden");
      if (draftUploadLabel) draftUploadLabel.textContent = "Unggah File Naskah Baru (Opsional)";
      draftInput.disabled = false;
      draftInput.value = "";
      draftInput.removeAttribute("required");
      draftInput.classList.remove("pointer-events-none");
      uploadZone.className = "flex flex-col items-center justify-center border-2 border-dashed border-red-300 rounded-2xl p-6 bg-red-50/20 hover:bg-red-50/40 transition-all relative cursor-pointer";
      uploadIcon.className = "material-symbols-outlined text-4xl text-red-500 mb-2";
      uploadIcon.textContent = "upload_file";
      uploadTitle.textContent = "Pilih file naskah baru untuk revisi";
      uploadTitle.className = "text-sm font-bold text-red-700";
      uploadSubtitle.textContent = "Hanya format .doc atau .docx. Ukuran maksimal 10MB.";

      // 5. Show Submit Button
      submitBtn.classList.remove("hidden");
      if (submitContainer) submitContainer.classList.remove("hidden");
      btnText.textContent = "Upload Ulang Draft";
      btnIcon.textContent = "publish";

      // 6. Update header info
      if (selectedInvoiceStatusBadge) {
        selectedInvoiceStatusBadge.className = "text-xs font-bold text-red-700 bg-red-100 px-3 py-1 rounded-full border border-red-200";
        selectedInvoiceStatusBadge.textContent = "Draf Ditolak (Revisi Naskah)";
      }
      if (formStepTitle) {
        formStepTitle.textContent = "2. Revisi Naskah & Detail Buku";
      }
    } else if (linkedDraft) {
      // Pending or Approved Draft Mode (Read-Only)
      // 1. Fill form with values from database
      titleInput.value = linkedDraft.title || "";
      authorInput.value = linkedDraft.author || "";
      categorySelect.value = linkedDraft.category_id || "";
      formatSelect.value = linkedDraft.format || "Softcover";
      languageInput.value = linkedDraft.language || "";
      publisherInput.value = linkedDraft.publisher || "Digital Papyrus";
      descInput.value = linkedDraft.description || "";

      // 2. Disable all form inputs
      titleInput.disabled = true;
      authorInput.disabled = true;
      categorySelect.disabled = true;
      formatSelect.disabled = true;
      languageInput.disabled = true;
      publisherInput.disabled = true;
      descInput.disabled = true;

      // Add disabled styling classes
      [titleInput, authorInput, categorySelect, formatSelect, languageInput, publisherInput, descInput].forEach(el => {
        el.classList.add("cursor-not-allowed", "opacity-75");
      });

      // 3. Separate Existing Draft Banner
      existingDraftBox.classList.remove("hidden");
      if (linkedDraft.draft_url) {
        existingDraftLink.href = linkedDraft.draft_url;
        existingDraftLink.classList.remove("hidden");
        if (existingDraftTitle) existingDraftTitle.textContent = linkedDraft.title || "Draf Naskah";
        if (existingDraftFilename) existingDraftFilename.textContent = linkedDraft.draft_url.split("/").pop() || "File naskah tersimpan di server.";
      } else {
        existingDraftLink.classList.add("hidden");
      }

      // Hide upload zone in read-only mode
      draftUploadWrapper?.classList.add("hidden");
      draftInput.disabled = true;
      draftInput.removeAttribute("required");

      // 4. Hide Submit Button and Container
      submitBtn.classList.add("hidden");
      if (submitContainer) submitContainer.classList.add("hidden");

      // 5. Update header info
      if (selectedInvoiceStatusBadge) {
        if (valStatus === "approved") {
          selectedInvoiceStatusBadge.className = "text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full border border-emerald-200";
          selectedInvoiceStatusBadge.textContent = "Draf Disetujui";
        } else {
          selectedInvoiceStatusBadge.className = "text-xs font-bold text-amber-700 bg-amber-100 px-3 py-1 rounded-full border border-amber-200";
          selectedInvoiceStatusBadge.textContent = "Pending Draf (" + (linkedDraft.validation_status || "Pending").toUpperCase() + ")";
        }
      }
      if (formStepTitle) {
        formStepTitle.textContent = "2. Detail Draf Buku (Read-Only)";
      }
    } else {
      // New Draft Submission mode (Upload Draf)
      // 1. Hide existing draft banner
      existingDraftBox.classList.add("hidden");

      // 2. Reset / initialize fields
      titleInput.value = "";
      authorInput.value = userObj ? userObj.name : "";
      categorySelect.value = "";
      formatSelect.value = "Softcover";
      languageInput.value = "Bahasa Indonesia";
      publisherInput.value = "Digital Papyrus";
      descInput.value = "";

      // 3. Enable all form inputs
      titleInput.disabled = false;
      authorInput.disabled = false;
      categorySelect.disabled = false;
      formatSelect.disabled = false;
      languageInput.disabled = false;
      publisherInput.disabled = true; // Publisher remains fixed
      descInput.disabled = false;

      // Remove disabled styling classes
      [titleInput, authorInput, categorySelect, formatSelect, languageInput, descInput].forEach(el => {
        el.classList.remove("cursor-not-allowed", "opacity-75");
      });

      // 4. Enable Draft file upload
      draftUploadWrapper?.classList.remove("hidden");
      if (draftUploadLabel) draftUploadLabel.textContent = "Book Draft Manuscript *";
      draftInput.disabled = false;
      draftInput.value = "";
      draftInput.setAttribute("required", "true");
      draftInput.classList.remove("pointer-events-none");
      uploadZone.className = "flex flex-col items-center justify-center border-2 border-dashed border-outline-variant/40 rounded-2xl p-6 bg-surface-container-low/50 hover:bg-surface-container transition-all relative cursor-pointer";
      uploadIcon.className = "material-symbols-outlined text-4xl text-outline mb-2";
      uploadIcon.textContent = "cloud_upload";
      uploadTitle.textContent = "Choose file or drag here";
      uploadTitle.className = "text-sm font-bold text-primary";
      uploadSubtitle.textContent = "Only .doc or .docx formats allowed. Maximum size: 10MB.";

      // 5. Show Submit Button and Container
      submitBtn.classList.remove("hidden");
      if (submitContainer) submitContainer.classList.remove("hidden");
      btnText.textContent = "Submit Publish Request";
      btnIcon.textContent = "publish";

      // 6. Update header info
      if (selectedInvoiceStatusBadge) {
        selectedInvoiceStatusBadge.className = "text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full border border-emerald-200";
        selectedInvoiceStatusBadge.textContent = "Upload Draf";
      }
      if (formStepTitle) {
        formStepTitle.textContent = "2. Isi Detail Buku";
      }
    }

    // Reveal form
    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth" });
  }

  // Handle Manuscript File Input Visuals
  if (draftInput) {
    draftInput.addEventListener("change", () => {
      if (draftInput.files && draftInput.files.length > 0) {
        const file = draftInput.files[0];
        const fileSizeMB = file.size / (1024 * 1024);

        if (fileSizeMB > 10) {
          uploadZone.className = "flex flex-col items-center justify-center border-2 border-dashed border-red-500 rounded-2xl p-6 bg-red-50/20 relative";
          uploadIcon.className = "material-symbols-outlined text-4xl text-red-500 mb-2";
          uploadIcon.textContent = "error";
          uploadTitle.textContent = "File Too Large";
          uploadTitle.className = "text-sm font-bold text-red-600";
          uploadSubtitle.textContent = `Selected: ${file.name} (${fileSizeMB.toFixed(2)} MB). Max limit is 10MB.`;
          return;
        }

        const ext = file.name.substring(file.name.lastIndexOf(".")).toLowerCase();
        if (ext !== ".doc" && ext !== ".docx") {
          alert("File tidak didukung. Harap unggah file dengan format .doc atau .docx");
          uploadZone.className = "flex flex-col items-center justify-center border-2 border-dashed border-red-500 rounded-2xl p-6 bg-red-50/20 relative";
          uploadIcon.className = "material-symbols-outlined text-4xl text-red-500 mb-2";
          uploadIcon.textContent = "error";
          uploadTitle.textContent = "Invalid File Format";
          uploadTitle.className = "text-sm font-bold text-red-600";
          uploadSubtitle.textContent = `Selected: ${file.name}. Only .doc and .docx formats are allowed.`;
          return;
        }

        // Successful select
        uploadZone.className = "flex flex-col items-center justify-center border-2 border-dashed border-green-500 rounded-2xl p-6 bg-green-50/20 relative";
        uploadIcon.className = "material-symbols-outlined text-4xl text-green-500 mb-2";
        uploadIcon.textContent = "description";
        uploadTitle.textContent = "Manuscript Ready";
        uploadTitle.className = "text-sm font-bold text-green-600";
        uploadSubtitle.textContent = `${file.name} (${fileSizeMB.toFixed(2)} MB)`;
      } else {
        // Reset
        const orderId = selectedOrderInput.value;
        const linkedDraft = userDraftBooks.find((b: any) => b.order_id === orderId);
        const isRejected = linkedDraft && (linkedDraft.validation_status || "").toLowerCase() === "rejected";

        if (isRejected) {
          uploadZone.className = "flex flex-col items-center justify-center border-2 border-dashed border-red-300 rounded-2xl p-6 bg-red-50/20 hover:bg-red-50/40 transition-all relative cursor-pointer";
          uploadIcon.className = "material-symbols-outlined text-4xl text-red-500 mb-2";
          uploadIcon.textContent = "upload_file";
          uploadTitle.textContent = "Pilih file naskah baru untuk revisi";
          uploadTitle.className = "text-sm font-bold text-red-700";
          uploadSubtitle.textContent = "Hanya format .doc atau .docx. Ukuran maksimal 10MB.";
        } else {
          uploadZone.className = "flex flex-col items-center justify-center border-2 border-dashed border-outline-variant/40 rounded-2xl p-6 bg-surface-container-low/50 hover:bg-surface-container transition-all relative cursor-pointer";
          uploadIcon.className = "material-symbols-outlined text-4xl text-outline mb-2";
          uploadIcon.textContent = "cloud_upload";
          uploadTitle.textContent = "Choose file or drag here";
          uploadTitle.className = "text-sm font-bold text-primary";
          uploadSubtitle.textContent = "Only .doc or .docx formats allowed. Maximum size: 10MB.";
        }
      }
    });
  }

  // Handle Form Submission
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      statusBox.classList.add("hidden");

      const title = titleInput.value.trim();
      const author = authorInput.value.trim();
      const categoryId = categorySelect.value;
      const orderId = selectedOrderInput.value;

      if (!orderId) {
        showStatus("Please select a confirmed invoice first.", "error");
        return;
      }
      if (!title || !author || !categoryId) {
        showStatus("Title, Author, and Category are required fields.", "error");
        return;
      }

      const linkedDraft = userDraftBooks.find((b: any) => b.order_id === orderId);
      const isRejected = linkedDraft && (linkedDraft.validation_status || "").toLowerCase() === "rejected";

      // If brand new draft submission, draft file is strictly required
      if (!isRejected && (!draftInput.files || draftInput.files.length === 0)) {
        showStatus("Manuscript draft file is required.", "error");
        return;
      }

      let draftUrl = linkedDraft?.draft_url || "";

      // If user uploaded a new file, validate and upload it
      if (draftInput.files && draftInput.files.length > 0) {
        const file = draftInput.files[0];
        const fileSizeMB = file.size / (1024 * 1024);
        if (fileSizeMB > 10) {
          showStatus("Manuscript file size exceeds the 10MB limit.", "error");
          return;
        }
        const ext = file.name.substring(file.name.lastIndexOf(".")).toLowerCase();
        if (ext !== ".doc" && ext !== ".docx") {
          showStatus("Manuscript file must be in .doc or .docx format.", "error");
          return;
        }

        // Start upload loading state
        submitBtn.disabled = true;
        btnText.textContent = "Mengunggah naskah baru...";
        btnIcon.textContent = "hourglass_empty";
        btnIcon.classList.add("animate-spin");

        try {
          const uploadRes = await uploadDraft(file, orderId);
          draftUrl = uploadRes.url;
        } catch (uploadErr: any) {
          submitBtn.disabled = false;
          btnText.textContent = isRejected ? "Upload Ulang Draft" : "Submit Publish Request";
          btnIcon.textContent = "publish";
          btnIcon.classList.remove("animate-spin");
          showStatus(uploadErr.message || "Gagal mengunggah file naskah.", "error");
          return;
        }
      } else {
        submitBtn.disabled = true;
        btnText.textContent = "Memproses detail...";
        btnIcon.textContent = "hourglass_empty";
        btnIcon.classList.add("animate-spin");
      }

      try {
        if (isRejected && linkedDraft) {
          btnText.textContent = "Memperbarui draf...";
          await updateCustomerBook(linkedDraft.id, {
            title,
            author,
            category_id: categoryId,
            format: formatSelect.value,
            language: languageInput.value.trim(),
            description: descInput.value.trim(),
            draft_url: draftUrl
          });
        } else {
          btnText.textContent = "Menyimpan draf...";
          const payload = {
            title,
            author,
            category_id: categoryId,
            order_id: orderId,
            draft_url: draftUrl,
            description: descInput.value.trim(),
            publisher: "Digital Papyrus",
            format: formatSelect.value,
            language: languageInput.value.trim(),
            pages: 0,
            dimensions: "null",
            weight: "null"
          };

          await createCustomerBook(payload);
        }

        // Success
        successModal.classList.remove("hidden");
      } catch (err: any) {
        console.error(err);
        showStatus(err.message || "Gagal mengirim permintaan publikasi. Silakan coba lagi.", "error");
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = isRejected ? "Upload Ulang Draft" : "Submit Publish Request";
        btnIcon.textContent = "publish";
        btnIcon.classList.remove("animate-spin");
      }
    });
  }

  // Modal redirection
  if (closeModalBtn) {
    closeModalBtn.addEventListener("click", () => {
      window.location.reload();
    });
  }

  // Run
  init();
</script>
