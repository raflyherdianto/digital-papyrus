        detailModalExtraContent.innerHTML = `
          <h4 class="text-sm font-bold text-on-surface mb-3 font-headline mt-6">Spesifikasi</h4>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
            ${specsHtml}
          </div>
        `;
      } else {
        detailModalExtraContent.innerHTML = "";
      }
    } else {
      let features: string[] = [];
      if (item.features) {
        features = parseFeatures(item.features);
      }

      if (features.length > 0) {
        const featuresHtml = features.map(f => `
          <li class="flex items-start gap-2.5 text-sm text-on-surface-variant">
            <span class="material-symbols-outlined text-primary text-lg shrink-0 mt-0.5">check_circle</span>
            <span class="leading-relaxed">${f}</span>
          </li>
        `).join('');

        detailModalExtraContent.innerHTML = `
          <h4 class="text-sm font-bold text-on-surface mb-3 font-headline mt-6">Yang Anda Dapatkan</h4>
          <ul class="space-y-2.5">
            ${featuresHtml}
          </ul>
        `;
      } else {
        detailModalExtraContent.innerHTML = "";
      }
    }

    // 6. Show Modal
    itemDetailModal.classList.remove("hidden");
  }

  // Load everything
  async function initPage() {
    try {
      // 1. Fetch user data for pre-fill
      currentUser = await getCurrentUser();
      if (currentUser) {
        shipNameInput.value = currentUser.name || "";
        const phone = currentUser.phone_number || "";
        shipPhoneInput.value = phone;
        shipAddressInput.value = currentUser.address || "";
        
        let provName = currentUser.province || "-";
        let cityName = currentUser.city || "-";
        let regencyName = currentUser.regency || "-";
        let villageName = currentUser.village || "-";

        try {
          if (currentUser.province) {
            const provRes = await fetch("http://localhost:8080/api/v1/regions/provinces").then(r => r.json());
            const p = (provRes.data || []).find((x: any) => x.code === currentUser.province);
            if (p) provName = p.name;
          }
          if (currentUser.city) {
            const cityRes = await fetch(`http://localhost:8080/api/v1/regions/provinces/${currentUser.province}/regencies`).then(r => r.json());
            const c = (cityRes.data || []).find((x: any) => x.code === currentUser.city);
            if (c) cityName = c.name;
          }
          if (currentUser.regency) {
            const regRes = await fetch(`http://localhost:8080/api/v1/regions/regencies/${currentUser.city}/districts`).then(r => r.json());
            const r = (regRes.data || []).find((x: any) => x.code === currentUser.regency);
            if (r) regencyName = r.name;
          }
          if (currentUser.village) {
            const villRes = await fetch(`http://localhost:8080/api/v1/regions/districts/${currentUser.regency}/villages`).then(r => r.json());
            const v = (villRes.data || []).find((x: any) => x.code === currentUser.village);
            if (v) villageName = v.name;
          }
        } catch (e) {
          console.error("Failed to load region names", e);
        }

        shipProvinceEl.textContent = provName;
        shipCityEl.textContent = cityName;
        shipRegencyEl.textContent = regencyName;
        shipVillageEl.textContent = villageName;
        shipZipEl.textContent = currentUser.zip_code || "-";

        // Check if user profile is complete
        const isVerified = Boolean(
          currentUser.phone_number &&
          currentUser.address &&
          currentUser.province &&
          currentUser.city &&
          currentUser.regency &&
          currentUser.village &&
          currentUser.zip_code
        );

        if (!isVerified) {
          document.getElementById('unverified-alert')?.classList.remove('hidden');
          checkoutBtn.disabled = true;
          checkoutBtn.classList.add('opacity-50', 'cursor-not-allowed');
          checkoutBtn.classList.remove('hover:opacity-90');
        }
      }

      // 2. Load cart items
      const cartRaw = localStorage.getItem("dp_cart");
      if (cartRaw) {
        cartItems = JSON.parse(cartRaw);
      }

      // 3. Load catalog items
      await Promise.all([loadQuickBooks(), loadQuickServices()]);

      // 4. Load Settings
      try {
        const setRes = await settingsApi.get();
        if (setRes && setRes.data) {
          globalSettings = setRes.data;
        }
      } catch (err) {
        console.error("Failed to load settings:", err);
      }

      loadingEl.classList.add("hidden");
      await renderCart();
    } catch (err) {
      console.error("Failed to load page details:", err);
      loadingEl.classList.add("hidden");
      emptyEl.classList.remove("hidden");
    }
  }

  // Load and render quick add books catalog
  async function loadQuickBooks() {
    try {
      const { books } = await getBooks({ per_page: 6, status: "published" });
      loadedBooks = books;
      if (books.length === 0) {
        containerBooks.innerHTML = `<div class="col-span-full text-center py-4 text-xs text-stone-500">No books found.</div>`;
        return;
      }

      containerBooks.innerHTML = books.map(book => {
        const coverHtml = book.image_url 
          ? `<img src="${book.image_url}" alt="${book.title}" class="w-16 h-24 object-cover rounded-xl shadow-sm border border-stone-100 shrink-0" />`
          : `<div class="w-16 h-24 bg-stone-50 rounded-xl flex items-center justify-center text-stone-400 shrink-0 border border-stone-100"><span class="material-symbols-outlined text-2xl">auto_stories</span></div>`;

        return `
          <div class="group bg-white rounded-2xl p-4 border border-stone-100 shadow-sm flex flex-col gap-3 hover:shadow-md hover:border-primary/20 transition-all duration-300 cursor-pointer catalog-card" data-id="${book.id}" data-type="book">
            <div class="flex gap-4">
              ${coverHtml}
              <div class="flex-1 min-w-0">
                <h5 class="text-sm font-bold text-stone-900 truncate group-hover:text-primary transition-colors">${book.title}</h5>
                <p class="text-xs text-stone-500 truncate mt-0.5">${book.author}</p>
                <div class="text-sm font-extrabold text-primary mt-2">${formatRupiah(book.price)}</div>
              </div>
            </div>
            <button 
              class="add-to-cart-quick w-full py-2 bg-stone-50 hover:bg-primary text-primary hover:text-white font-bold rounded-xl text-xs transition-colors flex items-center justify-center gap-1 border border-stone-100 hover:border-primary"
              data-id="${book.id}"
              data-type="book"
              data-title="${book.title.replace(/"/g, '&quot;')}"
              data-author="${book.author.replace(/"/g, '&quot;')}"
              data-price="${book.price}"
              data-image="${book.image_url || ''}"
              data-weight="${book.weight ? parseFloat(book.weight) || 0.3 : 0.3}"
              data-format="${book.format || ''}"
            >
              <span class="material-symbols-outlined text-sm">add_shopping_cart</span> Add
            </button>
          </div>
        `;
      }).join('');

      attachQuickAddListeners();
    } catch {
      containerBooks.innerHTML = `<div class="col-span-full text-center py-4 text-xs text-red-500">Failed to load books.</div>`;
    }
  }

  // Load and render quick add services catalog
  async function loadQuickServices() {
    try {
      const services = await getServices(true);
      loadedServices = services;
      if (services.length === 0) {
        containerServices.innerHTML = `<div class="col-span-full text-center py-4 text-xs text-stone-500">No service packages found.</div>`;
        return;
      }

      containerServices.innerHTML = services.map(service => {
        return `
          <div class="group bg-white rounded-2xl p-4 border border-stone-100 shadow-sm flex flex-col gap-3 hover:shadow-md hover:border-primary/20 transition-all duration-300 cursor-pointer catalog-card" data-id="${service.id}" data-type="service">
            <div class="flex gap-4">
              <div class="w-16 h-16 bg-primary/5 rounded-xl flex items-center justify-center text-primary shrink-0 border border-primary/10">
                <span class="material-symbols-outlined text-3xl">${service.icon || 'design_services'}</span>
              </div>
              <div class="flex-1 min-w-0">
                <h5 class="text-sm font-bold text-stone-900 truncate group-hover:text-primary transition-colors">${service.title}</h5>
                <p class="text-xs text-stone-500 truncate mt-0.5">${service.price_label || 'Service Package'}</p>
                <div class="text-sm font-extrabold text-primary mt-2">${formatRupiah(service.price)}</div>
              </div>
            </div>
            <button 
              class="add-to-cart-quick w-full py-2 bg-stone-50 hover:bg-primary text-primary hover:text-white font-bold rounded-xl text-xs transition-colors flex items-center justify-center gap-1 border border-stone-100 hover:border-primary"
              data-id="${service.id}"
              data-type="service"
              data-title="${service.title.replace(/"/g, '&quot;')}"
              data-author="Digital Papyrus Services"
              data-price="${service.price}"
              data-image=""
              data-weight="0"
            >
              <span class="material-symbols-outlined text-sm">add_shopping_cart</span> Add
            </button>
          </div>
        `;
      }).join('');

      attachQuickAddListeners();
    } catch {
      containerServices.innerHTML = `<div class="col-span-full text-center py-4 text-xs text-red-500">Failed to load service packages.</div>`;
    }
  }

  function attachQuickAddListeners() {
    document.querySelectorAll(".catalog-card").forEach(card => {
      // Prevent duplicates by cloning and replacing the card
      const newCard = card.cloneNode(true) as HTMLDivElement;
      card.parentNode?.replaceChild(newCard, card);

      // 1. Add click listener to the card (to open detail modal)
      newCard.addEventListener("click", () => {
        const id = newCard.getAttribute("data-id")!;
        const type = newCard.getAttribute("data-type")!;
        showItemDetail(id, type);
      });

      // 2. Add click listener to the Add button inside the card
      const addBtn = newCard.querySelector(".add-to-cart-quick") as HTMLButtonElement;
      if (addBtn) {
        addBtn.addEventListener("click", (e) => {
          e.stopPropagation(); // Stop card click from firing
          
          const id = addBtn.getAttribute("data-id")!;
          const type = addBtn.getAttribute("data-type")!;
          const title = addBtn.getAttribute("data-title")!;
          const author = addBtn.getAttribute("data-author")!;
          const price = parseInt(addBtn.getAttribute("data-price")!);
          const image_url = addBtn.getAttribute("data-image")!;
          const weight = parseFloat(addBtn.getAttribute("data-weight")!);
          const format = addBtn.getAttribute("data-format") || "";

          const existing = cartItems.find(item => item.id === id && item.type === type);
          if (existing) {
            existing.qty += 1;
          } else {
            cartItems.push({ id, type, title, author, price, image_url, qty: 1, weight, format });
          }

          localStorage.setItem("dp_cart", JSON.stringify(cartItems));
          renderCart();
        });
      }
    });
  }

  async function renderCart() {
    if (cartItems.length === 0) {
      listEl.classList.add("hidden");
      emptyEl.classList.remove("hidden");
      countBadge.textContent = "0 Items";
      totalQtyEl.textContent = "0";
      document.getElementById("summary-items-total")!.textContent = "Rp 0";
      subtotalEl.textContent = "Rp 0";
      
      // Reset shipping and layout variables
      shippingCost = 0;
      cachedWeight = -1;
      cachedDest = "";
      courierRates = { "JNE": 0, "J&T": 0 };
      
      document.getElementById("courier-select-container")?.classList.add("hidden");
      document.getElementById("summary-shipping-row")?.classList.add("hidden");
      document.getElementById("summary-tax-row")?.classList.add("hidden");
      document.getElementById("summary-service-fee-row")?.classList.add("hidden");
      document.getElementById("summary-discount-row")?.classList.add("hidden");
      
      return;
    }

    emptyEl.classList.add("hidden");
    listEl.classList.remove("hidden");
    listEl.innerHTML = "";

    let totalQty = 0;
    let itemsTotal = 0;
    let totalPhysicalWeight = 0;

    cartItems.forEach((item, index) => {
      totalQty += item.qty;
      const itemTotal = item.price * item.qty;
      itemsTotal += itemTotal;
      const fmt = (item.format || '').toLowerCase().trim();
      const titleLower = (item.title || '').toLowerCase();
      const isEbook = fmt === 'e-book' || fmt === 'ebook' || titleLower.includes('e-book') || titleLower.includes('ebook');

      // Only physical books (not e-books) incur shipping weight
      if (item.type === 'book' && !isEbook) {
        const w = item.weight || 0.3;
        totalPhysicalWeight += w * item.qty;
      }

      const card = document.createElement("div");
      card.className = "flex flex-col sm:flex-row gap-5 p-5 bg-white rounded-2xl border border-stone-100 shadow-sm hover:shadow-md transition-shadow relative group";

      let typeBadge = '';
      if (item.type === 'service') {
        typeBadge = `<span class="inline-block px-2.5 py-1 bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-wider rounded-md mb-2">Service</span>`;
      } else if (isEbook) {
        typeBadge = `<span class="inline-block px-2.5 py-1 bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase tracking-wider rounded-md mb-2">E-Book (Gratis Ongkir)</span>`;
      } else {
        typeBadge = `<span class="inline-block px-2.5 py-1 bg-stone-100 text-stone-600 text-[10px] font-bold uppercase tracking-wider rounded-md mb-2">Book</span>`;
      }

      const imageHtml = item.image_url 
        ? `<img src="${item.image_url}" alt="${item.title}" class="w-20 h-28 object-cover rounded-xl shadow-sm border border-stone-100 shrink-0" />`
        : `<div class="w-20 h-28 rounded-xl bg-stone-50 flex items-center justify-center text-stone-400 shrink-0 border border-stone-100"><span class="material-symbols-outlined text-3xl">design_services</span></div>`;

      card.innerHTML = `
        <div class="flex-shrink-0 flex justify-center sm:block">
          ${imageHtml}
        </div>
        <div class="flex-1 flex flex-col justify-between min-w-0">
          <div class="flex justify-between items-start gap-4">
            <div>
              ${typeBadge}
              <h4 class="text-base font-bold text-stone-900 leading-tight mb-1 pr-8">${item.title}</h4>
              <p class="text-sm text-stone-500">${item.author || ""}</p>
            </div>
            <button class="remove-btn absolute top-4 right-4 sm:static text-stone-400 hover:text-red-500 transition-colors p-1.5 rounded-lg hover:bg-red-50" data-index="${index}" aria-label="Remove item">
              <span class="material-symbols-outlined text-xl">delete_outline</span>
            </button>
          </div>
          
          <div class="flex flex-wrap items-end justify-between gap-4 mt-4 pt-4 border-t border-stone-50">
            <div>
              <span class="text-xs text-stone-500 block mb-1">Price</span>
              <span class="font-bold text-stone-900">${formatRupiah(item.price)}</span>
            </div>
            
            <div class="flex items-center gap-3 bg-stone-50 p-1.5 rounded-xl border border-stone-200">
              <button class="qty-btn w-8 h-8 rounded-lg bg-white shadow-sm hover:bg-stone-100 text-stone-700 font-bold flex items-center justify-center transition-colors" data-action="dec" data-index="${index}">
                <span class="material-symbols-outlined text-sm">remove</span>
              </button>
              <span class="w-6 text-center text-sm font-bold text-stone-900">${item.qty}</span>
              <button class="qty-btn w-8 h-8 rounded-lg bg-white shadow-sm hover:bg-stone-100 text-stone-700 font-bold flex items-center justify-center transition-colors" data-action="inc" data-index="${index}">
                <span class="material-symbols-outlined text-sm">add</span>
              </button>
            </div>
            
            <div class="text-right">
              <span class="text-xs text-stone-500 block mb-1">Total</span>
              <span class="font-extrabold text-primary text-lg">${formatRupiah(itemTotal)}</span>
            </div>
          </div>
        </div>
      `;

      listEl.appendChild(card);
    });

    countBadge.textContent = `${totalQty} Item${totalQty !== 1 ? 's' : ''}`;
    totalQtyEl.textContent = String(totalQty);
    document.getElementById("summary-items-total")!.textContent = formatRupiah(itemsTotal);

    // Calculate Shipping Cost
    const courierContainer = document.getElementById("courier-select-container");
    if (totalPhysicalWeight > 0 && currentUser && currentUser.village) {
      if (courierContainer) courierContainer.classList.remove("hidden");
      const destCode = currentUser.village; // village is code in db
      const weightKg = totalPhysicalWeight;

      if (weightKg !== cachedWeight || destCode !== cachedDest) {
        try {
          const shRes = await shippingApi.calculateCost(destCode, weightKg);
          if (shRes && shRes.data) {
            courierRates["JNE"] = 0;
            courierRates["J&T"] = 0;
            const couriers = shRes.data.couriers || [];
            couriers.forEach((c: any) => {
              const cName = String(c.courier).toUpperCase();
              let key = "";
              if (cName.includes("JNE")) key = "JNE";
              else if (cName.includes("J&T") || cName.includes("J AND T")) key = "J&T";

              if (key && c.services && c.services.length > 0) {
                courierRates[key] = Number(c.services[0].price) || 0;
              }
            });
            cachedWeight = weightKg;
            cachedDest = destCode;
          }
        } catch (err) {
          console.error("Failed to calculate shipping cost:", err);
        }
      }
      const selectedCourier = (document.getElementById("shipping-courier") as HTMLSelectElement)?.value || "JNE";
      shippingCost = courierRates[selectedCourier] || 0;
    } else {
      if (courierContainer) courierContainer.classList.add("hidden");
      shippingCost = 0;
      cachedWeight = -1;
      cachedDest = "";
    }

    // Apply Settings
    let taxAmount = 0;
    let serviceFee = 0;
    let discount = 0;

    if (globalSettings) {
      serviceFee = Number(globalSettings.service_fee) || 0;
      discount = Number(globalSettings.discount) || 0;
      const taxPercent = Number(globalSettings.tax) || 0;
      taxAmount = Math.floor((itemsTotal + shippingCost + serviceFee - discount) * (taxPercent / 100));
      if (taxAmount < 0) taxAmount = 0;
    }

    const subtotal = itemsTotal + shippingCost + serviceFee + taxAmount - discount;
    
    // Update Summary UI
    const shippingRow = document.getElementById("summary-shipping-row")!;
    if (shippingCost > 0) {
      shippingRow.classList.remove("hidden");
      shippingRow.classList.add("flex");
      document.getElementById("summary-shipping-cost")!.textContent = formatRupiah(shippingCost);
    } else {
      shippingRow.classList.add("hidden");
      shippingRow.classList.remove("flex");
    }

    const taxRow = document.getElementById("summary-tax-row")!;
    if (taxAmount > 0) {
      taxRow.classList.remove("hidden");
      taxRow.classList.add("flex");
      document.getElementById("summary-tax-label")!.textContent = `Tax (${globalSettings?.tax || 0}%)`;
      document.getElementById("summary-tax-amount")!.textContent = formatRupiah(taxAmount);
    } else {
      taxRow.classList.add("hidden");
      taxRow.classList.remove("flex");
    }

    const serviceFeeRow = document.getElementById("summary-service-fee-row")!;
    if (serviceFee > 0) {
      serviceFeeRow.classList.remove("hidden");
      serviceFeeRow.classList.add("flex");
      document.getElementById("summary-service-fee")!.textContent = formatRupiah(serviceFee);
    } else {
      serviceFeeRow.classList.add("hidden");
      serviceFeeRow.classList.remove("flex");
    }

    const discountRow = document.getElementById("summary-discount-row")!;
    if (discount > 0) {
      discountRow.classList.remove("hidden");
      discountRow.classList.add("flex");
      document.getElementById("summary-discount")!.textContent = "-" + formatRupiah(discount);
    } else {
      discountRow.classList.add("hidden");
      discountRow.classList.remove("flex");
    }

    subtotalEl.textContent = formatRupiah(subtotal);

    // Attach listeners for cart actions
    document.querySelectorAll("#cart-items-list .qty-btn").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const index = parseInt(target.getAttribute("data-index")!);
        const action = target.getAttribute("data-action")!;
        
        if (action === "dec") {
          if (cartItems[index].qty > 1) {
            cartItems[index].qty -= 1;
          } else {
            showDeleteModal(index);
            return;
          }
        } else if (action === "inc") {
          cartItems[index].qty += 1;
        }

        localStorage.setItem("dp_cart", JSON.stringify(cartItems));
        renderCart();
      });
    });

    document.querySelectorAll("#cart-items-list .remove-btn").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const index = parseInt(target.getAttribute("data-index")!);
        showDeleteModal(index);
      });
    });
  }

  // Tabs toggle logic
  if (tabBooks && tabServices) {
    tabBooks.addEventListener("click", () => {
      tabBooks.className = "pb-2 border-b-2 border-primary text-primary font-bold text-sm transition-all focus:outline-none";
      tabServices.className = "pb-2 border-b-2 border-transparent text-stone-500 hover:text-stone-900 font-semibold text-sm transition-all focus:outline-none";
      containerBooks.classList.remove("hidden");
      containerServices.classList.add("hidden");
    });

    tabServices.addEventListener("click", () => {
      tabServices.className = "pb-2 border-b-2 border-primary text-primary font-bold text-sm transition-all focus:outline-none";
      tabBooks.className = "pb-2 border-b-2 border-transparent text-stone-500 hover:text-stone-900 font-semibold text-sm transition-all focus:outline-none";
      containerServices.classList.remove("hidden");
      containerBooks.classList.add("hidden");
    });
  }

  // Handle Checkout submission
  if (checkoutForm) {
    checkoutForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (cartItems.length === 0) {
        showCartError("Keranjang Kosong", "Keranjang belanja Anda masih kosong. Silahkan tambahkan produk terlebih dahulu.");
        return;
      }

      if (!currentUser.address || !currentUser.province || !currentUser.city) {
        showCartError("Profil Belum Lengkap", "Harap lengkapi alamat lengkap pengiriman pada halaman Profile Settings sebelum checkout!");
        closeCartErrorBtn.onclick = () => {
          cartErrorModal.classList.add("hidden");
          window.location.href = "/customer-profile";
        };
        return;
      }

      checkoutBtn.disabled = true;
      checkoutBtn.textContent = "Processing Checkout...";

      try {
        let totalQty = 0;
        let itemsTotal = 0;
        let totalPhysicalWeight = 0;

        const itemsPayload = cartItems.map(item => {
          totalQty += item.qty;
          itemsTotal += item.price * item.qty;
          const fmt = (item.format || '').toLowerCase().trim();
          const titleLower = (item.title || '').toLowerCase();
          const isEbook = fmt === 'e-book' || fmt === 'ebook' || titleLower.includes('e-book') || titleLower.includes('ebook');
          if (item.type === 'book' && !isEbook) {
            const weight = item.weight || 0.3;
            totalPhysicalWeight += weight * item.qty;
          }
          return {
            id: item.id,
            type: item.type,
            title: item.title,
            qty: item.qty,
            price: item.price,
            format: item.format || ''
          };
        });

        if (totalPhysicalWeight <= 0) {
          shippingCost = 0;
        }

        // Use global calculations
        let serviceFee = 0;
        let discount = 0;
        let taxPercent = 0;

        if (globalSettings) {
          serviceFee = Number(globalSettings.service_fee) || 0;
          discount = Number(globalSettings.discount) || 0;
          taxPercent = Number(globalSettings.tax) || 0;
        }

        let taxAmount = Math.floor((itemsTotal + shippingCost + serviceFee - discount) * (taxPercent / 100));
        if (taxAmount < 0) taxAmount = 0;
        
        let totalPrice = itemsTotal + shippingCost + serviceFee + taxAmount - discount;

        const now = new Date();
        const d = String(now.getDate()).padStart(2, '0');
        const m = String(now.getMonth() + 1).padStart(2, '0');
        const y = String(now.getFullYear());
        const seq = Date.now().toString().slice(-4);
        const uniqueChars = Math.random().toString(36).substring(2, 6).toUpperCase();
        
        const invoice = `INV-${d}${m}${y}-${seq}-${uniqueChars}`;

        const uniqueCode = 100 + Math.floor(Math.random() * 100); // 100 to 199
        totalPrice += uniqueCode;

        const payload = {
          invoice: invoice,
          user_id: currentUser.id,
          items: JSON.stringify(itemsPayload),
          notes: checkoutNotesInput.value.trim(),
          total_qty: totalQty,
          total_weight: Math.ceil(totalPhysicalWeight * 1000), // in grams for db
          total_price: totalPrice,
          payment_type: "Bank Transfer",
          status: "pending",
          shipping_name: shippingCost > 0 ? ((document.getElementById("shipping-courier") as HTMLSelectElement)?.value || "JNE") : "-",
          shipping_service: shippingCost > 0 ? "REG" : "-",
          shipping_price: shippingCost,
          tax: taxAmount,
          service_fee: serviceFee,
          discount: discount
        };

        const createdOrder = await createOrder(payload);
        currentOrderId = createdOrder.id;
        localStorage.removeItem("dp_cart");

        // DISABLED DYNAMIC QRIS GENERATION (Syntax preserved as requested)
        /*
        const dynamicQRISStr = generateDynamicQRIS(STATIC_QRIS, totalPrice);
        try {
          const qrDataUrl = await QRCode.toDataURL(dynamicQRISStr, {
            errorCorrectionLevel: 'M',
            margin: 2,
            width: 300,
            color: {
              dark: '#000000',
              light: '#ffffff'
            }
          });
          if (qrisImage) qrisImage.src = qrDataUrl;
        } catch (e) {
          console.error("Failed to generate QR Code", e);
        }
        */

        // Populate Bank Information
        const bName = globalSettings?.bank_name || "Bank BCA";
        const bNum = globalSettings?.bank_account_number || "8735091234";
        const bHolder = globalSettings?.bank_account_holder || "PT Digital Papyrus Indonesia";

        const pBankName = document.getElementById("paymentBankName");
        if (pBankName) pBankName.textContent = bName;

        const pBankNum = document.getElementById("paymentBankAccountNumber");
        if (pBankNum) pBankNum.textContent = bNum;

        const pBankHolder = document.getElementById("paymentBankAccountHolder");
        if (pBankHolder) pBankHolder.textContent = bHolder;

        // Show Modal
        qrisInvoiceNumber.textContent = invoice;
        qrisTotalAmount.textContent = formatRupiah(totalPrice);
        qrisPaymentModal.classList.remove("hidden");
        startQrisTimer();
        
      } catch (err: any) {
        alert(err.message || "Gagal melakukan checkout.");
        checkoutBtn.disabled = false;
        checkoutBtn.textContent = "Place Order";
      }
    });
  }

  // Copy Account Number Event
  document.getElementById("copyAccountBtn")?.addEventListener("click", () => {
    const accNum = document.getElementById("paymentBankAccountNumber")?.textContent || "";
    if (accNum) {
      navigator.clipboard.writeText(accNum);
      alert("Nomor rekening (" + accNum + ") berhasil disalin!");
    }
  });

  // WhatsApp Verification Event
  document.getElementById("whatsappVerifyBtn")?.addEventListener("click", () => {
    const rawPhone = globalSettings?.origin_phone || "+6281234567890";
    let cleanPhone = rawPhone.replace(/\D/g, "");
    if (cleanPhone.startsWith("0")) cleanPhone = "62" + cleanPhone.substring(1);
    if (!cleanPhone.startsWith("62")) cleanPhone = "62" + cleanPhone;

    const currentInv = qrisInvoiceNumber.textContent || "";
    const currentAmt = qrisTotalAmount.textContent || "";
    const bName = globalSettings?.bank_name || "Bank BCA";

    const message = `Halo Admin Digital Papyrus, saya telah melakukan transfer pembayaran untuk pesanan:

- Nomor Invoice: ${currentInv}
- Total Pembayaran: ${currentAmt}
- Bank Tujuan: ${bName}

Berikut saya lampirkan bukti transaksi/transfer pembayarannya untuk diverifikasi. Terima kasih!`;

    const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;
    window.open(waUrl, "_blank");
    window.location.href = "/customer-dashboard#transactions";
  });

  function startQrisTimer() {
    let timeLeft = 24 * 3600; // 24 hours (86400 seconds)
    clearInterval(qrisInterval);
    
    qrisInterval = setInterval(async () => {
      timeLeft--;
      const h = Math.floor(timeLeft / 3600);
      const m = Math.floor((timeLeft % 3600) / 60);
      const s = timeLeft % 60;
      qrisTimer.textContent = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
      
      if (timeLeft <= 0) {
        clearInterval(qrisInterval);
        qrisTimer.textContent = "00:00:00";
        qrisTimer.classList.add("text-red-500");
        if (confirmPaymentBtn) confirmPaymentBtn.disabled = true;
        paymentStatusMsg.textContent = "Batas waktu transfer 24 jam telah habis. Pesanan dibatalkan otomatis.";
        paymentStatusMsg.className = "text-center text-sm font-bold text-red-500 mb-4 block";
        
        if (currentOrderId) {
          try {
            await cancelCustomerOrder(currentOrderId);
          } catch (e) {
            console.error("Gagal membatalkan pesanan:", e);
          }
        }
      }
    }, 1000);
  }

  closeQrisBtn.addEventListener("click", () => {
    qrisPaymentModal.classList.add("hidden");
    clearInterval(qrisInterval);
    window.location.href = "/customer-transactions";
  });

  if (confirmPaymentBtn) {
    confirmPaymentBtn.addEventListener("click", async () => {
      if (!currentOrderId) return;
      const originalText = confirmPaymentBtn.innerHTML;
      confirmPaymentBtn.innerHTML = `<span class="material-symbols-outlined animate-spin text-[18px]">sync</span> Memproses...`;
      confirmPaymentBtn.disabled = true;
      paymentStatusMsg.classList.add("hidden");

      try {
        await confirmCustomerOrderPayment(currentOrderId);
        clearInterval(qrisInterval);
        paymentStatusMsg.textContent = "Konfirmasi pembayaran berhasil dikirim! Menunggu verifikasi admin.";
        paymentStatusMsg.className = "text-center text-xs md:text-sm font-bold text-indigo-700 block mt-3 bg-indigo-50 py-2.5 px-3 rounded-xl border border-indigo-200";
        confirmPaymentBtn.classList.add("hidden");
        setTimeout(() => {
          window.location.href = "/customer-transactions";
        }, 1500);
      } catch (err: any) {
        paymentStatusMsg.textContent = "Gagal konfirmasi pembayaran: " + (err.message || "Terjadi kesalahan");
        paymentStatusMsg.className = "text-center text-xs md:text-sm font-bold text-red-500 block mt-3 bg-red-50 py-2 px-3 rounded-xl border border-red-200";
        confirmPaymentBtn.innerHTML = originalText;
        confirmPaymentBtn.disabled = false;
      }
    });
  }

  if (viewDashboardBtn) {
    viewDashboardBtn.addEventListener("click", () => {
      qrisPaymentModal.classList.add("hidden");
      clearInterval(qrisInterval);
      window.location.href = "/customer-transactions";
    });
  }

  const courierSelect = document.getElementById("shipping-courier") as HTMLSelectElement;
  if (courierSelect) {
    courierSelect.addEventListener("change", () => {
      renderCart();
    });
  }

  initPage();
</script>
