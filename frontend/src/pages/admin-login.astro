---
/**
 * Admin Login Page
 * Route: /admin-login
 */
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Admin Login | Digital Papyrus">
  <div class="w-full max-w-md bg-surface-container-lowest rounded-2xl shadow-xl p-8 md:p-10 border border-outline-variant/10">
    <div class="text-center mb-8 md:mb-10">
      <h2 class="font-headline text-2xl md:text-3xl font-bold tracking-tight text-primary">Admin Login</h2>
      <p class="text-on-surface-variant text-sm md:text-base mt-2">Access the publishing management console.</p>
    </div>

    <!-- Error Alert -->
    <div id="login-error" class="hidden mb-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-3">
      <span class="material-symbols-outlined text-lg">error</span>
      <span id="login-error-msg">Invalid email or password</span>
    </div>

    <form class="space-y-5 md:space-y-6" id="login-form" novalidate>
      <div>
        <label class="block text-sm font-medium text-primary mb-2" for="email-input">Email</label>
        <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
          <span class="material-symbols-outlined text-outline text-lg mr-3">mail</span>
          <input
            id="email-input"
            type="email"
            placeholder="Enter your email"
            autocomplete="email"
            required
            class="bg-transparent w-full text-sm focus:outline-none text-on-surface placeholder:text-outline-variant"
          />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-primary mb-2" for="password-input">Password</label>
        <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
          <span class="material-symbols-outlined text-outline text-lg mr-3">lock</span>
          <input
            id="password-input"
            type="password"
            placeholder="Enter your password"
            autocomplete="current-password"
            required
            class="bg-transparent w-full text-sm focus:outline-none text-on-surface placeholder:text-outline-variant"
          />
          <button type="button" id="togglePassword" class="text-outline hover:text-primary transition-colors" aria-label="Toggle password visibility">
            <span class="material-symbols-outlined text-lg">visibility_off</span>
          </button>
        </div>
      </div>
      <div class="flex items-center justify-between text-sm pt-1">
        <label class="flex items-center gap-2 cursor-pointer text-on-surface-variant">
          <input type="checkbox" class="accent-primary w-4 h-4 rounded" />
          <span>Remember me</span>
        </label>
        <a href="#" class="text-primary font-semibold hover:underline">Forgot Password?</a>
      </div>
      
      <!-- Puzzle CAPTCHA Section -->
      <div id="captcha-container" class="space-y-4 py-2 mt-2">
        <div class="text-center">
          <p class="text-[10px] uppercase tracking-[0.2em] text-outline-variant font-bold mb-3">Security Verification</p>
        </div>
        
        <div class="relative w-full aspect-[16/9] bg-surface-container rounded-xl overflow-hidden shadow-inner border border-outline-variant/20" id="puzzle-box">
          <canvas id="puzzle-main" class="w-full h-full object-cover"></canvas>
          <canvas id="puzzle-piece" class="absolute top-0 left-0 w-full h-full pointer-events-none"></canvas>
          
          <!-- Success Overlay -->
          <div id="puzzle-success" class="absolute inset-0 bg-green-500/20 backdrop-blur-[2px] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
            <div class="bg-white rounded-full p-2 shadow-lg">
              <span class="material-symbols-outlined text-green-600 text-3xl">check_circle</span>
            </div>
          </div>
        </div>

        <div class="relative w-full h-12 bg-surface-container rounded-full border border-outline-variant/30 flex items-center p-1 group">
          <div id="slider-track" class="absolute left-0 top-0 h-full bg-primary/10 rounded-full w-0"></div>
          <input 
            type="range" 
            id="puzzle-slider" 
            min="0" 
            max="100" 
            value="0" 
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
          />
          <div id="slider-thumb" class="relative z-10 w-10 h-10 bg-primary text-on-primary rounded-full shadow-lg flex items-center justify-center transition-transform group-hover:scale-105 active:scale-95">
            <span class="material-symbols-outlined text-base">chevron_right</span>
          </div>
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <span class="text-[10px] font-bold uppercase tracking-widest text-outline-variant animate-pulse" id="slider-text">Slide to complete puzzle</span>
          </div>
        </div>
      </div>
      <button
        type="submit"
        id="login-submit-btn"
        disabled
        class="w-full py-3 md:py-4 mt-2 bg-primary text-on-primary font-bold rounded-xl shadow-md hover:bg-primary/90 flex items-center justify-center gap-2 transition-all text-sm md:text-base disabled:opacity-40 disabled:grayscale disabled:cursor-not-allowed"
      >
        <span class="material-symbols-outlined text-sm" id="login-icon">login</span>
        <span id="login-btn-text">Sign in</span>
      </button>
    </form>
  </div>
</AuthLayout>

<script>
  import { login, setToken, isAuthenticated, removeToken } from '../lib/api';

  // Redirect if already logged in as superadmin
  if (isAuthenticated()) {
    const userData = localStorage.getItem('dp_user');
    let isSuperAdmin = false;
    if (userData) {
      try {
        const user = JSON.parse(userData);
        if (user.role === 'superadmin') {
          isSuperAdmin = true;
        }
      } catch (e) {}
    }
    
    if (isSuperAdmin) {
      window.location.href = '/admin-dashboard';
    } else {
      removeToken();
      localStorage.removeItem('dp_user');
    }
  }

  // Toggle password visibility
  const toggleBtn = document.getElementById('togglePassword');
  const pwInput = document.getElementById('password-input') as HTMLInputElement;
  if (toggleBtn && pwInput) {
    toggleBtn.addEventListener('click', () => {
      const isPassword = pwInput.getAttribute('type') === 'password';
      pwInput.setAttribute('type', isPassword ? 'text' : 'password');
      const icon = toggleBtn.querySelector('span');
      if (icon) icon.textContent = isPassword ? 'visibility' : 'visibility_off';
    });
  }

  // Puzzle CAPTCHA Logic
  const puzzleBox = document.getElementById('puzzle-box');
  const mainCanvas = document.getElementById('puzzle-main') as HTMLCanvasElement;
  const pieceCanvas = document.getElementById('puzzle-piece') as HTMLCanvasElement;
  const slider = document.getElementById('puzzle-slider') as HTMLInputElement;
  const thumb = document.getElementById('slider-thumb');
  const track = document.getElementById('slider-track');
  const successOverlay = document.getElementById('puzzle-success');
  const sliderText = document.getElementById('slider-text');

  let puzzleX = 0;
  let puzzleY = 0;
  let isSolved = false;

  async function initPuzzle() {
    if (!mainCanvas || !pieceCanvas) return;
    
    // Ensure dimensions are ready
    if (mainCanvas.clientWidth === 0) {
      requestAnimationFrame(initPuzzle);
      return;
    }

    const ctx = mainCanvas.getContext('2d')!;
    const pCtx = pieceCanvas.getContext('2d')!;
    
    const img = new Image();
    img.crossOrigin = "anonymous";
    // Tech/Management themed image for Admin
    img.src = "https://images.unsplash.com/photo-1633356122544-f134324a6cee?auto=format&fit=crop&w=600&q=80";
    
    img.onerror = () => {
      img.src = "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=600&q=80";
    };

    img.onload = () => {
      const w = mainCanvas.clientWidth;
      const h = mainCanvas.clientHeight;
      mainCanvas.width = w;
      mainCanvas.height = h;
      pieceCanvas.width = w;
      pieceCanvas.height = h;

      ctx.drawImage(img, 0, 0, w, h);

      puzzleX = Math.floor(Math.random() * (w / 2 - 80)) + w / 2;
      puzzleY = Math.floor(Math.random() * (h - 70)) + 20;

      const size = 45;
      const drawPiece = (c: CanvasRenderingContext2D, x: number, y: number) => {
        c.beginPath();
        c.moveTo(x, y);
        c.lineTo(x + size / 2 - 5, y);
        c.arc(x + size / 2, y, 8, Math.PI, 0);
        c.lineTo(x + size, y);
        c.lineTo(x + size, y + size / 2 - 5);
        c.arc(x + size, y + size / 2, 8, 1.5 * Math.PI, 0.5 * Math.PI);
        c.lineTo(x + size, y + size);
        c.lineTo(x, y + size);
        c.closePath();
      };

      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      drawPiece(ctx, puzzleX, puzzleY);
      ctx.fill();
      ctx.strokeStyle = 'rgba(255,255,255,0.6)';
      ctx.stroke();

      pCtx.save();
      drawPiece(pCtx, 0, puzzleY);
      pCtx.clip();
      pCtx.drawImage(img, -puzzleX, 0, w, h);
      pCtx.restore();
      
      pCtx.strokeStyle = 'rgba(255,255,255,0.9)';
      pCtx.lineWidth = 2;
      drawPiece(pCtx, 0, puzzleY);
      pCtx.stroke();
    };
  }

  if (slider && thumb && track) {
    slider.addEventListener('input', (e) => {
      if (isSolved) return;
      const val = parseInt((e.target as HTMLInputElement).value);
      const moveX = (val / 100) * (mainCanvas.clientWidth - 50);
      
      pieceCanvas.style.transform = `translateX(${moveX}px)`;
      thumb.style.transform = `translateX(${moveX}px)`;
      track.style.width = `${moveX + 20}px`;
    });

    slider.addEventListener('change', (e) => {
      if (isSolved) return;
      const val = parseInt((e.target as HTMLInputElement).value);
      const moveX = (val / 100) * (mainCanvas.clientWidth - 50);
      
      const diff = Math.abs(moveX - puzzleX);
      if (diff < 6) {
        isSolved = true;
        successOverlay?.classList.remove('opacity-0');
        successOverlay?.classList.add('opacity-100');
        sliderText!.textContent = "Verification Success";
        sliderText!.classList.remove('animate-pulse');
        sliderText!.classList.add('text-green-600');
        slider.disabled = true;
        submitBtn.disabled = false;
      } else {
        slider.value = "0";
        pieceCanvas.style.transform = 'translateX(0)';
        thumb.style.transform = 'translateX(0)';
        track.style.width = '0';
      }
    });
  }

  initPuzzle();

  // Login form handler
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorBox = document.getElementById('login-error')!;
  const errorMsg = document.getElementById('login-error-msg')!;
  const submitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement;
  const btnIcon = document.getElementById('login-icon')!;
  const btnText = document.getElementById('login-btn-text')!;

  function showError(msg: string) {
    errorMsg.textContent = msg;
    errorBox.classList.remove('hidden');
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Signing in...' : 'Sign in';
    btnIcon.textContent = loading ? 'hourglass_empty' : 'login';
    if (loading) btnIcon.classList.add('animate-spin');
    else btnIcon.classList.remove('animate-spin');
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');

      const emailInput = document.getElementById('email-input') as HTMLInputElement;
      const email = emailInput.value.trim();
      const password = pwInput.value;

      if (!email || !password) {
        showError('Please fill in all fields.');
        return;
      }

      setLoading(true);

      try {
        const result = await login(email, password);
        
        if (result.user.role !== 'superadmin') {
          showError('Access denied. Superadmin privileges required.');
          setLoading(false);
          return;
        }

        setToken(result.token);
        // Store user info for dashboard
        localStorage.setItem('dp_user', JSON.stringify(result.user));
        window.location.href = '/admin-dashboard';
      } catch (err: any) {
        const message = err?.message || 'Login failed. Please try again.';
        showError(message);
        setLoading(false);
      }
    });
  }
</script>
