---
/**
 * Admin Orders Management Page
 * Route: /admin-orders
 * Manages customer orders and their statuses.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Orders Management | Digital Papyrus" activePage="orders">
  <div class="flex flex-col md:flex-row items-start md:items-baseline justify-between mb-6 md:mb-8 gap-4">
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-primary font-headline mb-2">Orders Management</h2>
      <p class="text-stone-500 font-body text-sm max-w-xl">View and manage all customer orders with real-time status tracking.</p>
    </div>
    <div class="flex gap-3 md:gap-4 w-full md:w-auto">
      <button id="addOrderBtn" class="flex-1 md:flex-none px-4 md:px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-xs md:text-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/10">
        <span class="material-symbols-outlined text-sm">add</span> <span class="hidden sm:inline">Add New Order</span>
      </button>
    </div>
  </div>

  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-6 border border-stone-200/20 shadow-sm mb-6 md:mb-8 flex flex-col md:flex-row flex-wrap items-start md:items-center gap-3 md:gap-4 justify-between">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4 flex-1 w-full md:w-auto">
      <div class="relative w-full sm:max-w-sm">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm">search</span>
        <input id="searchInput" class="w-full bg-surface-container py-2.5 pl-10 pr-4 rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-stone-400" placeholder="Search by invoice or customer..." type="text" />
      </div>
      <select id="statusFilter" class="w-full sm:w-auto bg-surface-container py-2.5 px-4 rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 transition-all text-stone-600">
        <option value="">All Status</option>
        <option value="pending">Pending</option>
        <option value="waiting_confirmation">Waiting Confirmation</option>
        <option value="confirmed">Confirmed</option>
        <option value="processed">Processed</option>
        <option value="shipped">Shipped</option>
        <option value="delivered">Delivered</option>
        <option value="completed">Completed</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </div>
  </div>

  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-8 border border-stone-200/10 shadow-sm w-full max-w-full min-w-0 overflow-hidden">
    <div class="table-responsive-container overflow-x-auto w-full max-w-full block" style="-webkit-overflow-scrolling: touch;">
      <table class="w-full text-left min-w-[900px] border-collapse">
        <thead>
          <tr class="text-stone-400 font-label text-[10px] uppercase tracking-widest border-b border-stone-200/30 whitespace-nowrap">
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Invoice</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Name</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Total Qty</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Total</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Status</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Date</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 text-right whitespace-nowrap">Actions</th>
          </tr>
        </thead>
        <tbody id="ordersTableBody" class="text-sm font-body">
          <tr id="loadingRow">
            <td colspan="7" class="py-16 text-center">
              <div class="flex flex-col items-center gap-3">
                <span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span>
                <p class="text-stone-400 text-sm">Loading orders...</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-stone-200/20 pt-6 gap-4">
      <p id="paginationInfo" class="text-xs text-stone-400 font-medium">Loading...</p>
      <div id="paginationControls" class="flex gap-1.5"></div>
    </div>
  </div>

  <div id="toast" class="fixed bottom-6 right-6 z-[10000] hidden transform translate-y-4 opacity-0 transition-all duration-300">
    <div class="flex items-center gap-3 bg-stone-800 text-white px-5 py-3 rounded-xl shadow-2xl text-sm font-medium">
      <span id="toastIcon" class="material-symbols-outlined text-lg text-teal-400">check_circle</span>
      <span id="toastMsg">Operation successful</span>
    </div>
  </div>

  <div id="addOrderModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-2xl mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="addOrderModalContent">
      <div class="px-6 md:px-8 py-6 border-b border-stone-200/50 flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Add New Order</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="addOrderModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6 max-h-[75vh] overflow-y-auto custom-scrollbar">
        <form id="addOrderForm" class="space-y-4">
          <div class="space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">Customer *</label>
              <div class="inline-flex p-1 bg-stone-100 rounded-xl border border-stone-200 text-xs font-semibold self-start sm:self-auto">
                <button type="button" id="custModeSelectBtn" class="px-3.5 py-1.5 rounded-lg bg-white text-primary shadow-xs transition-all cursor-pointer">Pilih Terdaftar</button>
                <button type="button" id="custModeManualBtn" class="px-3.5 py-1.5 rounded-lg text-stone-500 hover:text-stone-800 transition-all cursor-pointer">Input Manual</button>
              </div>
            </div>
            
            <!-- Mode 1: Select Existing Customer -->
            <div id="custSelectWrapper">
              <select id="customerSelect" name="user_id" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all cursor-pointer">
                <option value="">Loading customers...</option>
              </select>
            </div>

            <!-- Mode 2: Manual Customer Input -->
            <div id="custManualWrapper" class="hidden space-y-3.5 bg-stone-50/90 p-4 sm:p-5 rounded-2xl border border-stone-200/90">
              <div class="space-y-1.5">
                <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">Nama Lengkap Customer *</label>
                <input id="manualCustomerName" name="customer_name" type="text" class="w-full bg-white py-2.5 px-3.5 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Contoh: Budi Santoso" />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                <div class="space-y-1.5">
                  <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">Email Customer *</label>
                  <input id="manualCustomerEmail" name="customer_email" type="email" class="w-full bg-white py-2.5 px-3.5 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="budi@example.com" />
                </div>
                <div class="space-y-1.5">
                  <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">No. WhatsApp / HP *</label>
                  <input id="manualCustomerPhone" name="customer_phone" type="tel" class="w-full bg-white py-2.5 px-3.5 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="08123456789" />
                </div>
              </div>

              <!-- Alamat Lengkap -->
              <div class="space-y-1.5">
                <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">Alamat Lengkap</label>
                <textarea id="manualCustomerAddress" name="customer_address" rows="2" class="w-full bg-white py-2.5 px-3.5 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all resize-none" placeholder="Nama jalan, gedung, nomor rumah, RT/RW"></textarea>
              </div>

              <!-- Cascading Regional Dropdowns (Responsive, No Clipped Values) -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 pt-1">
                <!-- Province -->
                <div class="space-y-1.5 relative" id="manual_province_wrapper">
                  <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">Provinsi</label>
                  <div class="relative">
                    <input id="manual_province_input" name="customer_province" type="text" autocomplete="off" class="w-full bg-white py-2.5 pl-3.5 pr-8 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-stone-400" placeholder="Pilih / cari provinsi..." />
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none text-xl">arrow_drop_down</span>
                  </div>
                  <div id="manual_province_list" class="hidden absolute left-0 right-0 top-full mt-1.5 z-[100] bg-surface-container-lowest border border-stone-200 rounded-xl shadow-2xl max-h-52 overflow-y-auto custom-scrollbar"></div>
                </div>

                <!-- City / Regency -->
                <div class="space-y-1.5 relative" id="manual_city_wrapper">
                  <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">Kota / Kabupaten (Regency)</label>
                  <div class="relative">
                    <input id="manual_city_input" name="customer_city" type="text" autocomplete="off" class="w-full bg-white py-2.5 pl-3.5 pr-8 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-stone-400" placeholder="Pilih / cari kota/kabupaten..." />
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none text-xl">arrow_drop_down</span>
                  </div>
                  <div id="manual_city_list" class="hidden absolute left-0 right-0 top-full mt-1.5 z-[100] bg-surface-container-lowest border border-stone-200 rounded-xl shadow-2xl max-h-52 overflow-y-auto custom-scrollbar"></div>
                </div>

                <!-- District (Kecamatan) -->
                <div class="space-y-1.5 relative" id="manual_district_wrapper">
                  <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">Kecamatan (District)</label>
                  <div class="relative">
                    <input id="manual_district_input" name="customer_district" type="text" autocomplete="off" class="w-full bg-white py-2.5 pl-3.5 pr-8 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-stone-400" placeholder="Pilih / cari kecamatan..." />
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none text-xl">arrow_drop_down</span>
                  </div>
                  <div id="manual_district_list" class="hidden absolute left-0 right-0 top-full mt-1.5 z-[100] bg-surface-container-lowest border border-stone-200 rounded-xl shadow-2xl max-h-52 overflow-y-auto custom-scrollbar"></div>
                </div>

                <!-- Village (Kelurahan / Desa) -->
                <div class="space-y-1.5 relative" id="manual_village_wrapper">
                  <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">Kelurahan / Desa (Village)</label>
                  <div class="relative">
                    <input id="manual_village_input" name="customer_village" type="text" autocomplete="off" class="w-full bg-white py-2.5 pl-3.5 pr-8 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-stone-400" placeholder="Pilih / cari kelurahan..." />
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none text-xl">arrow_drop_down</span>
                  </div>
                  <div id="manual_village_list" class="hidden absolute left-0 right-0 top-full mt-1.5 z-[100] bg-surface-container-lowest border border-stone-200 rounded-xl shadow-2xl max-h-52 overflow-y-auto custom-scrollbar"></div>
                </div>

                <!-- Zip Code -->
                <div class="space-y-1.5 sm:col-span-2">
                  <label class="text-xs font-bold text-stone-600 uppercase tracking-wider">Kode Pos (Zip Code)</label>
                  <input id="manualCustomerZipCode" name="customer_zip_code" type="text" class="w-full bg-white py-2.5 px-3.5 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-stone-400" placeholder="Contoh: 40135" />
                </div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Invoice Number</label>
              <input id="invoiceInput" name="invoice" type="text" readonly class="w-full bg-stone-100 py-2.5 px-4 rounded-xl text-sm border border-stone-200 outline-none transition-all cursor-not-allowed font-mono font-bold text-primary" placeholder="Generating..." />
              <p class="text-[10px] text-stone-400">Generated automatically (INV-DDMMYYYY-XXXX-XXXX).</p>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Status</label>
              <div class="py-2.5 px-4 bg-stone-100/70 border border-stone-200 rounded-xl flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="inline-block w-2.5 h-2.5 rounded-full bg-yellow-500"></span>
                  <span class="text-sm font-bold text-stone-700">Pending</span>
                </div>
                <span class="text-[11px] text-stone-400 font-medium bg-stone-200/60 px-2 py-0.5 rounded-md">Otomatis</span>
              </div>
              <input type="hidden" name="status" value="pending" />
            </div>
          </div>
          <input type="hidden" name="total_qty" value="0" />
          <input type="hidden" name="total_price" value="0" />
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Notes</label>
            <textarea name="notes" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" rows="3" placeholder="Optional notes for this order"></textarea>
          </div>
          <div class="space-y-5 pt-2 border-t border-stone-100">
            <div class="flex items-center justify-between">
              <label class="text-sm font-extrabold text-stone-700 uppercase tracking-wider flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">shopping_cart</span> Order Items *
              </label>
              <button type="button" id="addItemBtn" class="px-4 py-1.5 bg-primary text-white text-xs font-bold rounded-xl hover:opacity-90 transition-all flex items-center gap-1.5 shadow-md shadow-primary/20">
                <span class="material-symbols-outlined text-base">add</span> Add Item
              </button>
            </div>
            <div id="itemsList" class="space-y-3">
              <!-- Item rows will be injected here -->
            </div>
            <textarea name="items" id="itemsHidden" class="hidden"></textarea>

            <!-- Biaya Tambahan & Rincian Grand Total -->
            <div class="bg-stone-50/80 p-4 sm:p-5 rounded-2xl border border-stone-200 space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-extrabold text-stone-700 uppercase tracking-wider flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-primary text-base">receipt_long</span>
                  Rincian Biaya & Total
                </span>
                <span class="text-[11px] text-stone-400 font-medium">Bisa disesuaikan</span>
              </div>

              <!-- Inputs for Additional Fees -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
                <div class="space-y-1">
                  <label class="text-[10px] font-bold text-stone-500 uppercase tracking-wider">Ongkir (Rp)</label>
                  <input id="orderShippingPriceInput" name="shipping_price" type="number" min="0" value="0" class="w-full bg-white py-2 px-3 rounded-xl text-xs font-bold text-stone-800 border border-stone-200 focus:border-primary outline-none transition-all" />
                </div>
                <div class="space-y-1">
                  <label class="text-[10px] font-bold text-stone-500 uppercase tracking-wider">Biaya Layanan (Rp)</label>
                  <input id="orderServiceFeeInput" name="service_fee" type="number" min="0" value="0" class="w-full bg-white py-2 px-3 rounded-xl text-xs font-bold text-stone-800 border border-stone-200 focus:border-primary outline-none transition-all" />
                </div>
                <div class="space-y-1">
                  <label class="text-[10px] font-bold text-stone-500 uppercase tracking-wider">Pajak / PPN (%)</label>
                  <div class="relative">
                    <input id="orderTaxRateInput" name="tax_rate" type="number" min="0" max="100" step="0.1" value="0" class="w-full bg-white py-2 pl-3 pr-7 rounded-xl text-xs font-bold text-stone-800 border border-stone-200 focus:border-primary outline-none transition-all" placeholder="0" />
                    <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-400 font-bold text-xs pointer-events-none">%</span>
                  </div>
                  <input type="hidden" id="orderTaxHidden" name="tax" value="0" />
                </div>
                <div class="space-y-1">
                  <label class="text-[10px] font-bold text-stone-500 uppercase tracking-wider">Diskon (Rp)</label>
                  <input id="orderDiscountInput" name="discount" min="0" value="0" type="number" class="w-full bg-white py-2 px-3 rounded-xl text-xs font-bold text-emerald-600 border border-stone-200 focus:border-primary outline-none transition-all" />
                </div>
              </div>

              <!-- Breakdown Summary Card -->
              <div class="pt-3 border-t border-stone-200/80 space-y-1.5 text-xs text-stone-600">
                <div class="flex justify-between">
                  <span>Subtotal Produk (<span id="summaryTotalQty">0</span> item)</span>
                  <span id="summarySubtotalItems" class="font-bold text-stone-800">Rp 0</span>
                </div>
                <div id="summaryRowShipping" class="flex justify-between">
                  <span>Biaya Pengiriman (Ongkir)</span>
                  <span id="summaryShippingPrice" class="font-bold text-stone-800">Rp 0</span>
                </div>
                <div id="summaryRowServiceFee" class="flex justify-between">
                  <span>Biaya Layanan</span>
                  <span id="summaryServiceFee" class="font-bold text-stone-800">Rp 0</span>
                </div>
                <div id="summaryRowTax" class="flex justify-between">
                  <span>Pajak (PPN)</span>
                  <span id="summaryTax" class="font-bold text-stone-800">Rp 0</span>
                </div>
                <div id="summaryRowDiscount" class="flex justify-between text-emerald-600 hidden">
                  <span>Diskon</span>
                  <span id="summaryDiscount" class="font-bold">-Rp 0</span>
                </div>
                <div class="pt-2.5 border-t border-stone-300 flex justify-between items-baseline">
                  <div>
                    <span class="font-black text-primary text-sm uppercase tracking-wider">Grand Total</span>
                    <p id="itemsSummary" class="text-[11px] text-stone-400 font-medium italic truncate max-w-[200px] sm:max-w-xs">No items added.</p>
                  </div>
                  <span id="estimatedTotal" class="text-xl sm:text-2xl font-black text-primary font-headline">Rp 0</span>
                </div>
              </div>
            </div>
          </div>
          <div class="space-y-4">
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Payment Type *</label>
              <select name="payment_type" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all font-medium cursor-pointer">
                <option value="Bank Transfer">Bank Transfer</option>
                <option value="E-Wallet">E-Wallet</option>
                <option value="Cash">Cash</option>
              </select>
            </div>

            <!-- Shipping container: only shown when softcover or hardcover book items are added -->
            <div id="shippingFieldsContainer" class="hidden space-y-3 bg-stone-50/80 p-4 rounded-xl border border-stone-200">
              <div class="flex items-center gap-2 text-xs font-bold text-stone-700 uppercase tracking-wider">
                <span class="material-symbols-outlined text-primary text-base">local_shipping</span>
                Informasi Pengiriman (Buku Fisik)
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-2">
                  <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Shipping Name</label>
                  <input name="shipping_name" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Contoh: JNE / J&T / SiCepat / Kurir" />
                </div>
                <div class="space-y-2">
                  <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Shipping Service</label>
                  <input name="shipping_service" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Contoh: REG / OKE / Express" />
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="px-6 md:px-8 py-5 bg-surface-container flex items-center justify-end gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn px-5 py-2.5 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="addOrderModal">Cancel</button>
        <button id="saveOrderBtn" class="px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-sm hover:opacity-90 transition-all shadow-lg shadow-primary/10 disabled:opacity-50" type="button">Save Order</button>
      </div>
    </div>
  </div>

  <div id="viewOrderModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-2xl mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="viewOrderModalContent">
      <div class="px-6 md:px-8 py-6 border-b border-stone-200/50 flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Order Details</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="viewOrderModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6 space-y-5 max-h-[60vh] overflow-y-auto">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Order ID</p>
            <p id="viewOrderId" class="text-lg font-bold text-primary font-mono"></p>
          </div>
          <div>
            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Status</p>
            <div id="viewOrderStatus" class="inline-block px-3 py-1 rounded-full text-xs font-bold text-white bg-stone-500"></div>
          </div>
        </div>

        <div>
