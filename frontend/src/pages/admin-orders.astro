  <script>
    import { createAdminOrder, deleteOrder, getBooks, getOrder, getOrders, getServices, getUsers, isAuthenticated, confirmAdminOrderPayment, updateOrderStatus, settingsApi, getProvinces, getRegencies, getDistricts, getVillages, type RegionOption } from '../lib/api';
    import type { Book, Order as ApiOrder, Service, User } from '../lib/api';

    if (!isAuthenticated()) {
      window.location.href = '/admin-login';
    }

    type Order = ApiOrder;

    const tableBody = document.getElementById('ordersTableBody')!;
    const paginationInfo = document.getElementById('paginationInfo')!;
    const paginationControls = document.getElementById('paginationControls')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
    const customerSelect = document.getElementById('customerSelect') as HTMLSelectElement;
    const itemsHidden = document.getElementById('itemsHidden') as HTMLTextAreaElement;
    const addOrderForm = document.getElementById('addOrderForm') as HTMLFormElement;
    const saveOrderBtn = document.getElementById('saveOrderBtn') as HTMLButtonElement;
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn') as HTMLButtonElement;

    let allOrders: Order[] = [];
    let customers: User[] = [];
    let orderBooks: Book[] = [];
    let orderServices: Service[] = [];
    let currentPage = 1;
    const perPage = 10;
    let searchKeyword = '';
    let selectedStatus = '';
    let deleteTargetId = '';
    let currentViewingOrder: Order | null = null;
    let isCustomerManual = false;
    const custModeSelectBtn = document.getElementById('custModeSelectBtn') as HTMLButtonElement;
    const custModeManualBtn = document.getElementById('custModeManualBtn') as HTMLButtonElement;
    const custSelectWrapper = document.getElementById('custSelectWrapper');
    const custManualWrapper = document.getElementById('custManualWrapper');
    const manualCustomerName = document.getElementById('manualCustomerName') as HTMLInputElement;
    const manualCustomerEmail = document.getElementById('manualCustomerEmail') as HTMLInputElement;
    const manualCustomerPhone = document.getElementById('manualCustomerPhone') as HTMLInputElement;
    const manualCustomerAddress = document.getElementById('manualCustomerAddress') as HTMLTextAreaElement;

    const orderShippingPriceInput = document.getElementById('orderShippingPriceInput') as HTMLInputElement;
    const orderServiceFeeInput = document.getElementById('orderServiceFeeInput') as HTMLInputElement;
    const orderTaxRateInput = document.getElementById('orderTaxRateInput') as HTMLInputElement;
    const orderTaxHidden = document.getElementById('orderTaxHidden') as HTMLInputElement;
    const orderDiscountInput = document.getElementById('orderDiscountInput') as HTMLInputElement;

    orderShippingPriceInput?.addEventListener('input', () => syncAllItems());
    orderServiceFeeInput?.addEventListener('input', () => syncAllItems());
    orderTaxRateInput?.addEventListener('input', () => syncAllItems());
    orderDiscountInput?.addEventListener('input', () => syncAllItems());

    interface DropdownInstance {
      setOptions: (opts: RegionOption[]) => void;
      getOptions: () => RegionOption[];
      getSelectedCode: () => string;
      getSelectedName: () => string;
      setSelected: (val: string) => void;
      clear: () => void;
    }

    function initSearchableDropdown(
      inputEl: HTMLInputElement,
      listEl: HTMLDivElement,
      fetchFn: () => Promise<RegionOption[]>,
      onSelect: (option: RegionOption) => void,
      onClear: () => void
    ): DropdownInstance {
      let allOptions: RegionOption[] = [];
      let selectedCode: string | null = null;
      let selectedName: string = '';

      function renderOptions(opts: RegionOption[]) {
        listEl.innerHTML = '';
        if (opts.length === 0) {
          listEl.innerHTML = '<div class="px-4 py-3 text-stone-400 text-xs italic text-center">No results found</div>';
          return;
        }
        opts.forEach(opt => {
          const item = document.createElement('div');
          item.className = 'w-full px-4 py-2.5 text-stone-700 hover:bg-primary/10 hover:text-primary cursor-pointer text-xs sm:text-sm transition-colors border-b border-stone-100 last:border-b-0 whitespace-normal break-words leading-relaxed text-left font-medium select-none';
          item.textContent = opt.name;
          item.addEventListener('click', (e) => {
            e.stopPropagation();
            inputEl.value = opt.name;
            selectedCode = opt.code;
            selectedName = opt.name;
            listEl.classList.add('hidden');
            onSelect(opt);
          });
          listEl.appendChild(item);
        });
      }

      inputEl.addEventListener('focus', async () => {
        if (allOptions.length === 0) {
          listEl.innerHTML = '<div class="px-4 py-3 text-stone-400 text-xs italic text-center">Loading options...</div>';
          listEl.classList.remove('hidden');
          try {
            allOptions = await fetchFn();
            renderOptions(allOptions);
          } catch {
            listEl.innerHTML = '<div class="px-4 py-3 text-red-500 text-xs text-center">Failed to load options</div>';
          }
        } else {
          const term = inputEl.value.toLowerCase().trim();
          const filtered = term ? allOptions.filter(opt => opt.name.toLowerCase().includes(term) || opt.code.toLowerCase().includes(term)) : allOptions;
          renderOptions(filtered);
          listEl.classList.remove('hidden');
        }
      });

      inputEl.addEventListener('click', (e) => {
        e.stopPropagation();
        if (listEl.classList.contains('hidden') && allOptions.length > 0) {
          const term = inputEl.value.toLowerCase().trim();
          const filtered = term ? allOptions.filter(opt => opt.name.toLowerCase().includes(term) || opt.code.toLowerCase().includes(term)) : allOptions;
          renderOptions(filtered);
          listEl.classList.remove('hidden');
        }
      });

      inputEl.addEventListener('input', () => {
        const term = inputEl.value.toLowerCase().trim();
        const filtered = allOptions.filter(opt => opt.name.toLowerCase().includes(term) || opt.code.toLowerCase().includes(term));
        renderOptions(filtered);
        listEl.classList.remove('hidden');
        if (term === '') {
          selectedCode = null;
          selectedName = '';
          onClear();
        } else {
          const exact = allOptions.find(opt => opt.name.toLowerCase() === term || opt.code.toLowerCase() === term);
          if (exact) {
            selectedCode = exact.code;
            selectedName = exact.name;
          } else {
            selectedCode = null;
            selectedName = '';
          }
        }
      });

      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (!inputEl.parentElement?.contains(target) && !listEl.contains(target)) {
          listEl.classList.add('hidden');
        }
      });

      return {
        setOptions: (opts: RegionOption[]) => {
          allOptions = opts;
          if (selectedCode) {
            const found = opts.find(opt => opt.code === selectedCode || opt.name.toLowerCase() === selectedCode?.toLowerCase());
            if (found) {
              inputEl.value = found.name;
              selectedCode = found.code;
              selectedName = found.name;
            }
          }
        },
        getOptions: () => allOptions,
        getSelectedCode: () => selectedCode || inputEl.value.trim(),
        getSelectedName: () => selectedName || inputEl.value.trim(),
        setSelected: (val: string) => {
          if (!val) {
            inputEl.value = '';
            selectedCode = null;
            selectedName = '';
            return;
          }
          const found = allOptions.find(opt => opt.code === val || opt.name.toLowerCase() === val.toLowerCase());
          if (found) {
            inputEl.value = found.name;
            selectedCode = found.code;
            selectedName = found.name;
          } else {
            inputEl.value = val;
            selectedCode = val;
            selectedName = val;
          }
        },
        clear: () => {
          inputEl.value = '';
          selectedCode = null;
          selectedName = '';
          allOptions = [];
          listEl.innerHTML = '';
          listEl.classList.add('hidden');
        }
      };
    }

    const manualProvInput = document.getElementById('manual_province_input') as HTMLInputElement;
    const manualProvList = document.getElementById('manual_province_list') as HTMLDivElement;
    const manualCityInput = document.getElementById('manual_city_input') as HTMLInputElement;
    const manualCityList = document.getElementById('manual_city_list') as HTMLDivElement;
    const manualDistInput = document.getElementById('manual_district_input') as HTMLInputElement;
    const manualDistList = document.getElementById('manual_district_list') as HTMLDivElement;
    const manualVillInput = document.getElementById('manual_village_input') as HTMLInputElement;
    const manualVillList = document.getElementById('manual_village_list') as HTMLDivElement;
    const manualZipInput = document.getElementById('manualCustomerZipCode') as HTMLInputElement;

    const manualProvDropdown = initSearchableDropdown(
      manualProvInput,
      manualProvList,
      async () => getProvinces(),
      async (prov) => {
        manualCityDropdown.clear();
        manualDistDropdown.clear();
        manualVillDropdown.clear();
        const cities = await getRegencies(prov.code);
        manualCityDropdown.setOptions(cities);
      },
      () => {
        manualCityDropdown.clear();
        manualDistDropdown.clear();
        manualVillDropdown.clear();
      }
    );

    const manualCityDropdown = initSearchableDropdown(
      manualCityInput,
      manualCityList,
      async () => {
        const provCode = manualProvDropdown.getSelectedCode();
        if (!provCode) return [];
        return getRegencies(provCode);
      },
      async (city) => {
        manualDistDropdown.clear();
        manualVillDropdown.clear();
        const districts = await getDistricts(city.code);
        manualDistDropdown.setOptions(districts);
      },
      () => {
        manualDistDropdown.clear();
        manualVillDropdown.clear();
      }
    );

    const manualDistDropdown = initSearchableDropdown(
      manualDistInput,
      manualDistList,
      async () => {
        const cityCode = manualCityDropdown.getSelectedCode();
        if (!cityCode) return [];
        return getDistricts(cityCode);
      },
      async (dist) => {
        manualVillDropdown.clear();
        const villages = await getVillages(dist.code);
        manualVillDropdown.setOptions(villages);
      },
      () => {
        manualVillDropdown.clear();
      }
    );

    const manualVillDropdown = initSearchableDropdown(
      manualVillInput,
      manualVillList,
      async () => {
        const distCode = manualDistDropdown.getSelectedCode();
        if (!distCode) return [];
        return getVillages(distCode);
      },
      (vill) => {
        if (vill.postal_codes && vill.postal_codes.length > 0 && manualZipInput) {
          manualZipInput.value = vill.postal_codes[0];
        }
      },
      () => {}
    );

    custModeSelectBtn?.addEventListener('click', () => {
      isCustomerManual = false;
      custModeSelectBtn.className = 'px-3.5 py-1.5 rounded-lg bg-white text-primary shadow-xs transition-all cursor-pointer';
      custModeManualBtn.className = 'px-3.5 py-1.5 rounded-lg text-stone-500 hover:text-stone-800 transition-all cursor-pointer';
      custSelectWrapper?.classList.remove('hidden');
      custManualWrapper?.classList.add('hidden');
      if (customerSelect) customerSelect.required = true;
      if (manualCustomerName) manualCustomerName.required = false;
      if (manualCustomerEmail) manualCustomerEmail.required = false;
      if (manualCustomerPhone) manualCustomerPhone.required = false;
    });

    custModeManualBtn?.addEventListener('click', () => {
      isCustomerManual = true;
      custModeManualBtn.className = 'px-3.5 py-1.5 rounded-lg bg-white text-primary shadow-xs transition-all cursor-pointer';
      custModeSelectBtn.className = 'px-3.5 py-1.5 rounded-lg text-stone-500 hover:text-stone-800 transition-all cursor-pointer';
      custSelectWrapper?.classList.add('hidden');
      custManualWrapper?.classList.remove('hidden');
      if (customerSelect) {
        customerSelect.required = false;
        customerSelect.value = '';
      }
      if (manualCustomerName) manualCustomerName.required = true;
      if (manualCustomerEmail) manualCustomerEmail.required = true;
      if (manualCustomerPhone) manualCustomerPhone.required = true;
    });

    const modalIds = ['addOrderModal', 'viewOrderModal', 'deleteModal', 'editOrderModal'];

    document.querySelectorAll('#addOrderModal, #viewOrderModal, #deleteModal, #toast').forEach((el) => {
      document.body.appendChild(el);
    });

    document.querySelectorAll('.closeModalBtn').forEach((button) => {
      button.addEventListener('click', () => {
        const modalId = (button as HTMLElement).dataset.modal;
        if (modalId) closeModalById(modalId);
      });
    });

    modalIds.forEach((modalId) => {
      const modal = document.getElementById(modalId);
      if (!modal) return;

      modal.addEventListener('click', (event) => {
        if (event.target === modal) {
          closeModalById(modalId);
        }
      });
    });

    function formatDate(dateStr: string): string {
      if (!dateStr) return '--';
      return new Date(dateStr).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function formatDateTimeWIB(dateStr: string): string {
      if (!dateStr) return '--';
      const d = new Date(dateStr);
      const datePart = d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
      const hours = String(d.getHours()).padStart(2, '0');
      const minutes = String(d.getMinutes()).padStart(2, '0');
      return `${datePart}, ${hours}:${minutes} WIB`;
    }

    function formatPrice(price: number): string {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(price);
    }

    function escapeHtml(str: string): string {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getStatusBadgeClass(status: string): string {
      const classes: Record<string, string> = {
        pending: 'bg-yellow-500',
        waiting_confirmation: 'bg-indigo-600',
        confirmed: 'bg-emerald-600',
        processed: 'bg-sky-500',
        diproses: 'bg-sky-500',
        shipped: 'bg-purple-500',
        delivered: 'bg-green-500',
        cancelled: 'bg-red-500',
        completed: 'bg-teal-600',
      };
      return classes[status] || 'bg-stone-500';
    }

    function showToast(msg: string, type: 'success' | 'error' = 'success') {
      const toast = document.getElementById('toast')!;
      const toastMsg = document.getElementById('toastMsg')!;
      const toastIcon = document.getElementById('toastIcon')!;
      toastMsg.textContent = msg;
      toastIcon.textContent = type === 'success' ? 'check_circle' : 'error';
      toastIcon.className = `material-symbols-outlined text-lg ${type === 'success' ? 'text-teal-400' : 'text-red-400'}`;
      toast.classList.remove('hidden', 'translate-y-4', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('translate-y-4', 'opacity-0');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3000);
    }

    function openModal(id: string) {
      const wrap = document.getElementById(id);
      const content = document.getElementById(`${id}Content`);
      if (!wrap || !content) return;
      wrap.classList.remove('hidden');
      setTimeout(() => {
        wrap.classList.remove('opacity-0');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
      }, 10);
    }

    function closeModalById(id: string) {
      const wrap = document.getElementById(id);
      const content = document.getElementById(`${id}Content`);
      if (!wrap || !content) return;
      wrap.classList.add('opacity-0');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
      setTimeout(() => wrap.classList.add('hidden'), 300);
    }

    function populateCustomerSelect() {
      if (!customerSelect) return;
      const options = customers.length
        ? customers.map((user) => `<option value="${user.id}">${user.name} (${user.email})</option>`).join('')
        : '<option value="">No customer available</option>';

      customerSelect.innerHTML = `<option value="">Select customer</option>${options}`;
    }
    
    function generateNextInvoice(): string {
      const now = new Date();
      const d = String(now.getDate()).padStart(2, '0');
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const y = String(now.getFullYear());
      const seq = Date.now().toString().slice(-4);
      const uniqueChars = Math.random().toString(36).substring(2, 6).toUpperCase();
      return `INV-${d}${m}${y}-${seq}-${uniqueChars}`;
    }

    function addItemRow() {
      const itemsList = document.getElementById('itemsList');
      if (!itemsList) return;

      const rowId = 'row_' + Math.random().toString(36).substr(2, 9);
      const row = document.createElement('div');
      row.id = rowId;
      row.className = 'item-row bg-surface border border-stone-200 rounded-xl p-4 space-y-4 shadow-sm';
      
      let options = '<option value="">Choose item...</option>';
      if (orderBooks.length > 0) {
        options += '<optgroup label="Books">';
        orderBooks.forEach(b => {
          const fmt = (b.format || '').trim();
          const label = fmt ? `${b.title} (${fmt})` : b.title;
          options += `<option value="book:${b.id}" data-price="${b.price}" data-title="${escapeHtml(b.title)}" data-format="${escapeHtml(fmt)}">${escapeHtml(label)} - ${formatPrice(b.price)}</option>`;
        });
        options += '</optgroup>';
      }
      if (orderServices.length > 0) {
        options += '<optgroup label="Services">';
        orderServices.forEach(s => options += `<option value="service:${s.id}" data-price="${s.price}" data-title="${escapeHtml(s.title)}">${escapeHtml(s.title)} - ${formatPrice(s.price)}</option>`);
        options += '</optgroup>';
      }

      row.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="flex-1 space-y-3">
            <select class="item-select w-full bg-surface-container-low py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all font-medium">
              ${options}
            </select>
            <div class="qty-container hidden flex items-center gap-3">
              <label class="text-[11px] font-bold text-stone-500 uppercase tracking-wider">Quantity:</label>
              <input type="number" min="1" value="1" class="item-qty w-24 bg-surface-container-low py-2 px-3 rounded-xl text-sm border border-stone-200 focus:border-primary outline-none transition-all font-bold text-primary" />
            </div>
          </div>
          <button type="button" class="remove-item-btn text-stone-300 hover:text-red-500 transition-colors p-1 mt-1" title="Remove item">
            <span class="material-symbols-outlined text-xl">delete</span>
          </button>
        </div>
      `;

      itemsList.appendChild(row);

      const select = row.querySelector('.item-select') as HTMLSelectElement;
      const qtyInput = row.querySelector('.item-qty') as HTMLInputElement;
      const removeBtn = row.querySelector('.remove-item-btn') as HTMLButtonElement;
      const qtyContainer = row.querySelector('.qty-container') as HTMLElement;

      select.addEventListener('change', () => {
        const val = select.value;
        if (val.startsWith('book:')) {
          qtyContainer.classList.remove('hidden');
        } else {
          qtyContainer.classList.add('hidden');
          qtyInput.value = '1';
        }
        syncAllItems();
      });

      qtyInput.addEventListener('input', syncAllItems);
      removeBtn.addEventListener('click', () => {
        row.remove();
        syncAllItems();
      });

      syncAllItems();
    }

    function syncAllItems() {
      const rows = document.querySelectorAll('.item-row');
      const summaryTotalQty = document.getElementById('summaryTotalQty');
      const summarySubtotalItems = document.getElementById('summarySubtotalItems');
      const summaryShippingPrice = document.getElementById('summaryShippingPrice');
      const summaryServiceFee = document.getElementById('summaryServiceFee');
      const summaryTax = document.getElementById('summaryTax');
      const summaryDiscount = document.getElementById('summaryDiscount');
      const summaryRowDiscount = document.getElementById('summaryRowDiscount');

      const totalQtyInput = addOrderForm.querySelector('input[name="total_qty"]') as HTMLInputElement;
      const totalPriceInput = addOrderForm.querySelector('input[name="total_price"]') as HTMLInputElement;

      if (!itemsSummary || !estimatedTotal || !summaryTotalQty || !itemsHidden || !totalQtyInput || !totalPriceInput) return;

      let totalQty = 0;
      let itemsSubtotal = 0;
      let hasPhysicalBook = false;
      let hasInvalidItem = false;
      let validItemsCount = 0;
      const itemStrings: string[] = [];

      rows.forEach(row => {
        const select = row.querySelector('.item-select') as HTMLSelectElement;
        const qtyInput = row.querySelector('.item-qty') as HTMLInputElement;
        const opt = select.selectedOptions[0];

        if (!opt || !opt.value) {
          hasInvalidItem = true;
          return;
        }

        validItemsCount++;
        const title = opt.dataset.title || '';
        const price = parseInt(opt.dataset.price || '0', 10);
        const qty = parseInt(qtyInput.value || '1', 10);
        const format = (opt.dataset.format || '').toLowerCase();
        if (format.includes('softcover') || format.includes('hardcover')) {
          hasPhysicalBook = true;
        }
        
        totalQty += qty;
        itemsSubtotal += (price * qty);
        itemStrings.push(`${title} x${qty}`);
      });

      const shippingContainer = document.getElementById('shippingFieldsContainer');
      const shippingNameInput = document.querySelector('input[name="shipping_name"]') as HTMLInputElement;
      const shippingServiceInput = document.querySelector('input[name="shipping_service"]') as HTMLInputElement;
      if (shippingContainer) {
        if (hasPhysicalBook) {
          shippingContainer.classList.remove('hidden');
        } else {
          shippingContainer.classList.add('hidden');
          if (shippingNameInput) shippingNameInput.value = '';
          if (shippingServiceInput) shippingServiceInput.value = '';
        }
      }

      // Additional fee calculations
      const shipPrice = Math.max(0, parseInt(orderShippingPriceInput?.value || '0', 10) || 0);
      const sFee = Math.max(0, parseInt(orderServiceFeeInput?.value || '0', 10) || 0);
      const taxRate = Math.max(0, parseFloat(orderTaxRateInput?.value || '0') || 0);
      const tax = Math.round((itemsSubtotal * taxRate) / 100);
      if (orderTaxHidden) orderTaxHidden.value = String(tax);
      const disc = Math.max(0, parseInt(orderDiscountInput?.value || '0', 10) || 0);

      let grandTotal = itemsSubtotal + shipPrice + sFee + tax - disc;
      if (grandTotal < 0) grandTotal = 0;

      summaryTotalQty.textContent = String(totalQty);
      if (summarySubtotalItems) summarySubtotalItems.textContent = formatPrice(itemsSubtotal);
      if (summaryShippingPrice) summaryShippingPrice.textContent = formatPrice(shipPrice);
      if (summaryServiceFee) summaryServiceFee.textContent = formatPrice(sFee);
      if (summaryTax) summaryTax.textContent = taxRate > 0 ? `${formatPrice(tax)} (${taxRate}%)` : formatPrice(tax);
      if (summaryRowDiscount && summaryDiscount) {
        if (disc > 0) {
          summaryRowDiscount.classList.remove('hidden');
          summaryDiscount.textContent = `-${formatPrice(disc)}`;
        } else {
          summaryRowDiscount.classList.add('hidden');
        }
      }

      if (itemStrings.length === 0) {
        itemsSummary.textContent = 'No items added.';
        itemsHidden.value = '';
        totalQtyInput.value = '0';
      } else {
        itemsSummary.textContent = itemStrings.join(', ');
        itemsHidden.value = itemStrings.join(', ');
        totalQtyInput.value = String(totalQty);
      }

      estimatedTotal.textContent = formatPrice(grandTotal);
      totalPriceInput.value = String(grandTotal);

      // Disable or enable Save Order button based on valid items
      const canSave = !hasInvalidItem && validItemsCount > 0;
      if (saveOrderBtn) {
        if (!canSave) {
          saveOrderBtn.disabled = true;
          saveOrderBtn.classList.add('opacity-50', 'cursor-not-allowed');
          saveOrderBtn.title = 'Silakan pilih produk/layanan yang valid (tidak boleh "Choose item...")';
        } else {
          saveOrderBtn.disabled = false;
          saveOrderBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          saveOrderBtn.title = '';
        }
      }
    }

    async function loadCustomers() {
      try {
        const users = await getUsers();
        customers = users.filter((user) => user.role === 'customer' && user.is_active);
        populateCustomerSelect();
      } catch {
        customers = [];
        populateCustomerSelect();
      }
    }

    async function loadOrderItems() {
      try {
        const [booksResult, servicesResult] = await Promise.all([
          getBooks({ page: 1, per_page: 1000, status: 'published' }),
          getServices(false),
        ]);

        orderBooks = booksResult.books;
        orderServices = servicesResult.filter((service) => service.is_active);
      } catch {
        orderBooks = [];
        orderServices = [];
      }
    }

    async function loadOrders() {
      tableBody.innerHTML = `<tr><td colspan="7" class="py-16 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span><p class="text-stone-400 text-sm">Loading orders...</p></div></td></tr>`;

      try {
        const { orders } = await getOrders({
          page: 1,
          per_page: 1000,
          search: searchKeyword || undefined,
          status: selectedStatus || undefined,
        });

        allOrders = orders;
        currentPage = 1;
        renderTable();
      } catch (err: any) {
        tableBody.innerHTML = `<tr><td colspan="7" class="py-16 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-4xl text-red-300">error</span><p class="text-stone-500 text-sm">${err.message || 'Failed to load orders'}</p><button class="retryBtn text-primary font-bold text-sm mt-2 hover:underline">Retry</button></div></td></tr>`;
        tableBody.querySelector('.retryBtn')?.addEventListener('click', loadOrders);
      }
    }

    function renderTable() {
      const total = allOrders.length;
      const totalPages = Math.max(1, Math.ceil(total / perPage));
      if (currentPage > totalPages) currentPage = totalPages;
      const startIdx = (currentPage - 1) * perPage;
      const paged = allOrders.slice(startIdx, startIdx + perPage);

      if (paged.length === 0) {
        tableBody.innerHTML = `
          <tr><td colspan="7" class="py-16 text-center">
            <div class="flex flex-col items-center gap-3">
              <span class="material-symbols-outlined text-4xl text-stone-300">inbox</span>
              <p class="text-stone-400 text-sm">No orders found</p>
            </div>
          </td></tr>`;
        paginationInfo.textContent = total === 0 ? 'No items' : `Showing 0 of ${total.toLocaleString()} orders`;
        paginationControls.innerHTML = '';
        return;
      }

      tableBody.innerHTML = paged
        .map((order, idx) => {
          const borderCls = idx < paged.length - 1 ? 'border-b border-stone-200/10' : '';
          return `<tr class="group hover:bg-surface-container-low/50 transition-colors whitespace-nowrap ${borderCls}" data-id="${order.id}">
            <td class="py-4 md:py-5 px-3 md:px-4 whitespace-nowrap">
              <p class="font-bold text-primary text-sm md:text-base font-mono">${order.invoice}</p>
            </td>
            <td class="py-4 md:py-5 px-3 md:px-4 text-stone-600 font-medium whitespace-nowrap">${order.user_name || order.user_id}</td>
            <td class="py-4 md:py-5 px-3 md:px-4 text-stone-600 text-xs whitespace-nowrap">${order.total_qty}</td>
            <td class="py-4 md:py-5 px-3 md:px-4 text-stone-600 font-semibold whitespace-nowrap">${formatPrice(order.total_price)}</td>
            <td class="py-4 md:py-5 px-3 md:px-4 whitespace-nowrap">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold text-white ${getStatusBadgeClass(order.status)}">${order.status.replace(/_/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}</span>
            </td>
            <td class="py-4 md:py-5 px-3 md:px-4 font-medium text-stone-600 text-xs whitespace-nowrap">${formatDate(order.created_at)}</td>
            <td class="py-4 md:py-5 px-3 md:px-4 text-right whitespace-nowrap">
              <div class="flex items-center justify-end gap-2">
                <button class="viewBtn w-8 h-8 rounded-lg flex items-center justify-center text-stone-500 hover:text-primary hover:bg-stone-200/50 transition-all" title="View" data-id="${order.id}">
                  <span class="material-symbols-outlined text-lg">visibility</span>
                </button>
                <button class="deleteBtn w-8 h-8 rounded-lg flex items-center justify-center text-stone-500 hover:text-error hover:bg-stone-200/50 transition-all" title="Delete" data-id="${order.id}" data-order-id="${order.invoice}">
                  <span class="material-symbols-outlined text-lg">delete</span>
                </button>
              </div>
            </td>
          </tr>`;
        })
        .join('');

      const start = startIdx + 1;
      const end = Math.min(startIdx + perPage, total);
      paginationInfo.textContent = `Showing ${start}-${end} of ${total.toLocaleString()} orders`;

      let pagBtns = '';
      pagBtns += `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors ${currentPage <= 1 ? 'opacity-30 pointer-events-none' : ''}" data-page="${currentPage - 1}" aria-label="Previous"><span class="material-symbols-outlined text-sm text-stone-400">chevron_left</span></button>`;

      for (let p = 1; p <= totalPages; p++) {
        if (totalPages > 5 && p > 3 && p < totalPages - 1 && Math.abs(p - currentPage) > 1) {
          if (p === 4) pagBtns += `<span class="w-9 h-9 flex items-center justify-center text-stone-400 text-xs tracking-wider">...</span>`;
          continue;
        }
        pagBtns += p === currentPage
          ? `<button class="w-9 h-9 rounded-lg flex items-center justify-center bg-primary text-white font-bold text-xs">${p}</button>`
          : `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors font-medium text-xs" data-page="${p}">${p}</button>`;
      }

      pagBtns += `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors ${currentPage >= totalPages ? 'opacity-30 pointer-events-none' : ''}" data-page="${currentPage + 1}" aria-label="Next"><span class="material-symbols-outlined text-sm text-stone-400">chevron_right</span></button>`;

      paginationControls.innerHTML = pagBtns;
      bindActionButtons();
      bindPaginationButtons();
    }

    function bindActionButtons() {
      tableBody.querySelectorAll('.viewBtn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id!;

          let order: Order;
          try {
            order = await getOrder(id);
          } catch (err: any) {
            showToast(err.message || 'Failed to load order details', 'error');
            return;
          }

          document.getElementById('viewOrderId')!.textContent = order.invoice;
          const statusBadge = document.getElementById('viewOrderStatus')!;
          statusBadge.textContent = order.status.replace(/_/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
          statusBadge.className = `inline-block px-3 py-1 rounded-full text-xs font-bold text-white ${getStatusBadgeClass(order.status)}`;
          document.getElementById('viewOrderCustomer')!.textContent = order.user_name || order.user_id;
          document.getElementById('viewOrderPaymentType')!.textContent = order.payment_type || '--';
          const itemsWrap = document.getElementById('viewOrderItems')!;
          if (order.items && order.items.length > 0) {
            itemsWrap.innerHTML = order.items
              .map((item) => `
                <div class="bg-white p-3 rounded-lg border border-stone-200">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-stone-600">${item.item_name}</span>
                    <span class="text-xs font-semibold text-primary">Qty ${item.qty}</span>
                  </div>
                  <p class="text-sm text-stone-700">${formatPrice(item.total_price)}</p>
                </div>
              `)
              .join('');
          } else {
            itemsWrap.innerHTML = '<p class="text-sm text-stone-500 italic">No item details found.</p>';
          }
          currentViewingOrder = order;
          document.getElementById('viewOrderNotes')!.textContent = order.notes || '--';

          // Detailed Cost Breakdown
          const itemsTotal = order.items ? order.items.reduce((sum: number, item: any) => sum + (item.total_price || 0), 0) : 0;
          const shippingPrice = order.shipping_price || 0;
          const serviceFee = order.service_fee || 0;
          const tax = order.tax || 0;
          const discount = order.discount || 0;
          const totalPrice = order.total_price || 0;
          const baseCalculated = itemsTotal + shippingPrice + serviceFee + tax - discount;
          const uniqueCode = totalPrice > baseCalculated ? (totalPrice - baseCalculated) : 0;

          document.getElementById('viewOrderSubtotal')!.textContent = formatPrice(itemsTotal);

          const shippingRow = document.getElementById('viewOrderShippingRow')!;
          const shippingLabel = document.getElementById('viewOrderShippingLabel')!;
          const shippingCostEl = document.getElementById('viewOrderShippingCost')!;
          if (shippingPrice > 0) {
            const courierName = order.shipping_name && order.shipping_name !== '-' ? order.shipping_name : 'Kurir';
            const courierService = order.shipping_service && order.shipping_service !== '-' ? ` (${order.shipping_service})` : '';
            shippingLabel.textContent = `Biaya Pengiriman (${courierName}${courierService})`;
            shippingCostEl.textContent = formatPrice(shippingPrice);
            shippingRow.classList.remove('hidden');
          } else {
            shippingLabel.textContent = 'Biaya Pengiriman';
            shippingCostEl.textContent = 'Gratis Ongkir (E-Book / Layanan)';
            shippingRow.classList.remove('hidden');
          }

          const serviceFeeRow = document.getElementById('viewOrderServiceFeeRow')!;
          if (serviceFee > 0) {
            serviceFeeRow.classList.remove('hidden');
            document.getElementById('viewOrderServiceFee')!.textContent = formatPrice(serviceFee);
          } else {
            serviceFeeRow.classList.add('hidden');
          }

          const taxRow = document.getElementById('viewOrderTaxRow')!;
          if (tax > 0) {
            taxRow.classList.remove('hidden');
            document.getElementById('viewOrderTax')!.textContent = formatPrice(tax);
          } else {
            taxRow.classList.add('hidden');
          }

          const discountRow = document.getElementById('viewOrderDiscountRow')!;
          if (discount > 0) {
            discountRow.classList.remove('hidden');
            document.getElementById('viewOrderDiscount')!.textContent = `-${formatPrice(discount)}`;
          } else {
            discountRow.classList.add('hidden');
          }

          const uniqueCodeRow = document.getElementById('viewOrderUniqueCodeRow')!;
          if (uniqueCode > 0) {
            uniqueCodeRow.classList.remove('hidden');
            document.getElementById('viewOrderUniqueCode')!.textContent = String(uniqueCode);
          } else {
            uniqueCodeRow.classList.add('hidden');
          }

          document.getElementById('viewOrderTotal')!.textContent = formatPrice(totalPrice);
          document.getElementById('viewOrderCreated')!.textContent = formatDateTimeWIB(order.created_at);
          document.getElementById('viewOrderUpdated')!.textContent = formatDateTimeWIB(order.updated_at);

          const adminConfirmBtn = document.getElementById('adminConfirmPaymentBtn') as HTMLButtonElement;
          const adminProcessBtn = document.getElementById('adminProcessOrderBtn') as HTMLButtonElement;
          const st = (order.status || '').toLowerCase();

          if (adminConfirmBtn) {
            if (st === 'pending' || st === 'waiting_confirmation') {
              adminConfirmBtn.classList.remove('hidden');
              adminConfirmBtn.disabled = false;
              adminConfirmBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">check_circle</span> Konfirmasi Pembayaran`;
            } else {
              adminConfirmBtn.classList.add('hidden');
            }
          }

          if (adminProcessBtn) {
            if (st === 'confirmed') {
              adminProcessBtn.classList.remove('hidden');
              adminProcessBtn.disabled = false;
              adminProcessBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">inventory_2</span> Proses Pesanan`;
            } else {
              adminProcessBtn.classList.add('hidden');
            }
          }

          const adminStatusWrapper = document.getElementById('adminStatusUpdateWrapper');
          const adminStatusDropdown = document.getElementById('adminStatusDropdown') as HTMLSelectElement;
          if (adminStatusWrapper && adminStatusDropdown) {
            if (['processed', 'shipped', 'delivered', 'completed'].includes(st)) {
              adminStatusWrapper.classList.remove('hidden');
              adminStatusDropdown.value = st;
            } else {
              adminStatusWrapper.classList.add('hidden');
            }
          }

          openModal('viewOrderModal');
        });
      });

      tableBody.querySelectorAll('.deleteBtn').forEach((btn) => {
        btn.addEventListener('click', () => {
          deleteTargetId = (btn as HTMLElement).dataset.id!;
          document.getElementById('deleteOrderId')!.textContent = (btn as HTMLElement).dataset.orderId || '';
          openModal('deleteModal');
        });
      });
    }

    function bindPaginationButtons() {
      paginationControls.querySelectorAll('.pagBtn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentPage = parseInt((btn as HTMLElement).dataset.page || '1', 10);
          renderTable();
        });
      });
    }

    document.getElementById('addOrderBtn')?.addEventListener('click', () => {
      addOrderForm.reset();
      isCustomerManual = false;
      if (custModeSelectBtn && custModeManualBtn) {
        custModeSelectBtn.className = 'px-3.5 py-1.5 rounded-lg bg-white text-primary shadow-xs transition-all cursor-pointer';
        custModeManualBtn.className = 'px-3.5 py-1.5 rounded-lg text-stone-500 hover:text-stone-800 transition-all cursor-pointer';
      }
      custSelectWrapper?.classList.remove('hidden');
      custManualWrapper?.classList.add('hidden');
      if (customerSelect) customerSelect.required = true;
      if (manualCustomerName) manualCustomerName.required = false;
      if (manualCustomerEmail) manualCustomerEmail.required = false;
      if (manualCustomerPhone) manualCustomerPhone.required = false;

      manualProvDropdown.clear();
      manualCityDropdown.clear();
      manualDistDropdown.clear();
      manualVillDropdown.clear();
      if (manualCustomerAddress) manualCustomerAddress.value = '';
      if (manualCustomerZipCode) manualCustomerZipCode.value = '';

      const shippingContainer = document.getElementById('shippingFieldsContainer');
      if (shippingContainer) shippingContainer.classList.add('hidden');

      const itemsList = document.getElementById('itemsList');
      if (itemsList) itemsList.innerHTML = '';
      
      const invoiceInput = document.getElementById('invoiceInput') as HTMLInputElement;
      if (invoiceInput) {
        invoiceInput.value = generateNextInvoice();
      }

      if (orderShippingPriceInput) orderShippingPriceInput.value = '0';
      if (orderDiscountInput) orderDiscountInput.value = '0';
      if (orderTaxRateInput) orderTaxRateInput.value = '0';
      if (orderTaxHidden) orderTaxHidden.value = '0';

      // Load settings default for tax percentage and service fee
      settingsApi.get().then(res => {
        if (res?.data) {
          const defaultTaxRate = res.data.tax_percentage !== undefined ? res.data.tax_percentage : (res.data.tax || 0);
          if (orderTaxRateInput) orderTaxRateInput.value = String(defaultTaxRate);
          if (orderServiceFeeInput) orderServiceFeeInput.value = String(res.data.service_fee || 0);
          syncAllItems();
        }
      }).catch(() => {});

      populateCustomerSelect();
      syncAllItems();
      openModal('addOrderModal');
      // Add first row automatically
      addItemRow();
    });

    // Event delegation for checkboxes and qty inputs
    document.getElementById('addItemBtn')?.addEventListener('click', addItemRow);

    saveOrderBtn?.addEventListener('click', async () => {
      const formData = new FormData(addOrderForm);
      const userId = isCustomerManual ? '' : String(formData.get('user_id') || '').trim();
      const customerName = isCustomerManual ? String(formData.get('customer_name') || '').trim() : '';
      const customerEmail = isCustomerManual ? String(formData.get('customer_email') || '').trim() : '';
      const customerPhone = isCustomerManual ? String(formData.get('customer_phone') || '').trim() : '';

      const manualStreet = manualCustomerAddress?.value.trim() || '';
      const manualProv = manualProvDropdown.getSelectedName();
      const manualCity = manualCityDropdown.getSelectedName();
      const manualDist = manualDistDropdown.getSelectedName();
      const manualVill = manualVillDropdown.getSelectedName();
      const manualZip = manualCustomerZipCode?.value.trim() || '';

      const addressParts = [
        manualStreet,
        manualVill ? `Kel. ${manualVill}` : '',
        manualDist ? `Kec. ${manualDist}` : '',
        manualCity,
        manualProv,
        manualZip
      ].filter(Boolean);
      const combinedAddress = addressParts.join(', ');

      const totalQty = parseInt(String(formData.get('total_qty') || '0'), 10);
      const totalPrice = parseInt(String(formData.get('total_price') || '0'), 10);

      // Validate items: cannot be empty or "Choose item..."
      let hasInvalidItem = false;
      let validItemsCount = 0;
      const rows = document.querySelectorAll('.item-row');
      rows.forEach(row => {
        const select = row.querySelector('.item-select') as HTMLSelectElement;
        if (!select || !select.value) {
          hasInvalidItem = true;
        } else {
          validItemsCount++;
        }
      });

      if (hasInvalidItem || validItemsCount === 0) {
        showToast('Silakan pilih produk atau layanan pada Order Items (tidak boleh "Choose item...")', 'error');
        return;
      }

      if (isCustomerManual) {
        if (!customerName || !customerEmail || !customerPhone) {
          showToast('Nama lengkap, Email, dan No. WhatsApp/HP customer wajib diisi', 'error');
          return;
        }
      } else {
        if (!userId) {
          showToast('Silakan pilih customer terdaftar', 'error');
          return;
        }
      }

      if (Number.isNaN(totalQty) || totalQty <= 0 || Number.isNaN(totalPrice) || totalPrice <= 0) {
        showToast('Silakan lengkapi item dan biaya pesanan dengan benar', 'error');
        return;
      }

      saveOrderBtn.disabled = true;
      saveOrderBtn.textContent = 'Saving...';

      try {
        const calculatedTax = Math.max(0, parseInt(String(formData.get('tax') || orderTaxHidden?.value || '0'), 10) || 0);
        const createdOrder = await createAdminOrder({
          invoice: String(formData.get('invoice') || '').trim(),
          user_id: userId,
          customer_name: customerName,
          customer_email: customerEmail,
          customer_phone: customerPhone,
          customer_address: combinedAddress || manualStreet,
          customer_province: manualProv,
          customer_city: manualCity,
          customer_district: manualDist,
          customer_village: manualVill,
          customer_zip_code: manualZip,
          items: String(formData.get('items') || '').trim(),
          notes: String(formData.get('notes') || '').trim(),
          total_qty: totalQty,
          total_weight: 0,
          total_price: totalPrice,
          payment_type: String(formData.get('payment_type') || 'Bank Transfer').trim(),
          status: 'pending',
          shipping_name: String(formData.get('shipping_name') || '').trim(),
          shipping_service: String(formData.get('shipping_service') || '').trim(),
          shipping_price: Math.max(0, parseInt(String(formData.get('shipping_price') || '0'), 10) || 0),
          tax: calculatedTax,
          service_fee: Math.max(0, parseInt(String(formData.get('service_fee') || '0'), 10) || 0),
          discount: Math.max(0, parseInt(String(formData.get('discount') || '0'), 10) || 0),
        });

        closeModalById('addOrderModal');
        showToast('Order berhasil dibuat & invoice telah dikirim ke email!');
        await loadOrders();

        // Redirect ke halaman khusus invoice
        const invParam = encodeURIComponent(createdOrder.invoice || createdOrder.id);
        window.location.href = `/invoice?inv=${invParam}`;
      } catch (err: any) {
        showToast(err.message || 'Failed to create order', 'error');
        saveOrderBtn.disabled = false;
        saveOrderBtn.textContent = 'Save Order';
      }
    });

    confirmDeleteBtn?.addEventListener('click', async () => {
      confirmDeleteBtn.disabled = true;
      confirmDeleteBtn.textContent = 'Deleting...';

      try {
        await deleteOrder(deleteTargetId);
        closeModalById('deleteModal');
        showToast('Order deleted successfully');
        await loadOrders();
      } catch (err: any) {
        showToast(err.message || 'Failed to delete order', 'error');
      } finally {
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = 'Delete';
      }
    });

    let searchTimeout: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        searchKeyword = searchInput.value.trim();
        currentPage = 1;
        loadOrders();
      }, 300);
    });

    statusFilter?.addEventListener('change', () => {
      selectedStatus = statusFilter.value;
      currentPage = 1;
      loadOrders();
    });

    const adminConfirmPaymentBtn = document.getElementById('adminConfirmPaymentBtn') as HTMLButtonElement;
    const adminProcessOrderBtn = document.getElementById('adminProcessOrderBtn') as HTMLButtonElement;

    adminConfirmPaymentBtn?.addEventListener('click', async () => {
      if (!currentViewingOrder) return;
      const originalText = adminConfirmPaymentBtn.innerHTML;
      adminConfirmPaymentBtn.innerHTML = `<span class="material-symbols-outlined animate-spin text-[18px]">sync</span> Memproses...`;
      adminConfirmPaymentBtn.disabled = true;

      try {
        await confirmAdminOrderPayment(currentViewingOrder.id);
        showToast('Pembayaran berhasil dikonfirmasi dan email invoice status "Lunas" telah dikirim!', 'success');
        currentViewingOrder.status = 'confirmed';
        const statusBadge = document.getElementById('viewOrderStatus')!;
        statusBadge.textContent = 'Confirmed';
        statusBadge.className = `inline-block px-3 py-1 rounded-full text-xs font-bold text-white ${getStatusBadgeClass('confirmed')}`;
        document.getElementById('viewOrderUpdated')!.textContent = formatDateTimeWIB(new Date().toISOString());
        adminConfirmPaymentBtn.classList.add('hidden');
        if (adminProcessOrderBtn) {
          adminProcessOrderBtn.classList.remove('hidden');
          adminProcessOrderBtn.disabled = false;
          adminProcessOrderBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">inventory_2</span> Proses Pesanan`;
        }
        await loadOrders();
      } catch (err: any) {
        showToast(err.message || 'Gagal konfirmasi pembayaran', 'error');
        adminConfirmPaymentBtn.innerHTML = originalText;
        adminConfirmPaymentBtn.disabled = false;
      }
    });

    adminProcessOrderBtn?.addEventListener('click', async () => {
      if (!currentViewingOrder) return;
      const originalText = adminProcessOrderBtn.innerHTML;
      adminProcessOrderBtn.innerHTML = `<span class="material-symbols-outlined animate-spin text-[18px]">sync</span> Memproses...`;
      adminProcessOrderBtn.disabled = true;

      try {
        await updateOrderStatus(currentViewingOrder.id, 'processed');
        showToast('Pesanan berhasil diproses dan email notifikasi status "Diproses" telah dikirim!', 'success');
        currentViewingOrder.status = 'processed';
        const statusBadge = document.getElementById('viewOrderStatus')!;
        statusBadge.textContent = 'Processed';
        statusBadge.className = `inline-block px-3 py-1 rounded-full text-xs font-bold text-white ${getStatusBadgeClass('processed')}`;
        document.getElementById('viewOrderUpdated')!.textContent = formatDateTimeWIB(new Date().toISOString());
        adminProcessOrderBtn.classList.add('hidden');
        const adminStatusWrapper = document.getElementById('adminStatusUpdateWrapper');
        const adminStatusDropdown = document.getElementById('adminStatusDropdown') as HTMLSelectElement;
        if (adminStatusWrapper && adminStatusDropdown) {
          adminStatusWrapper.classList.remove('hidden');
          adminStatusDropdown.value = 'processed';
        }
        await loadOrders();
      } catch (err: any) {
        showToast(err.message || 'Gagal memproses pesanan', 'error');
        adminProcessOrderBtn.innerHTML = originalText;
        adminProcessOrderBtn.disabled = false;
      }
    });

    const adminUpdateStatusBtn = document.getElementById('adminUpdateStatusBtn') as HTMLButtonElement;
    adminUpdateStatusBtn?.addEventListener('click', async () => {
      if (!currentViewingOrder) return;
      const adminStatusDropdown = document.getElementById('adminStatusDropdown') as HTMLSelectElement;
      if (!adminStatusDropdown) return;
      const newStatus = adminStatusDropdown.value;

      const originalHtml = adminUpdateStatusBtn.innerHTML;
      adminUpdateStatusBtn.innerHTML = `<span class="material-symbols-outlined animate-spin text-base">sync</span> Menyimpan...`;
      adminUpdateStatusBtn.disabled = true;

      try {
        await updateOrderStatus(currentViewingOrder.id, newStatus);
        showToast(`Status pesanan berhasil diubah menjadi "${newStatus.toUpperCase()}"!`, 'success');
        currentViewingOrder.status = newStatus;
        const statusBadge = document.getElementById('viewOrderStatus')!;
        statusBadge.textContent = newStatus.replace(/_/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
        statusBadge.className = `inline-block px-3 py-1 rounded-full text-xs font-bold text-white ${getStatusBadgeClass(newStatus)}`;
        document.getElementById('viewOrderUpdated')!.textContent = formatDateTimeWIB(new Date().toISOString());
        await loadOrders();
      } catch (err: any) {
        showToast(err.message || 'Gagal mengubah status pesanan', 'error');
      } finally {
        adminUpdateStatusBtn.innerHTML = originalHtml;
        adminUpdateStatusBtn.disabled = false;
      }
    });

    Promise.all([loadCustomers(), loadOrderItems(), loadOrders()]);
  </script>
</AdminLayout>
