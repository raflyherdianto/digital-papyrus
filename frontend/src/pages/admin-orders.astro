---
/**
 * Admin Orders Management Page
 * Route: /admin-orders
 * Manages customer orders and their statuses.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Orders Management | Digital Papyrus" activePage="orders">
  <div class="flex flex-col md:flex-row items-start md:items-baseline justify-between mb-6 md:mb-8 gap-4">
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-primary font-headline mb-2">Orders Management</h2>
      <p class="text-stone-500 font-body text-sm max-w-xl">View and manage all customer orders with real-time status tracking.</p>
    </div>
    <div class="flex gap-3 md:gap-4 w-full md:w-auto">
      <button id="addOrderBtn" class="flex-1 md:flex-none px-4 md:px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-xs md:text-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/10">
        <span class="material-symbols-outlined text-sm">add</span> <span class="hidden sm:inline">Add New Order</span>
      </button>
    </div>
  </div>

  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-6 border border-stone-200/20 shadow-sm mb-6 md:mb-8 flex flex-col md:flex-row flex-wrap items-start md:items-center gap-3 md:gap-4 justify-between">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4 flex-1 w-full md:w-auto">
      <div class="relative w-full sm:max-w-sm">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm">search</span>
        <input id="searchInput" class="w-full bg-surface-container py-2.5 pl-10 pr-4 rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-stone-400" placeholder="Search by invoice or customer..." type="text" />
      </div>
      <select id="statusFilter" class="bg-surface-container py-2.5 px-4 rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 transition-all text-stone-600">
        <option value="">All Status</option>
        <option value="pending">Pending</option>
        <option value="confirmed">Confirmed</option>
        <option value="shipped">Shipped</option>
        <option value="delivered">Delivered</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </div>
  </div>

  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-8 border border-stone-200/10 shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left min-w-[900px]">
        <thead>
          <tr class="text-stone-400 font-label text-[10px] uppercase tracking-widest border-b border-stone-200/30">
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Invoice</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Name</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Total Qty</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Total</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Status</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold">Date</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="ordersTableBody" class="text-sm font-body">
          <tr id="loadingRow">
            <td colspan="7" class="py-16 text-center">
              <div class="flex flex-col items-center gap-3">
                <span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span>
                <p class="text-stone-400 text-sm">Loading orders...</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-stone-200/20 pt-6 gap-4">
      <p id="paginationInfo" class="text-xs text-stone-400 font-medium">Loading...</p>
      <div id="paginationControls" class="flex gap-1.5"></div>
    </div>
  </div>

  <div id="toast" class="fixed bottom-6 right-6 z-[10000] hidden transform translate-y-4 opacity-0 transition-all duration-300">
    <div class="flex items-center gap-3 bg-stone-800 text-white px-5 py-3 rounded-xl shadow-2xl text-sm font-medium">
      <span id="toastIcon" class="material-symbols-outlined text-lg text-teal-400">check_circle</span>
      <span id="toastMsg">Operation successful</span>
    </div>
  </div>

  <div id="addOrderModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-2xl mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="addOrderModalContent">
      <div class="px-6 md:px-8 py-6 border-b border-stone-200/50 flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Add New Order</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="addOrderModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6 max-h-[60vh] overflow-y-auto">
        <form id="addOrderForm" class="space-y-4">
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Customer *</label>
            <select id="customerSelect" name="user_id" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
              <option value="">Loading customers...</option>
            </select>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Invoice Number</label>
              <input id="invoiceInput" name="invoice" type="text" readonly class="w-full bg-stone-100 py-2.5 px-4 rounded-xl text-sm border border-stone-200 outline-none transition-all cursor-not-allowed font-mono font-bold text-primary" placeholder="Generating..." />
              <p class="text-[10px] text-stone-400">Generated automatically (INV-YYYYMMDDXXX).</p>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Status *</label>
              <select name="status" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all font-medium">
                <option value="pending">Pending</option>
                <option value="confirmed">Confirmed</option>
                <option value="shipped">Shipped</option>
                <option value="delivered">Delivered</option>
                <option value="cancelled">Cancelled</option>
              </select>
            </div>
          </div>
          <input type="hidden" name="total_qty" value="0" />
          <input type="hidden" name="total_price" value="0" />
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Notes</label>
            <textarea name="notes" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" rows="3" placeholder="Optional notes for this order"></textarea>
          </div>
          <div class="space-y-5 pt-2 border-t border-stone-100">
            <div class="flex items-center justify-between">
              <label class="text-sm font-extrabold text-stone-700 uppercase tracking-wider flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">shopping_cart</span> Order Items *
              </label>
              <button type="button" id="addItemBtn" class="px-4 py-1.5 bg-primary text-white text-xs font-bold rounded-xl hover:opacity-90 transition-all flex items-center gap-1.5 shadow-md shadow-primary/20">
                <span class="material-symbols-outlined text-base">add</span> Add Item
              </button>
            </div>
            <div id="itemsList" class="space-y-3">
              <!-- Item rows will be injected here -->
            </div>
            <textarea name="items" id="itemsHidden" class="hidden"></textarea>
            <div class="rounded-2xl border-2 border-dashed border-stone-200 bg-stone-50/50 p-5 flex justify-between items-center">
              <div class="space-y-1.5">
                <p class="text-[10px] text-stone-400 uppercase font-bold tracking-widest">Items List</p>
                <p id="itemsSummary" class="text-sm font-medium text-stone-600 leading-relaxed italic">No items added.</p>
                <div class="flex items-center gap-4 pt-1">
                  <p class="text-[10px] text-stone-400 uppercase font-bold tracking-widest">Total Qty: <span id="summaryTotalQty" class="text-primary ml-1 text-xs">0</span></p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-[10px] text-stone-400 uppercase font-bold tracking-widest mb-1">Grand Total</p>
                <p id="estimatedTotal" class="text-xl font-black text-primary">Rp 0</p>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Payment Type</label>
              <input name="payment_type" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Bank Transfer" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Shipping Name</label>
              <input name="shipping_name" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="JNE" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Shipping Service</label>
              <input name="shipping_service" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="REG" />
            </div>
          </div>
        </form>
      </div>
      <div class="px-6 md:px-8 py-5 bg-surface-container flex items-center justify-end gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn px-5 py-2.5 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="addOrderModal">Cancel</button>
        <button id="saveOrderBtn" class="px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-sm hover:opacity-90 transition-all shadow-lg shadow-primary/10 disabled:opacity-50" type="button">Save Order</button>
      </div>
    </div>
  </div>

  <div id="viewOrderModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-2xl mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="viewOrderModalContent">
      <div class="px-6 md:px-8 py-6 border-b border-stone-200/50 flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Order Details</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="viewOrderModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6 space-y-5 max-h-[60vh] overflow-y-auto">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Order ID</p>
            <p id="viewOrderId" class="text-lg font-bold text-primary font-mono"></p>
          </div>
          <div>
            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Status</p>
            <div id="viewOrderStatus" class="inline-block px-3 py-1 rounded-full text-xs font-bold text-white bg-stone-500"></div>
          </div>
        </div>

        <div>
          <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-2">Customer Information</p>
          <div class="bg-surface-container rounded-lg p-4 space-y-2">
            <p><span class="text-stone-500">Name:</span> <span id="viewOrderCustomer" class="font-semibold text-primary"></span></p>
            <p><span class="text-stone-500">Payment Type:</span> <span id="viewOrderPaymentType" class="font-semibold text-primary"></span></p>
          </div>
        </div>

        <div>
          <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-2">Order Items</p>
          <div id="viewOrderItems" class="space-y-4"></div>
        </div>

        <div>
          <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-2">Order Notes</p>
          <div id="viewOrderNotes" class="bg-surface-container rounded-lg p-4 text-sm text-stone-600"></div>
        </div>

        <div class="border-t border-stone-200/20 pt-4">
          <div class="flex justify-between items-center">
            <span class="font-semibold text-stone-600">Total:</span>
            <span id="viewOrderTotal" class="text-xl font-bold text-tertiary"></span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 pt-4 border-t border-stone-200/20">
          <div>
            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Created</p>
            <p id="viewOrderCreated" class="text-sm font-medium text-stone-700"></p>
          </div>
          <div>
            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Updated</p>
            <p id="viewOrderUpdated" class="text-sm font-medium text-stone-700"></p>
          </div>
        </div>
      </div>
      <div class="px-6 md:px-8 py-5 bg-surface-container flex items-center justify-end gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn px-5 py-2.5 border border-stone-300 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="viewOrderModal">Close</button>
      </div>
    </div>
  </div>

  <div id="deleteModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-sm mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="deleteModalContent">
      <div class="p-6 md:p-8 text-center">
        <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-3xl text-red-500">delete_forever</span>
        </div>
        <h3 class="text-lg font-bold text-primary font-headline mb-2">Delete Order?</h3>
        <p class="text-sm text-stone-500">This action cannot be undone. Order "<span id="deleteOrderId" class="font-semibold text-stone-700"></span>" will be permanently removed.</p>
      </div>
      <div class="px-6 md:px-8 py-4 bg-surface-container flex items-center justify-center gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn flex-1 px-5 py-2.5 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="deleteModal">Cancel</button>
        <button id="confirmDeleteBtn" class="flex-1 px-5 py-2.5 bg-red-500 text-white font-bold rounded-xl text-sm hover:bg-red-600 transition-all disabled:opacity-50">Delete</button>
      </div>
    </div>
  </div>

  <script>
    import { createOrder, deleteOrder, getBooks, getOrder, getOrders, getServices, getUsers, isAuthenticated } from '../lib/api';
    import type { Book, Order as ApiOrder, Service, User } from '../lib/api';

    if (!isAuthenticated()) {
      window.location.href = '/admin-login';
    }

    type Order = ApiOrder;

    const tableBody = document.getElementById('ordersTableBody')!;
    const paginationInfo = document.getElementById('paginationInfo')!;
    const paginationControls = document.getElementById('paginationControls')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
    const customerSelect = document.getElementById('customerSelect') as HTMLSelectElement;
    const itemsHidden = document.getElementById('itemsHidden') as HTMLTextAreaElement;
    const addOrderForm = document.getElementById('addOrderForm') as HTMLFormElement;
    const saveOrderBtn = document.getElementById('saveOrderBtn') as HTMLButtonElement;
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn') as HTMLButtonElement;

    let allOrders: Order[] = [];
    let customers: User[] = [];
    let orderBooks: Book[] = [];
    let orderServices: Service[] = [];
    let currentPage = 1;
    const perPage = 10;
    let searchKeyword = '';
    let selectedStatus = '';
    let deleteTargetId = '';
    const modalIds = ['addOrderModal', 'viewOrderModal', 'deleteModal', 'editOrderModal'];

    document.querySelectorAll('#addOrderModal, #viewOrderModal, #deleteModal, #toast').forEach((el) => {
      document.body.appendChild(el);
    });

    document.querySelectorAll('.closeModalBtn').forEach((button) => {
      button.addEventListener('click', () => {
        const modalId = (button as HTMLElement).dataset.modal;
        if (modalId) closeModalById(modalId);
      });
    });

    modalIds.forEach((modalId) => {
      const modal = document.getElementById(modalId);
      if (!modal) return;

      modal.addEventListener('click', (event) => {
        if (event.target === modal) {
          closeModalById(modalId);
        }
      });
    });

    function formatDate(dateStr: string): string {
      if (!dateStr) return '--';
      return new Date(dateStr).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function formatPrice(price: number): string {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(price);
    }

    function escapeHtml(str: string): string {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getStatusBadgeClass(status: string): string {
      const classes: Record<string, string> = {
        pending: 'bg-yellow-500',
        confirmed: 'bg-blue-500',
        shipped: 'bg-purple-500',
        delivered: 'bg-green-500',
        cancelled: 'bg-red-500',
        completed: 'bg-green-500',
      };
      return classes[status] || 'bg-stone-500';
    }

    function showToast(msg: string, type: 'success' | 'error' = 'success') {
      const toast = document.getElementById('toast')!;
      const toastMsg = document.getElementById('toastMsg')!;
      const toastIcon = document.getElementById('toastIcon')!;
      toastMsg.textContent = msg;
      toastIcon.textContent = type === 'success' ? 'check_circle' : 'error';
      toastIcon.className = `material-symbols-outlined text-lg ${type === 'success' ? 'text-teal-400' : 'text-red-400'}`;
      toast.classList.remove('hidden', 'translate-y-4', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('translate-y-4', 'opacity-0');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3000);
    }

    function openModal(id: string) {
      const wrap = document.getElementById(id);
      const content = document.getElementById(`${id}Content`);
      if (!wrap || !content) return;
      wrap.classList.remove('hidden');
      setTimeout(() => {
        wrap.classList.remove('opacity-0');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
      }, 10);
    }

    function closeModalById(id: string) {
      const wrap = document.getElementById(id);
      const content = document.getElementById(`${id}Content`);
      if (!wrap || !content) return;
      wrap.classList.add('opacity-0');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
      setTimeout(() => wrap.classList.add('hidden'), 300);
    }

    function populateCustomerSelect() {
      if (!customerSelect) return;
      const options = customers.length
        ? customers.map((user) => `<option value="${user.id}">${user.name} (${user.email})</option>`).join('')
        : '<option value="">No customer available</option>';

      customerSelect.innerHTML = `<option value="">Select customer</option>${options}`;
    }
    
    function generateNextInvoice() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const day = String(now.getDate()).padStart(2, '0');
      const dateStr = `${year}${month}${day}`;
      const prefix = `INV-${dateStr}`;
      
      let maxSeq = 0;
      if (allOrders && allOrders.length > 0) {
        allOrders.forEach(o => {
          if (o.invoice && o.invoice.startsWith(prefix)) {
            const seqPart = o.invoice.substring(prefix.length);
            const seq = parseInt(seqPart, 10);
            if (!isNaN(seq) && seq > maxSeq) {
              maxSeq = seq;
            }
          }
        });
      }
      
      const nextSeq = maxSeq + 1;
      return `${prefix}${String(nextSeq).padStart(3, '0')}`;
    }

    function addItemRow() {
      const itemsList = document.getElementById('itemsList');
      if (!itemsList) return;

      const rowId = 'row_' + Math.random().toString(36).substr(2, 9);
      const row = document.createElement('div');
      row.id = rowId;
      row.className = 'item-row bg-surface border border-stone-200 rounded-xl p-4 space-y-4 shadow-sm';
      
      let options = '<option value="">Choose item...</option>';
      if (orderBooks.length > 0) {
        options += '<optgroup label="Books">';
        orderBooks.forEach(b => options += `<option value="book:${b.id}" data-price="${b.price}" data-title="${escapeHtml(b.title)}">${escapeHtml(b.title)} - ${formatPrice(b.price)}</option>`);
        options += '</optgroup>';
      }
      if (orderServices.length > 0) {
        options += '<optgroup label="Services">';
        orderServices.forEach(s => options += `<option value="service:${s.id}" data-price="${s.price}" data-title="${escapeHtml(s.title)}">${escapeHtml(s.title)} - ${formatPrice(s.price)}</option>`);
        options += '</optgroup>';
      }

      row.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="flex-1 space-y-3">
            <select class="item-select w-full bg-surface-container-low py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all font-medium">
              ${options}
            </select>
            <div class="qty-container hidden flex items-center gap-3">
              <label class="text-[11px] font-bold text-stone-500 uppercase tracking-wider">Quantity:</label>
              <input type="number" min="1" value="1" class="item-qty w-24 bg-surface-container-low py-2 px-3 rounded-xl text-sm border border-stone-200 focus:border-primary outline-none transition-all font-bold text-primary" />
            </div>
          </div>
          <button type="button" class="remove-item-btn text-stone-300 hover:text-red-500 transition-colors p-1 mt-1" title="Remove item">
            <span class="material-symbols-outlined text-xl">delete</span>
          </button>
        </div>
      `;

      itemsList.appendChild(row);

      const select = row.querySelector('.item-select') as HTMLSelectElement;
      const qtyInput = row.querySelector('.item-qty') as HTMLInputElement;
      const removeBtn = row.querySelector('.remove-item-btn') as HTMLButtonElement;
      const qtyContainer = row.querySelector('.qty-container') as HTMLElement;

      select.addEventListener('change', () => {
        const val = select.value;
        if (val.startsWith('book:')) {
          qtyContainer.classList.remove('hidden');
        } else {
          qtyContainer.classList.add('hidden');
          qtyInput.value = '1';
        }
        syncAllItems();
      });

      qtyInput.addEventListener('input', syncAllItems);
      removeBtn.addEventListener('click', () => {
        row.remove();
        syncAllItems();
      });

      syncAllItems();
    }

    function syncAllItems() {
      const rows = document.querySelectorAll('.item-row');
      const summaryTotalQty = document.getElementById('summaryTotalQty');
      const totalQtyInput = addOrderForm.querySelector('input[name="total_qty"]') as HTMLInputElement;
      const totalPriceInput = addOrderForm.querySelector('input[name="total_price"]') as HTMLInputElement;

      if (!itemsSummary || !estimatedTotal || !summaryTotalQty || !itemsHidden || !totalQtyInput || !totalPriceInput) return;

      let totalQty = 0;
      let totalPrice = 0;
      const itemStrings: string[] = [];

      rows.forEach(row => {
        const select = row.querySelector('.item-select') as HTMLSelectElement;
        const qtyInput = row.querySelector('.item-qty') as HTMLInputElement;
        const opt = select.selectedOptions[0];

        if (opt && opt.value) {
          const title = opt.dataset.title || '';
          const price = parseInt(opt.dataset.price || '0', 10);
          const qty = parseInt(qtyInput.value || '1', 10);
          
          totalQty += qty;
          totalPrice += (price * qty);
          itemStrings.push(`${title} x${qty}`);
        }
      });

      summaryTotalQty.textContent = String(totalQty);
      if (itemStrings.length === 0) {
        itemsSummary.textContent = 'No items added.';
        estimatedTotal.textContent = 'Rp 0';
        itemsHidden.value = '';
        totalQtyInput.value = '0';
        totalPriceInput.value = '0';
      } else {
        itemsSummary.textContent = itemStrings.join(', ');
        estimatedTotal.textContent = formatPrice(totalPrice);
        itemsHidden.value = itemStrings.join(', ');
        totalQtyInput.value = String(totalQty);
        totalPriceInput.value = String(totalPrice);
      }
    }

    async function loadCustomers() {
      try {
        const users = await getUsers();
        customers = users.filter((user) => user.role === 'customer' && user.is_active);
        populateCustomerSelect();
      } catch {
        customers = [];
        populateCustomerSelect();
      }
    }

    async function loadOrderItems() {
      try {
        const [booksResult, servicesResult] = await Promise.all([
          getBooks({ page: 1, per_page: 1000, status: 'published' }),
          getServices(false),
        ]);

        orderBooks = booksResult.books;
        orderServices = servicesResult.filter((service) => service.is_active);
      } catch {
        orderBooks = [];
        orderServices = [];
      }
    }

    async function loadOrders() {
      tableBody.innerHTML = `<tr><td colspan="7" class="py-16 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span><p class="text-stone-400 text-sm">Loading orders...</p></div></td></tr>`;

      try {
        const { orders } = await getOrders({
          page: 1,
          per_page: 1000,
          search: searchKeyword || undefined,
          status: selectedStatus || undefined,
        });

        allOrders = orders;
        currentPage = 1;
        renderTable();
      } catch (err: any) {
        tableBody.innerHTML = `<tr><td colspan="7" class="py-16 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-4xl text-red-300">error</span><p class="text-stone-500 text-sm">${err.message || 'Failed to load orders'}</p><button class="retryBtn text-primary font-bold text-sm mt-2 hover:underline">Retry</button></div></td></tr>`;
        tableBody.querySelector('.retryBtn')?.addEventListener('click', loadOrders);
      }
    }

    function renderTable() {
      const total = allOrders.length;
      const totalPages = Math.max(1, Math.ceil(total / perPage));
      if (currentPage > totalPages) currentPage = totalPages;
      const startIdx = (currentPage - 1) * perPage;
      const paged = allOrders.slice(startIdx, startIdx + perPage);

      if (paged.length === 0) {
        tableBody.innerHTML = `
          <tr><td colspan="7" class="py-16 text-center">
            <div class="flex flex-col items-center gap-3">
              <span class="material-symbols-outlined text-4xl text-stone-300">inbox</span>
              <p class="text-stone-400 text-sm">No orders found</p>
            </div>
          </td></tr>`;
        paginationInfo.textContent = total === 0 ? 'No items' : `Showing 0 of ${total.toLocaleString()} orders`;
        paginationControls.innerHTML = '';
        return;
      }

      tableBody.innerHTML = paged
        .map((order, idx) => {
          const borderCls = idx < paged.length - 1 ? 'border-b border-stone-200/10' : '';
          return `<tr class="group hover:bg-surface-container-low/50 transition-colors ${borderCls}" data-id="${order.id}">
            <td class="py-4 md:py-5 px-3 md:px-4">
              <p class="font-bold text-primary text-sm md:text-base font-mono">${order.invoice}</p>
            </td>
            <td class="py-4 md:py-5 px-3 md:px-4 text-stone-600 font-medium">${order.user_name || order.user_id}</td>
            <td class="py-4 md:py-5 px-3 md:px-4 text-stone-600 text-xs">${order.total_qty}</td>
            <td class="py-4 md:py-5 px-3 md:px-4 text-stone-600 font-semibold">${formatPrice(order.total_price)}</td>
            <td class="py-4 md:py-5 px-3 md:px-4">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold text-white ${getStatusBadgeClass(order.status)}">${order.status.charAt(0).toUpperCase() + order.status.slice(1)}</span>
            </td>
            <td class="py-4 md:py-5 px-3 md:px-4 font-medium text-stone-600 text-xs">${formatDate(order.created_at)}</td>
            <td class="py-4 md:py-5 px-3 md:px-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <button class="viewBtn w-8 h-8 rounded-lg flex items-center justify-center text-stone-500 hover:text-primary hover:bg-stone-200/50 transition-all" title="View" data-id="${order.id}">
                  <span class="material-symbols-outlined text-lg">visibility</span>
                </button>
                <button class="deleteBtn w-8 h-8 rounded-lg flex items-center justify-center text-stone-500 hover:text-error hover:bg-stone-200/50 transition-all" title="Delete" data-id="${order.id}" data-order-id="${order.invoice}">
                  <span class="material-symbols-outlined text-lg">delete</span>
                </button>
              </div>
            </td>
          </tr>`;
        })
        .join('');

      const start = startIdx + 1;
      const end = Math.min(startIdx + perPage, total);
      paginationInfo.textContent = `Showing ${start}-${end} of ${total.toLocaleString()} orders`;

      let pagBtns = '';
      pagBtns += `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors ${currentPage <= 1 ? 'opacity-30 pointer-events-none' : ''}" data-page="${currentPage - 1}" aria-label="Previous"><span class="material-symbols-outlined text-sm text-stone-400">chevron_left</span></button>`;

      for (let p = 1; p <= totalPages; p++) {
        if (totalPages > 5 && p > 3 && p < totalPages - 1 && Math.abs(p - currentPage) > 1) {
          if (p === 4) pagBtns += `<span class="w-9 h-9 flex items-center justify-center text-stone-400 text-xs tracking-wider">...</span>`;
          continue;
        }
        pagBtns += p === currentPage
          ? `<button class="w-9 h-9 rounded-lg flex items-center justify-center bg-primary text-white font-bold text-xs">${p}</button>`
          : `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors font-medium text-xs" data-page="${p}">${p}</button>`;
      }

      pagBtns += `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors ${currentPage >= totalPages ? 'opacity-30 pointer-events-none' : ''}" data-page="${currentPage + 1}" aria-label="Next"><span class="material-symbols-outlined text-sm text-stone-400">chevron_right</span></button>`;

      paginationControls.innerHTML = pagBtns;
      bindActionButtons();
      bindPaginationButtons();
    }

    function bindActionButtons() {
      tableBody.querySelectorAll('.viewBtn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id!;

          let order: Order;
          try {
            order = await getOrder(id);
          } catch (err: any) {
            showToast(err.message || 'Failed to load order details', 'error');
            return;
          }

          document.getElementById('viewOrderId')!.textContent = order.invoice;
          const statusBadge = document.getElementById('viewOrderStatus')!;
          statusBadge.textContent = order.status.charAt(0).toUpperCase() + order.status.slice(1);
          statusBadge.className = `inline-block px-3 py-1 rounded-full text-xs font-bold text-white ${getStatusBadgeClass(order.status)}`;
          document.getElementById('viewOrderCustomer')!.textContent = order.user_name || order.user_id;
          document.getElementById('viewOrderPaymentType')!.textContent = order.payment_type || '--';
          const itemsWrap = document.getElementById('viewOrderItems')!;
          if (order.items && order.items.length > 0) {
            itemsWrap.innerHTML = order.items
              .map((item) => `
                <div class="bg-white p-3 rounded-lg border border-stone-200">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-stone-600">${item.item_name}</span>
                    <span class="text-xs font-semibold text-primary">Qty ${item.qty}</span>
                  </div>
                  <p class="text-sm text-stone-700">${formatPrice(item.total_price)}</p>
                </div>
              `)
              .join('');
          } else {
            itemsWrap.innerHTML = '<p class="text-sm text-stone-500 italic">No item details found.</p>';
          }
          document.getElementById('viewOrderNotes')!.textContent = order.notes || '--';
          document.getElementById('viewOrderTotal')!.textContent = formatPrice(order.total_price);
          document.getElementById('viewOrderCreated')!.textContent = formatDate(order.created_at);
          document.getElementById('viewOrderUpdated')!.textContent = formatDate(order.updated_at);
          openModal('viewOrderModal');
        });
      });

      tableBody.querySelectorAll('.deleteBtn').forEach((btn) => {
        btn.addEventListener('click', () => {
          deleteTargetId = (btn as HTMLElement).dataset.id!;
          document.getElementById('deleteOrderId')!.textContent = (btn as HTMLElement).dataset.orderId || '';
          openModal('deleteModal');
        });
      });
    }

    function bindPaginationButtons() {
      paginationControls.querySelectorAll('.pagBtn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentPage = parseInt((btn as HTMLElement).dataset.page || '1', 10);
          renderTable();
        });
      });
    }

    document.getElementById('addOrderBtn')?.addEventListener('click', () => {
      addOrderForm.reset();
      const itemsList = document.getElementById('itemsList');
      if (itemsList) itemsList.innerHTML = '';
      
      const invoiceInput = document.getElementById('invoiceInput') as HTMLInputElement;
      if (invoiceInput) {
        invoiceInput.value = generateNextInvoice();
      }

      populateCustomerSelect();
      syncAllItems();
      openModal('addOrderModal');
      // Add first row automatically
      addItemRow();
    });

    // Event delegation for checkboxes and qty inputs
    document.getElementById('addItemBtn')?.addEventListener('click', addItemRow);

    saveOrderBtn?.addEventListener('click', async () => {
      const formData = new FormData(addOrderForm);
      const userId = String(formData.get('user_id') || '').trim();
      const totalQty = parseInt(String(formData.get('total_qty') || '0'), 10);
      const totalPrice = parseInt(String(formData.get('total_price') || '0'), 10);
      const status = String(formData.get('status') || 'pending').trim().toLowerCase();

      if (!userId || Number.isNaN(totalQty) || totalQty <= 0 || Number.isNaN(totalPrice) || totalPrice <= 0 || !status) {
        showToast('Please fill in all required fields', 'error');
        return;
      }

      saveOrderBtn.disabled = true;
      saveOrderBtn.textContent = 'Saving...';

      try {
        await createOrder({
          invoice: String(formData.get('invoice') || '').trim(),
          user_id: userId,
          items: String(formData.get('items') || '').trim(),
          notes: String(formData.get('notes') || '').trim(),
          total_qty: totalQty,
          total_weight: 0,
          total_price: totalPrice,
          payment_type: String(formData.get('payment_type') || '').trim(),
          status,
          shipping_name: String(formData.get('shipping_name') || '').trim(),
          shipping_service: String(formData.get('shipping_service') || '').trim(),
          shipping_price: 0,
        });

        closeModalById('addOrderModal');
        showToast('Order created successfully');
        await loadOrders();
      } catch (err: any) {
        showToast(err.message || 'Failed to create order', 'error');
      } finally {
        saveOrderBtn.disabled = false;
        saveOrderBtn.textContent = 'Save Order';
      }
    });

    confirmDeleteBtn?.addEventListener('click', async () => {
      confirmDeleteBtn.disabled = true;
      confirmDeleteBtn.textContent = 'Deleting...';

      try {
        await deleteOrder(deleteTargetId);
        closeModalById('deleteModal');
        showToast('Order deleted successfully');
        await loadOrders();
      } catch (err: any) {
        showToast(err.message || 'Failed to delete order', 'error');
      } finally {
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = 'Delete';
      }
    });

    let searchTimeout: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        searchKeyword = searchInput.value.trim();
        currentPage = 1;
        loadOrders();
      }, 300);
    });

    statusFilter?.addEventListener('change', () => {
      selectedStatus = statusFilter.value;
      currentPage = 1;
      loadOrders();
    });

    Promise.all([loadCustomers(), loadOrderItems(), loadOrders()]);
  </script>
</AdminLayout>
