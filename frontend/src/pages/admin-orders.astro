          <span class="material-symbols-outlined text-3xl text-red-500">delete_forever</span>
        </div>
        <h3 class="text-lg font-bold text-primary font-headline mb-2">Delete Order?</h3>
        <p class="text-sm text-stone-500">This action cannot be undone. Order "<span id="deleteOrderId" class="font-semibold text-stone-700"></span>" will be permanently removed.</p>
