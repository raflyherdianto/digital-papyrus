---
/**
 * Admin Accounting Page
 * Route: /admin-accounting
 * Matches exact admin-catalog.astro table, search input, filter styles, and mobile-first responsive architecture.
 * Features detailed IFRS / PSAK standard Income Statement (Laporan Laba Rugi Komprehensif).
 */
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Accounting & Financials | Digital Papyrus" activePage="accounting">
  <!-- Header -->
  <div class="flex flex-col md:flex-row items-start md:items-baseline justify-between mb-8 md:mb-12 gap-4">
    <div>
      <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight text-primary font-headline mb-2">Financial Accounting & Ledger</h2>
      <p class="text-stone-500 font-body text-sm md:text-lg max-w-xl">Pembukuan Transaksi, Laporan Laba Rugi Komprehensif, dan Rekapitulasi Arus Kas Digital Papyrus.</p>
    </div>
    <div class="flex gap-3 md:gap-4 w-full md:w-auto">
      <button
        id="exportCsvBtn"
        type="button"
        class="flex-1 md:flex-none px-4 md:px-6 py-3 bg-primary text-white font-bold rounded-xl text-xs md:text-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/10 cursor-pointer"
      >
        <span class="material-symbols-outlined text-sm">file_download</span> <span>Export CSV</span>
      </button>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-8 md:mb-12">
    <!-- Gross Revenue -->
    <div class="bg-primary p-4 sm:p-6 md:p-8 rounded-xl text-on-primary-container relative overflow-hidden group shadow-sm">
      <div class="absolute -right-4 -bottom-4 opacity-10 transition-transform group-hover:scale-110">
        <span class="material-symbols-outlined text-8xl">payments</span>
      </div>
      <p class="text-xs font-label uppercase tracking-widest text-on-primary-container/80 mb-3 md:mb-4">Gross Revenue</p>
      <h3 id="statGrossRevenue" class="text-2xl md:text-3xl font-headline font-extrabold text-white">Rp 0</h3>
      <div class="mt-3 md:mt-4 flex items-center gap-2 text-xs text-primary-fixed-dim">
        <span class="material-symbols-outlined text-sm">account_balance</span>
        <span>Total transaksi kotor</span>
      </div>
    </div>

    <!-- Net Operating Profit -->
    <div class="bg-surface-container-low p-4 sm:p-6 md:p-8 rounded-xl hover:bg-surface-container-high transition-colors shadow-sm">
      <p class="text-xs font-label uppercase tracking-widest text-stone-500 mb-3 md:mb-4">Net Operating Profit</p>
      <h3 id="statNetOperatingProfit" class="text-2xl md:text-3xl font-headline font-extrabold text-emerald-700">Rp 0</h3>
      <div class="mt-3 md:mt-4 flex items-center gap-2 text-xs text-emerald-700">
        <span class="material-symbols-outlined text-sm">trending_up</span>
        <span>Laba bersih operasional (setelah COGS & beban)</span>
      </div>
    </div>

    <!-- Paid Transactions -->
    <div class="bg-surface-container-low p-4 sm:p-6 md:p-8 rounded-xl hover:bg-surface-container-high transition-colors shadow-sm">
      <p class="text-xs font-label uppercase tracking-widest text-stone-500 mb-3 md:mb-4">Paid Orders</p>
      <h3 id="statPaidOrders" class="text-2xl md:text-3xl font-headline font-extrabold text-primary">0</h3>
      <div class="mt-3 md:mt-4 flex items-center gap-2 text-xs text-indigo-600">
        <span class="material-symbols-outlined text-sm">receipt_long</span>
        <span>Pesanan berhasil</span>
      </div>
    </div>

    <!-- Avg Order Value -->
    <div class="bg-tertiary-fixed p-4 sm:p-6 md:p-8 rounded-xl text-on-tertiary-fixed relative overflow-hidden group shadow-sm">
      <div class="absolute -right-4 -bottom-4 opacity-10 transition-transform group-hover:scale-110">
        <span class="material-symbols-outlined text-8xl">analytics</span>
      </div>
      <p class="text-xs font-label uppercase tracking-widest text-on-tertiary-fixed-variant mb-3 md:mb-4">Avg. Order Value (AOV)</p>
      <h3 id="statAov" class="text-2xl md:text-3xl font-headline font-extrabold text-tertiary">Rp 0</h3>
      <div class="mt-3 md:mt-4 flex items-center gap-2 text-xs font-medium text-tertiary">
        <span class="material-symbols-outlined text-sm">trending_up</span>
        <span>Rata-rata pendapatan per order</span>
      </div>
    </div>
  </div>

  <!-- Filters and Search (Matching admin-catalog.astro) -->
  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-6 border border-stone-200/20 shadow-sm mb-6 md:mb-8 flex flex-col md:flex-row flex-wrap items-start md:items-center gap-3 md:gap-4 justify-between">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4 flex-1 w-full md:w-auto">
      <div class="relative w-full sm:max-w-sm">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm">search</span>
        <input
          id="searchInput"
          class="w-full bg-surface-container py-2.5 pl-10 pr-4 rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-stone-400"
          placeholder="Cari Invoice, Pelanggan, atau Item..."
          type="text"
        />
      </div>
      <div class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
        <select id="statusFilter" class="bg-surface-container py-2.5 pl-3 pr-8 cursor-pointer rounded-xl text-xs md:text-sm border-none focus:ring-2 focus:ring-primary/20 text-stone-600 outline-none">
          <option value="">Semua Status</option>
          <option value="confirmed">Confirmed</option>
          <option value="shipped">Shipped</option>
          <option value="delivered">Delivered</option>
          <option value="completed">Completed</option>
          <option value="pending">Pending</option>
          <option value="cancelled">Cancelled</option>
        </select>
        <select id="periodFilter" class="bg-surface-container py-2.5 pl-3 pr-8 cursor-pointer rounded-xl text-xs md:text-sm border-none focus:ring-2 focus:ring-primary/20 text-stone-600 outline-none">
          <option value="all">Semua Waktu</option>
          <option value="this_month">Bulan Ini</option>
          <option value="last_month">Bulan Lalu</option>
          <option value="this_year">Tahun Ini</option>
          <option value="custom">Range Tanggal Custom</option>
        </select>
        <div id="customDateRangeContainer" class="hidden flex items-center gap-1.5 bg-surface-container px-3 py-1.5 rounded-xl border-none text-xs text-stone-600">
          <span class="material-symbols-outlined text-sm text-stone-400">calendar_today</span>
          <input id="startDateInput" type="date" title="Tanggal Mulai" class="bg-transparent border-none text-xs text-stone-700 outline-none cursor-pointer" />
          <span class="text-stone-400 font-bold">s/d</span>
          <input id="endDateInput" type="date" title="Tanggal Akhir" class="bg-transparent border-none text-xs text-stone-700 outline-none cursor-pointer" />
        </div>
      </div>
    </div>
  </div>

  <!-- Main Accounting Content Section -->
  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-8 border border-stone-200/10 shadow-sm w-full max-w-full min-w-0 overflow-hidden">
    <!-- Tabs Header -->
    <div class="flex flex-wrap items-center justify-between border-b border-stone-200/20 pb-4 md:pb-6 mb-6 md:mb-8 gap-4">
      <div class="flex items-center gap-6">
        <button
          id="tabLedgerBtn"
          type="button"
          class="pb-2 font-headline font-bold text-sm md:text-base text-primary border-b-2 border-primary transition-colors flex items-center gap-2 cursor-pointer"
        >
          <span class="material-symbols-outlined text-lg">list_alt</span>
          Jurnal Umum
        </button>
        <button
          id="tabIncomeBtn"
          type="button"
          class="pb-2 font-headline font-bold text-sm md:text-base text-stone-400 border-b-2 border-transparent hover:text-primary transition-colors flex items-center gap-2 cursor-pointer"
        >
          <span class="material-symbols-outlined text-lg">stacked_bar_chart</span>
          Laporan Laba Rugi Komprehensif
        </button>
      </div>
    </div>

    <!-- Tab 1: General Ledger Table -->
    <div id="ledgerTabContent" class="block w-full max-w-full min-w-0 overflow-hidden">
      <div class="table-responsive-container overflow-x-auto w-full max-w-full block">
        <table class="w-full text-left min-w-[900px] border-collapse">
          <thead>
            <tr class="text-stone-400 font-label text-[10px] uppercase tracking-widest border-b border-stone-200/30">
              <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Invoice & Tanggal</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Pelanggan</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Detail Item</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold text-right whitespace-nowrap">Subtotal</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold text-right whitespace-nowrap">Pajak & Layanan</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold text-right whitespace-nowrap">Ongkir</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold text-right whitespace-nowrap">Diskon</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold text-right whitespace-nowrap">Total Bersih</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold text-center whitespace-nowrap">Status</th>
            </tr>
          </thead>
          <tbody id="ledgerTableBody" class="text-sm font-body divide-y divide-stone-100">
            <tr>
              <td colspan="9" class="py-16 text-center">
                <div class="flex flex-col items-center gap-3">
                  <span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span>
                  <p class="text-stone-400 text-sm">Memuat data pembukuan...</p>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-stone-200/20 pt-6 gap-4">
        <p id="paginationInfo" class="text-xs text-stone-400 font-medium">Loading...</p>
        <div id="paginationControls" class="flex gap-1.5"></div>
      </div>
    </div>

    <!-- Tab 2: Detailed Income Statement Breakdown -->
    <div id="incomeTabContent" class="hidden py-4 md:py-6 space-y-8">
      <!-- Corporate Income Statement Document Card -->
      <div class="max-w-4xl mx-auto bg-surface-container-low p-6 md:p-10 rounded-2xl border border-stone-200/20 shadow-sm space-y-8">
        <!-- Statement Header -->
        <div class="border-b-2 border-stone-300 pb-6 text-center space-y-1">
          <h3 class="text-xl md:text-2xl font-black text-primary font-headline tracking-tight">DIGITAL PAPYRUS PLATFORM</h3>
          <p class="text-xs md:text-sm font-label font-bold text-stone-500 uppercase tracking-widest">LAPORAN LABA RUGI KOMPREHENSIF (STATEMENT OF PROFIT OR LOSS)</p>
          <p id="incomePeriodLabel" class="text-xs font-semibold text-stone-600">Periode: Semua Waktu</p>
          <p class="text-[11px] text-stone-400 font-mono">(Disajikan dalam Rupiah - IDR)</p>
        </div>

        <!-- 1. PENDAPATAN OPERASIONAL KOTOR (GROSS REVENUE) -->
        <div class="space-y-3">
          <div class="flex items-center justify-between border-b border-stone-300 pb-1.5">
            <h4 class="text-xs md:text-sm font-headline font-black text-primary uppercase tracking-wider">1. PENDAPATAN OPERASIONAL KOTOR (GROSS REVENUE)</h4>
            <span class="text-[11px] font-mono font-bold text-stone-400">AKUN 4-1000</span>
          </div>
          <div class="space-y-2 pl-4 text-xs md:text-sm font-body">
            <div class="flex justify-between text-stone-700 py-1 hover:bg-stone-200/30 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Penjualan Katalog Buku (Book Sales Revenue)</span>
              <span id="incBookRevenue" class="font-mono font-semibold text-primary">Rp 0</span>
            </div>
            <div class="flex justify-between text-stone-700 py-1 hover:bg-stone-200/30 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Jasa Penerbitan & Paket Layanan (Publishing & Service)</span>
              <span id="incServiceRevenue" class="font-mono font-semibold text-primary">Rp 0</span>
            </div>
            <div class="flex justify-between text-stone-700 py-1 hover:bg-stone-200/30 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Pendapatan Ongkos Kirim Terkumpul (Shipping Collection)</span>
              <span id="incShippingRevenue" class="font-mono font-semibold text-primary">Rp 0</span>
            </div>
            <div class="flex justify-between text-stone-700 py-1 hover:bg-stone-200/30 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Biaya Layanan & Admin Platform (Platform Service Fee)</span>
              <span id="incTaxFeeRevenue" class="font-mono font-semibold text-primary">Rp 0</span>
            </div>
          </div>
          <div class="flex justify-between font-extrabold text-xs md:text-sm text-primary pt-3 border-t border-stone-300 bg-stone-200/40 px-3 py-2 rounded-lg font-headline">
            <span>TOTAL PENDAPATAN PENJUALAN KOTOR (GROSS SALES)</span>
            <span id="incTotalGross" class="font-mono">Rp 0</span>
          </div>
        </div>

        <!-- 2. POTONGAN & PENYESUAIAN PENJUALAN (SALES DEDUCTIONS) -->
        <div class="space-y-3">
          <div class="flex items-center justify-between border-b border-stone-300 pb-1.5">
            <h4 class="text-xs md:text-sm font-headline font-black text-rose-700 uppercase tracking-wider">2. POTONGAN PENJUALAN & PROMO (SALES DEDUCTIONS)</h4>
            <span class="text-[11px] font-mono font-bold text-stone-400">AKUN 4-2000</span>
          </div>
          <div class="space-y-2 pl-4 text-xs md:text-sm font-body">
            <div class="flex justify-between text-rose-700 py-1 hover:bg-rose-50/50 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Diskon & Promo Penjualan (Customer Discounts)</span>
              <span id="incDiscounts" class="font-mono font-semibold">- Rp 0</span>
            </div>
          </div>
          <div class="flex justify-between font-extrabold text-xs md:text-sm text-rose-800 pt-3 border-t border-stone-300 bg-rose-50 px-3 py-2 rounded-lg font-headline">
            <span>TOTAL POTONGAN PENJUALAN</span>
            <span id="incTotalDeductions" class="font-mono">- Rp 0</span>
          </div>
        </div>

        <!-- 3. PENDAPATAN PENJUALAN BERSIH (NET REVENUE) -->
        <div class="flex justify-between items-center p-4 bg-primary text-white rounded-xl font-headline shadow-sm">
          <div>
            <span class="text-[10px] font-label font-bold uppercase tracking-widest text-primary-fixed-dim block">TOTAL 3</span>
            <span class="text-sm md:text-base font-extrabold">PENDAPATAN PENJUALAN BERSIH (NET REVENUE)</span>
          </div>
          <span id="incNetRevenue" class="text-lg md:text-xl font-black font-mono">Rp 0</span>
        </div>

        <!-- 4. HARGA POKOK PENJUALAN / BEBAN LANGSUNG (COGS & DIRECT EXPENSES) -->
        <div class="space-y-3">
          <div class="flex items-center justify-between border-b border-stone-300 pb-1.5">
            <h4 class="text-xs md:text-sm font-headline font-black text-amber-800 uppercase tracking-wider">4. BEBAN LANGSUNG & BEBAN EKSPEDISI (COGS)</h4>
            <span class="text-[11px] font-mono font-bold text-stone-400">AKUN 5-1000</span>
          </div>
          <div class="space-y-2 pl-4 text-xs md:text-sm font-body">
            <div class="flex justify-between text-amber-900 py-1 hover:bg-amber-50/50 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> Estimasi Biaya Cetak & Produksi Buku (Printing COGS 40%)</span>
              <span id="incPrintingCogs" class="font-mono font-semibold">- Rp 0</span>
            </div>
            <div class="flex justify-between text-amber-900 py-1 hover:bg-amber-50/50 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> Beban Royalti Penulis Buku (Author Royalty Expenses 10%)</span>
              <span id="incRoyaltyCogs" class="font-mono font-semibold">- Rp 0</span>
            </div>
            <div class="flex justify-between text-amber-900 py-1 hover:bg-amber-50/50 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> Beban Modal Jasa Penerbitan (Service Base COGS 30%)</span>
              <span id="incServiceCogs" class="font-mono font-semibold">- Rp 0</span>
            </div>
            <div class="flex justify-between text-amber-900 py-1 hover:bg-amber-50/50 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> Biaya Pengiriman ke Kurir Ekspedisi (Logistics Outflow)</span>
              <span id="incShippingOutflow" class="font-mono font-semibold">- Rp 0</span>
            </div>
          </div>
          <div class="flex justify-between font-extrabold text-xs md:text-sm text-amber-950 pt-3 border-t border-stone-300 bg-amber-50/70 px-3 py-2 rounded-lg font-headline">
            <span>TOTAL BEBAN LANGSUNG (TOTAL COGS)</span>
            <span id="incTotalCogs" class="font-mono">- Rp 0</span>
          </div>
        </div>

        <!-- 5. LABA KOTOR OPERASIONAL (GROSS PROFIT) -->
        <div class="flex justify-between items-center p-4 bg-surface-container-high border border-stone-300 rounded-xl font-headline">
          <div>
            <span class="text-[10px] font-label font-bold uppercase tracking-widest text-stone-500 block">TOTAL 5</span>
            <span class="text-sm md:text-base font-extrabold text-primary">LABA KOTOR OPERASIONAL (GROSS PROFIT)</span>
          </div>
          <span id="incGrossProfit" class="text-lg md:text-xl font-black font-mono text-primary">Rp 0</span>
        </div>

        <!-- 6. PAJAK & KEWAJIBAN PEMERINTAH (TAX EXPENSES) -->
        <div class="space-y-3">
          <div class="flex items-center justify-between border-b border-stone-300 pb-1.5">
            <h4 class="text-xs md:text-sm font-headline font-black text-stone-700 uppercase tracking-wider">6. BEBAN PAJAK & PERIZINAN (TAXES)</h4>
            <span class="text-[11px] font-mono font-bold text-stone-400">AKUN 6-1000</span>
          </div>
          <div class="space-y-2 pl-4 text-xs md:text-sm font-body">
            <div class="flex justify-between text-stone-700 py-1 hover:bg-stone-200/30 px-2 rounded-lg">
              <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-stone-500"></span> Estimasi PPN & Pajak Terkumpul (PPN Tax)</span>
              <span id="incTaxExpense" class="font-mono font-semibold text-stone-800">Rp 0</span>
            </div>
          </div>
        </div>

        <!-- 7. LABA BERSIH OPERASIONAL (NET OPERATING INCOME) -->
        <div class="p-5 bg-tertiary-fixed text-on-tertiary-fixed rounded-2xl shadow-md border border-tertiary flex flex-col md:flex-row justify-between items-start md:items-center gap-4 font-headline">
          <div>
            <span class="text-[10px] font-label font-bold uppercase tracking-widest text-on-tertiary-fixed-variant block">HASIL AKHIR BERSIH</span>
            <span class="text-base md:text-lg font-black tracking-tight">LABA BERSIH OPERASIONAL (NET OPERATING PROFIT)</span>
          </div>
          <span id="incNetIncome" class="text-2xl md:text-3xl font-black font-mono text-tertiary">Rp 0</span>
        </div>
      </div>

      <!-- Financial Ratios & Metric Breakdown Cards -->
      <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-surface-container-low p-5 rounded-xl border border-stone-200/20 text-center space-y-1">
          <span class="text-[10px] font-label uppercase tracking-widest text-stone-400 font-bold">Gross Margin %</span>
          <p id="ratioGrossMargin" class="text-xl md:text-2xl font-black font-headline text-primary">0%</p>
          <p class="text-[11px] text-stone-500">Efisiensi laba kotor penjualan</p>
        </div>

        <div class="bg-surface-container-low p-5 rounded-xl border border-stone-200/20 text-center space-y-1">
          <span class="text-[10px] font-label uppercase tracking-widest text-stone-400 font-bold">Net Profit Margin %</span>
          <p id="ratioNetMargin" class="text-xl md:text-2xl font-black font-headline text-teal-700">0%</p>
          <p class="text-[11px] text-stone-500">Persentase laba bersih operasional</p>
        </div>

        <div class="bg-surface-container-low p-5 rounded-xl border border-stone-200/20 text-center space-y-1">
          <span class="text-[10px] font-label uppercase tracking-widest text-stone-400 font-bold">Success Completion Rate</span>
          <p id="ratioCompletionRate" class="text-xl md:text-2xl font-black font-headline text-indigo-700">0%</p>
          <p class="text-[11px] text-stone-500">Rasio pesanan dikonfirmasi / sukses</p>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { getOrders, isAuthenticated } from '../lib/api';
  import type { Order } from '../lib/api';

  if (!isAuthenticated()) {
    window.location.href = '/admin-login';
  }

  // State
  let rawOrders: Order[] = [];
  let filteredOrders: Order[] = [];
  let currentPage = 1;
  const perPage = 10;

  // DOM Elements
  const tableBody = document.getElementById('ledgerTableBody')!;
  const paginationInfo = document.getElementById('paginationInfo')!;
  const paginationControls = document.getElementById('paginationControls')!;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
  const periodFilter = document.getElementById('periodFilter') as HTMLSelectElement;
  const customDateRangeContainer = document.getElementById('customDateRangeContainer')!;
  const startDateInput = document.getElementById('startDateInput') as HTMLInputElement;
  const endDateInput = document.getElementById('endDateInput') as HTMLInputElement;
  const exportCsvBtn = document.getElementById('exportCsvBtn')!;

  const tabLedgerBtn = document.getElementById('tabLedgerBtn')!;
  const tabIncomeBtn = document.getElementById('tabIncomeBtn')!;
  const ledgerTabContent = document.getElementById('ledgerTabContent')!;
  const incomeTabContent = document.getElementById('incomeTabContent')!;

  // KPI elements
  const statGrossRevenue = document.getElementById('statGrossRevenue')!;
  const statNetOperatingProfit = document.getElementById('statNetOperatingProfit')!;
  const statPaidOrders = document.getElementById('statPaidOrders')!;
  const statAov = document.getElementById('statAov')!;

  // Detailed Income Statement elements
  const incBookRevenue = document.getElementById('incBookRevenue')!;
  const incServiceRevenue = document.getElementById('incServiceRevenue')!;
  const incShippingRevenue = document.getElementById('incShippingRevenue')!;
  const incTaxFeeRevenue = document.getElementById('incTaxFeeRevenue')!;
  const incTotalGross = document.getElementById('incTotalGross')!;
  const incDiscounts = document.getElementById('incDiscounts')!;
  const incCancelledAllowance = document.getElementById('incCancelledAllowance')!;
  const incTotalDeductions = document.getElementById('incTotalDeductions')!;
  const incNetRevenue = document.getElementById('incNetRevenue')!;
  const incShippingOutflow = document.getElementById('incShippingOutflow')!;
  const incPrintingCogs = document.getElementById('incPrintingCogs')!;
  const incRoyaltyCogs = document.getElementById('incRoyaltyCogs')!;
  const incServiceCogs = document.getElementById('incServiceCogs')!;
  const incTotalCogs = document.getElementById('incTotalCogs')!;
  const incGrossProfit = document.getElementById('incGrossProfit')!;
  const incTaxExpense = document.getElementById('incTaxExpense')!;
  const incNetIncome = document.getElementById('incNetIncome')!;
  const incomePeriodLabel = document.getElementById('incomePeriodLabel')!;

  // Financial Ratio elements
  const ratioGrossMargin = document.getElementById('ratioGrossMargin')!;
  const ratioNetMargin = document.getElementById('ratioNetMargin')!;
  const ratioCompletionRate = document.getElementById('ratioCompletionRate')!;

  function formatRp(val: number): string {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
  }

  function formatDate(dateStr: string): string {
    if (!dateStr) return '--';
    const d = new Date(dateStr);
    return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function getStatusBadge(status: string): string {
    const s = (status || '').toLowerCase();
    const colors: Record<string, string> = {
      completed: 'bg-teal-100 text-teal-800 border-teal-200',
      delivered: 'bg-teal-100 text-teal-800 border-teal-200',
      shipped: 'bg-indigo-100 text-indigo-800 border-indigo-200',
      confirmed: 'bg-blue-100 text-blue-800 border-blue-200',
      pending: 'bg-amber-100 text-amber-800 border-amber-200',
      cancelled: 'bg-rose-100 text-rose-800 border-rose-200',
    };
    const cls = colors[s] || 'bg-stone-100 text-stone-600 border-stone-200';
    return `<span class="px-2.5 py-1 rounded-full text-xs font-bold border capitalize ${cls}">${status || 'unknown'}</span>`;
  }

  // ─── Fetch Data ───────────────────────────────────────────────────────
  async function fetchOrders() {
    try {
      tableBody.innerHTML = `
        <tr>
          <td colspan="9" class="py-16 text-center">
            <div class="flex flex-col items-center gap-3">
              <span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span>
              <p class="text-stone-400 text-sm">Memuat data pembukuan...</p>
            </div>
          </td>
        </tr>`;

      const { orders } = await getOrders({ page: 1, per_page: 2000 });
      rawOrders = orders;
      applyFilters();
    } catch (err: any) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="9" class="py-16 text-center">
            <div class="flex flex-col items-center gap-2 text-rose-500">
              <span class="material-symbols-outlined text-4xl">error</span>
              <p class="font-bold text-xs">Gagal memuat data keuangan: ${err.message || 'Error'}</p>
            </div>
          </td>
        </tr>`;
    }
  }

  // ─── Filter Logic ──────────────────────────────────────────────────────
  function formatDateForInput(d: Date): string {
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }

  function formatDateIndo(dateStr: string): string {
    if (!dateStr) return '';
    const parts = dateStr.split('-');
    if (parts.length !== 3) return dateStr;
    const dateObj = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
    return dateObj.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function toggleCustomDateContainer() {
    if (periodFilter.value === 'custom') {
      customDateRangeContainer.classList.remove('hidden');
      customDateRangeContainer.classList.add('flex');
    } else {
      customDateRangeContainer.classList.add('hidden');
      customDateRangeContainer.classList.remove('flex');
    }
  }

  function updateDateInputsFromPreset() {
    const period = periodFilter.value;
    const now = new Date();
    const currentYear = now.getFullYear();
    const currentMonth = now.getMonth();

    toggleCustomDateContainer();

    if (period === 'all') {
      startDateInput.value = '';
      endDateInput.value = '';
    } else if (period === 'this_month') {
      const firstDay = new Date(currentYear, currentMonth, 1);
      startDateInput.value = formatDateForInput(firstDay);
      endDateInput.value = formatDateForInput(now);
    } else if (period === 'last_month') {
      const firstDayLastMonth = new Date(currentYear, currentMonth - 1, 1);
      const lastDayLastMonth = new Date(currentYear, currentMonth, 0);
      startDateInput.value = formatDateForInput(firstDayLastMonth);
      endDateInput.value = formatDateForInput(lastDayLastMonth);
    } else if (period === 'this_year') {
      const firstDayYear = new Date(currentYear, 0, 1);
      const lastDayYear = new Date(currentYear, 11, 31);
      startDateInput.value = formatDateForInput(firstDayYear);
      endDateInput.value = formatDateForInput(lastDayYear);
    }
  }

  function applyFilters() {
    const search = (searchInput.value || '').toLowerCase().trim();
    const status = (statusFilter.value || '').toLowerCase().trim();
    const startDateVal = startDateInput.value;
    const endDateVal = endDateInput.value;

    filteredOrders = rawOrders.filter(o => {
      const matchSearch = !search ||
        (o.invoice || '').toLowerCase().includes(search) ||
        (o.user_name || '').toLowerCase().includes(search);

      const matchStatus = !status || (o.status || '').toLowerCase() === status;

      let matchPeriod = true;
      if (o.created_at) {
        const od = new Date(o.created_at);
        if (startDateVal) {
          const start = new Date(startDateVal + 'T00:00:00');
          if (od < start) matchPeriod = false;
        }
        if (endDateVal) {
          const end = new Date(endDateVal + 'T23:59:59');
          if (od > end) matchPeriod = false;
        }
      }

      return matchSearch && matchStatus && matchPeriod;
    });

    currentPage = 1;
    calculateFinancials();
    renderLedgerTable();
  }

  // ─── Detailed Financial Calculations (IFRS / PSAK Standard) ─────────────
  function calculateFinancials() {
    let grossTotal = 0;
    let netTotal = 0;
    let paidCount = 0;
    let totalTaxFee = 0;
    let totalDiscounts = 0;
    let totalShippingCollected = 0;
    let totalShippingOutflow = 0;
    let totalCancelledValue = 0;
    let totalBookRev = 0;
    let totalServiceRev = 0;
    let totalPrintingCogs = 0;
    let totalRoyaltyCogs = 0;
    let totalServiceCogs = 0;

    const totalOrdersCount = filteredOrders.length;

    filteredOrders.forEach(o => {
      const isCancelled = (o.status || '').toLowerCase() === 'cancelled';
      const orderTotal = o.total_price || 0;
      const orderTaxFee = (o.tax || 0) + (o.service_fee || 0);
      const orderDisc = o.discount || 0;
      const orderShipping = o.shipping_price || 0;
      const actualShipping = o.actual_shipping_cost || orderShipping;

      if (isCancelled) {
        totalCancelledValue += orderTotal;
      } else {
        paidCount++;
        const orderGross = orderTotal + orderDisc;
        grossTotal += orderGross;
        netTotal += orderTotal;

        totalTaxFee += orderTaxFee;
        totalDiscounts += orderDisc;
        totalShippingCollected += orderShipping;
        totalShippingOutflow += actualShipping;

        if (o.items && o.items.length > 0) {
          o.items.forEach(it => {
            const itemTotal = it.total_price || 0;
            if (it.item_type === 'service') {
              totalServiceRev += itemTotal;
              totalServiceCogs += Math.round(itemTotal * 0.30);
            } else {
              totalBookRev += itemTotal;
              totalPrintingCogs += Math.round(itemTotal * 0.40);
              totalRoyaltyCogs += Math.round(itemTotal * 0.10);
            }
          });
        } else {
          const netItems = Math.max(0, orderTotal + orderDisc - orderShipping - orderTaxFee);
          totalBookRev += netItems;
          totalPrintingCogs += Math.round(netItems * 0.40);
          totalRoyaltyCogs += Math.round(netItems * 0.10);
        }
      }
    });

    const aov = paidCount > 0 ? Math.round(netTotal / paidCount) : 0;

    // Dynamic COGS & Shipping Outflow from Database
    const shippingOutflow = totalShippingOutflow;
    const printingCogs = totalPrintingCogs;
    const royaltyCogs = totalRoyaltyCogs;
    const serviceCogs = totalServiceCogs;
    const totalCogs = shippingOutflow + printingCogs + royaltyCogs + serviceCogs;

    // 100% Guaranteed Consistent Accounting Logic:
    const netRevenue = netTotal;
    const totalGrossSales = netRevenue + totalDiscounts;
    const totalDeductions = totalDiscounts;
    const grossProfit = netRevenue - totalCogs;
    const taxExpense = totalTaxFee;
    const netOperatingIncome = grossProfit - taxExpense;

    // Update KPI Cards
    statGrossRevenue.textContent = formatRp(grossTotal);
    statNetOperatingProfit.textContent = formatRp(netOperatingIncome);
    statPaidOrders.textContent = paidCount.toLocaleString('id-ID');
    statAov.textContent = formatRp(aov);

    // Update Detailed Income Statement
    incBookRevenue.textContent = formatRp(totalBookRev);
    incServiceRevenue.textContent = formatRp(totalServiceRev);
    incShippingRevenue.textContent = formatRp(totalShippingCollected);
    incTaxFeeRevenue.textContent = formatRp(totalTaxFee);
    incTotalGross.textContent = formatRp(totalGrossSales);

    incDiscounts.textContent = `- ${formatRp(totalDiscounts)}`;
    incTotalDeductions.textContent = `- ${formatRp(totalDeductions)}`;
    incNetRevenue.textContent = formatRp(netRevenue);

    incPrintingCogs.textContent = `- ${formatRp(printingCogs)}`;
    incRoyaltyCogs.textContent = `- ${formatRp(royaltyCogs)}`;
    incServiceCogs.textContent = `- ${formatRp(serviceCogs)}`;
    incShippingOutflow.textContent = `- ${formatRp(shippingOutflow)}`;
    incTotalCogs.textContent = `- ${formatRp(totalCogs)}`;

    incGrossProfit.textContent = formatRp(grossProfit);
    incTaxExpense.textContent = formatRp(taxExpense);
    incNetIncome.textContent = formatRp(netOperatingIncome);

    const startStr = startDateInput.value ? formatDateIndo(startDateInput.value) : '';
    const endStr = endDateInput.value ? formatDateIndo(endDateInput.value) : '';

    if (startStr && endStr) {
      incomePeriodLabel.textContent = `Periode: ${startStr} s/d ${endStr}`;
    } else if (startStr) {
      incomePeriodLabel.textContent = `Periode: Sejak ${startStr}`;
    } else if (endStr) {
      incomePeriodLabel.textContent = `Periode: s/d ${endStr}`;
    } else {
      incomePeriodLabel.textContent = 'Periode: Semua Waktu';
    }

    // Ratios
    const grossMarginPct = netRevenue > 0 ? ((grossProfit / netRevenue) * 100).toFixed(1) : '0';
    const netMarginPct = netRevenue > 0 ? ((netOperatingIncome / netRevenue) * 100).toFixed(1) : '0';
    const completionRatePct = totalOrdersCount > 0 ? ((paidCount / totalOrdersCount) * 100).toFixed(1) : '0';

    ratioGrossMargin.textContent = `${grossMarginPct}%`;
    ratioNetMargin.textContent = `${netMarginPct}%`;
    ratioCompletionRate.textContent = `${completionRatePct}%`;
  }

  // ─── Render Ledger Table ─────────────────────────────────────────────
  function renderLedgerTable() {
    const total = filteredOrders.length;
    const totalPages = Math.max(1, Math.ceil(total / perPage));
    if (currentPage > totalPages) currentPage = totalPages;
    const startIdx = (currentPage - 1) * perPage;
    const paged = filteredOrders.slice(startIdx, startIdx + perPage);

    if (paged.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="9" class="py-12 text-center text-stone-400">
            Tidak ada transaksi ditemukan.
          </td>
        </tr>`;
      paginationInfo.textContent = 'Showing 0 of 0 entries';
      paginationControls.innerHTML = '';
      return;
    }

    tableBody.innerHTML = paged.map(o => {
      const itemsText = (o.items && o.items.length > 0)
        ? o.items.map(it => `${it.item_name} (x${it.qty})`).join(', ')
        : (o.notes || 'Detail item');

      const taxFee = (o.tax || 0) + (o.service_fee || 0);
      const subtotal = o.total_price - taxFee - (o.shipping_price || 0) + (o.discount || 0);
      const netTotal = o.total_price - (o.discount || 0);

      return `
        <tr class="hover:bg-surface-container-low transition-colors">
          <td class="py-3.5 px-3 md:px-4 font-mono text-xs font-bold text-primary whitespace-nowrap">
            <div>${o.invoice || o.id}</div>
            <div class="text-[11px] font-normal text-stone-400 font-body mt-0.5">${formatDate(o.created_at as any)}</div>
          </td>
          <td class="py-3.5 px-3 md:px-4 font-medium text-stone-800 whitespace-nowrap">
            ${o.user_name || 'Customer'}
          </td>
          <td class="py-3.5 px-3 md:px-4 max-w-[200px] text-xs text-stone-600 truncate whitespace-nowrap" title="${itemsText}">
            ${itemsText}
          </td>
          <td class="py-3.5 px-3 md:px-4 text-right font-medium text-stone-700 whitespace-nowrap">${formatRp(subtotal > 0 ? subtotal : o.total_price)}</td>
          <td class="py-3.5 px-3 md:px-4 text-right text-stone-500 whitespace-nowrap">${formatRp(taxFee)}</td>
          <td class="py-3.5 px-3 md:px-4 text-right text-stone-500 whitespace-nowrap">${formatRp(o.shipping_price || 0)}</td>
          <td class="py-3.5 px-3 md:px-4 text-right text-rose-600 whitespace-nowrap">${o.discount ? `- ${formatRp(o.discount)}` : 'Rp 0'}</td>
          <td class="py-3.5 px-3 md:px-4 text-right font-bold text-primary whitespace-nowrap">${formatRp(netTotal)}</td>
          <td class="py-3.5 px-3 md:px-4 text-center whitespace-nowrap">${getStatusBadge(o.status)}</td>
        </tr>`;
    }).join('');

    paginationInfo.textContent = `Showing ${startIdx + 1} to ${Math.min(startIdx + perPage, total)} of ${total} entries`;

    // Render Pagination Controls matching admin-catalog.astro
    let pagesHtml = '';
    pagesHtml += `<button class="pageBtn w-8 h-8 rounded-lg flex items-center justify-center text-sm font-medium transition-colors ${currentPage === 1 ? 'text-stone-300 pointer-events-none' : 'text-stone-600 hover:bg-stone-100'}" data-page="${currentPage - 1}"><span class="material-symbols-outlined text-sm">chevron_left</span></button>`;

    for (let p = 1; p <= totalPages; p++) {
      if (p === currentPage) {
        pagesHtml += `<button class="w-8 h-8 rounded-lg bg-primary text-white text-sm font-bold shadow-sm">${p}</button>`;
      } else if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
        pagesHtml += `<button class="pageBtn w-8 h-8 rounded-lg text-stone-600 hover:bg-stone-100 text-sm font-medium transition-colors" data-page="${p}">${p}</button>`;
      } else if (p === currentPage - 2 || p === currentPage + 2) {
        pagesHtml += `<span class="w-8 h-8 flex items-center justify-center text-stone-400 text-sm">...</span>`;
      }
    }

    pagesHtml += `<button class="pageBtn w-8 h-8 rounded-lg flex items-center justify-center text-sm font-medium transition-colors ${currentPage === totalPages ? 'text-stone-300 pointer-events-none' : 'text-stone-600 hover:bg-stone-100'}" data-page="${currentPage + 1}"><span class="material-symbols-outlined text-sm">chevron_right</span></button>`;

    paginationControls.innerHTML = pagesHtml;

    paginationControls.querySelectorAll('.pageBtn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const targetPage = parseInt((e.currentTarget as HTMLElement).dataset.page || '1', 10);
        if (targetPage >= 1 && targetPage <= totalPages) {
          currentPage = targetPage;
          renderLedgerTable();
        }
      });
    });
  }

  // ─── Export CSV ────────────────────────────────────────────────────────
  function exportCSV() {
    if (filteredOrders.length === 0) {
      alert('Tidak ada data transaksi untuk di-export.');
      return;
    }

    const headers = ['Invoice', 'Tanggal', 'Pelanggan', 'Detail Item', 'Subtotal (IDR)', 'Pajak & Layanan (IDR)', 'Ongkir (IDR)', 'Diskon (IDR)', 'Total Bersih (IDR)', 'Status'];

    const rows = filteredOrders.map(o => {
      const itemsText = (o.items && o.items.length > 0)
        ? o.items.map(it => `${it.item_name} (x${it.qty})`).join('; ')
        : (o.notes || '');

      const taxFee = (o.tax || 0) + (o.service_fee || 0);
      const subtotal = o.total_price - taxFee - (o.shipping_price || 0) + (o.discount || 0);
      const netTotal = o.total_price - (o.discount || 0);
      const dateStr = formatDate(o.created_at as any);

      return [
        `"${(o.invoice || o.id).replace(/"/g, '""')}"`,
        `"${dateStr.replace(/"/g, '""')}"`,
        `"${(o.user_name || '').replace(/"/g, '""')}"`,
        `"${itemsText.replace(/"/g, '""')}"`,
        subtotal > 0 ? subtotal : o.total_price,
        taxFee,
        o.shipping_price || 0,
        o.discount || 0,
        netTotal,
        `"${(o.status || '').replace(/"/g, '""')}"`
      ].join(',');
    });

    const csvContent = '\uFEFF' + [headers.join(','), ...rows].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);

    const dateSuffix = new Date().toISOString().slice(0, 10);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', `digital_papyrus_accounting_report_${dateSuffix}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }

  // ─── Event Listeners ──────────────────────────────────────────────────
  searchInput.addEventListener('input', applyFilters);
  statusFilter.addEventListener('change', applyFilters);
  periodFilter.addEventListener('change', () => {
    updateDateInputsFromPreset();
    applyFilters();
  });
  startDateInput.addEventListener('click', () => {
    try { startDateInput.showPicker(); } catch {}
  });
  startDateInput.addEventListener('change', () => {
    periodFilter.value = 'custom';
    applyFilters();
  });
  endDateInput.addEventListener('click', () => {
    try { endDateInput.showPicker(); } catch {}
  });
  endDateInput.addEventListener('change', () => {
    periodFilter.value = 'custom';
    applyFilters();
  });
  exportCsvBtn.addEventListener('click', exportCSV);

  tabLedgerBtn.addEventListener('click', () => {
    tabLedgerBtn.classList.add('text-primary', 'border-primary');
    tabLedgerBtn.classList.remove('text-stone-400', 'border-transparent');
    tabIncomeBtn.classList.remove('text-primary', 'border-primary');
    tabIncomeBtn.classList.add('text-stone-400', 'border-transparent');

    ledgerTabContent.classList.remove('hidden');
    incomeTabContent.classList.add('hidden');
  });

  tabIncomeBtn.addEventListener('click', () => {
    tabIncomeBtn.classList.add('text-primary', 'border-primary');
    tabIncomeBtn.classList.remove('text-stone-400', 'border-transparent');
    tabLedgerBtn.classList.remove('text-primary', 'border-primary');
    tabLedgerBtn.classList.add('text-stone-400', 'border-transparent');

    incomeTabContent.classList.remove('hidden');
    ledgerTabContent.classList.add('hidden');
  });

  // Init
  fetchOrders();
</script>
