---
/**
 * 404 Page — Not Found
 * Route: /404
 * Rendered when user navigates to an unregistered route.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Halaman Tidak Ditemukan | Digital Papyrus" description="Halaman yang Anda cari tidak ditemukan.">
  <div class="min-h-[70vh] flex items-center justify-center px-4 md:px-8 py-16 md:py-24">
    <div class="max-w-2xl w-full text-center">
      <!-- 404 Visual -->
      <div class="flex items-center justify-center mb-6">
        <span class="text-8xl sm:text-9xl md:text-[11rem] font-headline font-black text-stone-300 dark:text-stone-700 select-none tracking-tight leading-none">
          404
        </span>
      </div>

      <!-- Text Information -->
      <div class="space-y-4 mb-10">
        <h1 class="font-headline text-2xl md:text-4xl font-extrabold text-primary tracking-tight">
          Halaman Tidak Ditemukan
        </h1>
        <p class="text-sm md:text-base text-on-surface-variant max-w-md mx-auto leading-relaxed">
          Maaf, halaman atau tautan naskah yang Anda tuju tidak ditemukan, telah dipindahkan, atau alamat URL yang dimasukkan salah.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <a
          href="/"
          class="px-6 py-3 bg-primary text-on-primary rounded-xl font-bold text-sm md:text-base hover:bg-primary/90 transition-all flex items-center gap-2 shadow-lg shadow-primary/20 active:scale-95"
        >
          <span class="material-symbols-outlined text-lg">home</span>
          Kembali ke Beranda
        </a>
        <a
          href="/katalog"
          class="px-6 py-3 bg-surface-container border border-outline-variant/30 text-primary rounded-xl font-bold text-sm md:text-base hover:bg-surface-container-high transition-all flex items-center gap-2 active:scale-95"
        >
          <span class="material-symbols-outlined text-lg">explore</span>
          Jelajahi Katalog
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
