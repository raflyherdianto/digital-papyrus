  <script>
    import { getBooks, getBook, createBook, updateBook, deleteBook, formatRupiah, isAuthenticated, getCategories, uploadImage, validateBook } from '../lib/api';
    import type { Book, BookFilter } from '../lib/api';

    // ─── Auth guard ──────────────────────────────────────────────
    if (!isAuthenticated()) {
      window.location.href = '/admin-login';
    }

    // ─── State ───────────────────────────────────────────────────
    let currentPage = 1;
    const perPage = 10;
    let currentFilter: BookFilter = { page: currentPage, per_page: perPage };
    let deleteTargetId = '';

    // ─── DOM References ──────────────────────────────────────────
    const tableBody = document.getElementById('catalogTableBody')!;
    const paginationInfo = document.getElementById('paginationInfo')!;
    const paginationControls = document.getElementById('paginationControls')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;

    // ─── Teleport modals ─────────────────────────────────────────
    document.querySelectorAll('#addBookModal, #editBookModal, #viewBookModal, #deleteModal, #approveSuccessModal, #rejectSuccessModal, #toast').forEach(el => {
      document.body.appendChild(el);
    });

    // Bind validation approve/reject actions
    const approveBtn = document.getElementById('viewBookApproveBtn') as HTMLButtonElement;
    const rejectBtn = document.getElementById('viewBookRejectBtn') as HTMLButtonElement;
    if (approveBtn && rejectBtn) {
      approveBtn.addEventListener('click', async () => {
        const id = approveBtn.dataset.id!;
        const notes = (document.getElementById('viewBookNotes') as HTMLTextAreaElement).value;
        approveBtn.disabled = true;
        rejectBtn.disabled = true;
        try {
          await validateBook(id, 'approved', notes);
          closeModalById('viewBookModal');
          openModal('approveSuccessModal');
          loadCatalog();
        } catch (err: any) {
          showToast(err.message || 'Failed to approve book', 'error');
        } finally {
          approveBtn.disabled = false;
          rejectBtn.disabled = false;
        }
      });

      rejectBtn.addEventListener('click', async () => {
        const id = rejectBtn.dataset.id!;
        const notes = (document.getElementById('viewBookNotes') as HTMLTextAreaElement).value;
        approveBtn.disabled = true;
        rejectBtn.disabled = true;
        try {
          await validateBook(id, 'rejected', notes);
          closeModalById('viewBookModal');
          openModal('rejectSuccessModal');
          loadCatalog();
        } catch (err: any) {
          showToast(err.message || 'Failed to reject book', 'error');
        } finally {
          approveBtn.disabled = false;
          rejectBtn.disabled = false;
        }
      });
    }

    // ─── Helpers ─────────────────────────────────────────────────
    function getStatusClasses(status: string) {
      switch (status) {
        case 'published': return { badge: 'bg-teal-100 text-teal-800', dot: 'bg-teal-600', label: 'Published' };
        case 'draft': return { badge: 'bg-orange-100 text-orange-800', dot: 'bg-orange-600', label: 'Draft' };
        case 'archived': return { badge: 'bg-stone-200 text-stone-600', dot: 'bg-stone-400', label: 'Archived' };
        default: return { badge: 'bg-stone-200 text-stone-600', dot: 'bg-stone-400', label: status };
      }
    }

    function getStockClasses(stock: number) {
      if (stock > 10) return 'text-teal-700 bg-teal-50';
      if (stock > 0) return 'text-orange-700 bg-orange-50';
      return 'text-stone-500 bg-stone-100';
    }

    function formatDate(dateStr: string) {
      return new Date(dateStr).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    // ─── Modal Error ─────────────────────────────────────────────
    const ERROR_CODE_LABELS: Record<string, string> = {
      VALIDATION_FAILED: 'Terdapat kesalahan pada input berikut:',
      BAD_REQUEST: 'Permintaan tidak valid. Periksa input berikut:',
      INTERNAL_ERROR: 'Terjadi kesalahan pada server. Silakan coba lagi atau hubungi admin.',
      UNAUTHORIZED: 'Sesi Anda telah berakhir. Silakan login ulang.',
      FORBIDDEN: 'Anda tidak memiliki akses untuk tindakan ini.',
      NOT_FOUND: 'Data yang diminta tidak ditemukan.',
    };

    function showModalError(alertBox: HTMLElement, err: any, defaultMsg: string) {
      alertBox.classList.remove('hidden');

      const errorCode: string = err?.error?.code || '';
      const codeLabel = ERROR_CODE_LABELS[errorCode] || '';
      const headline = err.message || defaultMsg;

      // If there are per-field details, show them as a list
      if (err.error?.details && Object.keys(err.error.details).length > 0) {
        const FIELD_LABELS: Record<string, string> = {
          title: 'Judul Buku',
          author: 'Penulis',
          price: 'Harga',
          stock: 'Stok',
          status: 'Status',
          rating: 'Rating',
          isbn: 'ISBN',
        };
        const issues = Object.entries(err.error.details as Record<string, string>)
          .map(([k, v]) => `<li><b>${FIELD_LABELS[k] || k}</b>: ${v}</li>`)
          .join('');
        alertBox.innerHTML = `<p class="font-bold mb-1">${codeLabel || headline}</p><ul class="list-disc pl-5 space-y-0.5">${issues}</ul>`;
      } else if (errorCode === 'INTERNAL_ERROR') {
        // Server error — show friendly message, hide raw code
        alertBox.innerHTML = `<p class="font-bold">${codeLabel}</p><p class="text-xs mt-1 text-red-500 opacity-70">Detail: ${headline}</p>`;
      } else {
        alertBox.innerHTML = `<p class="font-bold">${codeLabel || headline}</p>`;
      }
    }

    // ─── Toast ───────────────────────────────────────────────────
    function showToast(msg: string, type: 'success' | 'error' = 'success') {
      const toast = document.getElementById('toast')!;
      const toastMsg = document.getElementById('toastMsg')!;
      const toastIcon = document.getElementById('toastIcon')!;
      toastMsg.textContent = msg;
      toastIcon.textContent = type === 'success' ? 'check_circle' : 'error';
      toastIcon.className = `material-symbols-outlined text-lg ${type === 'success' ? 'text-teal-400' : 'text-red-400'}`;
      toast.classList.remove('hidden', 'translate-y-4', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('translate-y-4', 'opacity-0');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3000);
    }

    // ─── Modal Logic ─────────────────────────────────────────────
    function openModal(id: string) {
      const wrap = document.getElementById(id);
      const content = document.getElementById(id + 'Content');
      if (!wrap || !content) return;
      wrap.classList.remove('hidden');
      setTimeout(() => {
        wrap.classList.remove('opacity-0');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
      }, 10);
    }

    function closeModalById(id: string) {
      const wrap = document.getElementById(id);
      const content = document.getElementById(id + 'Content');
      if (!wrap || !content) return;
      wrap.classList.add('opacity-0');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
      setTimeout(() => wrap.classList.add('hidden'), 300);
    }

    // Close buttons
    document.querySelectorAll('.closeModalBtn').forEach(btn => {
      btn.addEventListener('click', () => {
        const modalId = (btn as HTMLElement).dataset.modal;
        if (modalId) closeModalById(modalId);
      });
    });

    // Close on backdrop click
    ['addBookModal', 'editBookModal', 'viewBookModal', 'deleteModal'].forEach(id => {
      document.getElementById(id)?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).id === id) closeModalById(id);
      });
    });

    // ─── Render Table ────────────────────────────────────────────
    function renderTable(books: Book[], total: number, page: number, totalPages: number) {
      if (books.length === 0) {
        tableBody.innerHTML = `
          <tr><td colspan="7" class="py-16 text-center">
            <div class="flex flex-col items-center gap-3">
              <span class="material-symbols-outlined text-4xl text-stone-300">inbox</span>
              <p class="text-stone-400 text-sm">No books found</p>
            </div>
          </td></tr>`;
        paginationInfo.textContent = 'No items';
        paginationControls.innerHTML = '';
        return;
      }

      const rows = books.map((book, i) => {
        const st = getStatusClasses(book.status);
        const stockCls = getStockClasses(book.stock);
        const borderCls = i < books.length - 1 ? 'border-b border-stone-200/10' : '';

        const valStatus = book.validation_status || '';
        let valBadge = '';
        if (book.status === 'draft') {
          if (valStatus === 'pending') {
            valBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-100 text-amber-800 border border-amber-200 mt-1">Pending Validation</span>`;
          } else if (valStatus === 'approved') {
            valBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold bg-green-100 text-green-800 border border-green-200 mt-1">Approved</span>`;
          } else if (valStatus === 'rejected') {
            valBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold bg-red-100 text-red-800 border border-red-200 mt-1">Rejected</span>`;
          }
        }

        return `<tr class="group hover:bg-surface-container-low/50 transition-colors ${borderCls}" data-id="${book.id}">
          <td class="py-3.5 md:py-4 px-2.5 lg:px-4">
            <div class="flex items-center gap-2.5 lg:gap-3">
              <div class="w-8 h-11 lg:w-9 lg:h-12 bg-stone-200 rounded-md overflow-hidden flex-shrink-0 shadow-sm border border-stone-200/50">
                ${book.image_url
                  ? `<img alt="Cover ${book.title}" class="w-full h-full object-cover" src="${book.image_url}" loading="lazy" />`
                  : `<div class="w-full h-full flex items-center justify-center"><span class="material-symbols-outlined text-stone-400 text-base">text_snippet</span></div>`}
              </div>
              <div class="min-w-0 max-w-[140px] md:max-w-[180px] lg:max-w-[200px] xl:max-w-xs">
                <p class="font-bold text-primary text-xs md:text-sm truncate" title="${book.title}">${book.title}</p>
                <p class="text-stone-400 text-[10px] mt-0.5 tracking-wider truncate">ISBN: ${book.isbn || 'Belum Terbit'}</p>
                ${valBadge ? `<div class="mt-0.5">${valBadge}</div>` : ''}
              </div>
            </div>
          </td>
          <td class="py-3.5 md:py-4 px-2.5 lg:px-4 whitespace-nowrap">
            <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full text-[10px] lg:text-[11px] font-bold leading-none bg-surface-container text-primary whitespace-nowrap">${book.badge || 'Regular'}</span>
          </td>
          <td class="py-3.5 md:py-4 px-2.5 lg:px-4 whitespace-nowrap lg:whitespace-normal">
            <div class="truncate max-w-[90px] lg:max-w-[130px] font-medium text-stone-600 text-xs md:text-sm" title="${book.author}">${book.author}</div>
          </td>
          <td class="py-3.5 md:py-4 px-2.5 lg:px-4 font-bold text-primary whitespace-nowrap text-xs md:text-sm">${book.price > 0 ? formatRupiah(book.price) : '--'}</td>
          <td class="py-3.5 md:py-4 px-2.5 lg:px-4 whitespace-nowrap">
            <span class="font-bold px-2 py-0.5 rounded-md text-[11px] lg:text-xs ${stockCls}">${book.stock > 0 ? book.stock + ' Units' : '--'}</span>
          </td>
          <td class="py-3.5 md:py-4 px-2.5 lg:px-4 whitespace-nowrap">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] lg:text-[11px] font-bold ${st.badge}">
              <span class="w-1.5 h-1.5 rounded-full ${st.dot}"></span>${st.label}
            </span>
          </td>
          <td class="py-3.5 md:py-4 px-2.5 lg:px-4 text-right whitespace-nowrap">
            <div class="flex items-center justify-end gap-1">
              <button class="viewBtn w-7 h-7 lg:w-8 lg:h-8 rounded-lg flex items-center justify-center text-stone-500 hover:text-primary hover:bg-stone-200/50 transition-all" title="View" data-id="${book.id}">
                <span class="material-symbols-outlined text-base lg:text-lg">visibility</span>
              </button>
              ${book.validation_status === 'rejected' ? `
              <button class="w-7 h-7 lg:w-8 lg:h-8 rounded-lg flex items-center justify-center text-stone-300 cursor-not-allowed opacity-50" title="Edit Disabled (Rejected)" disabled>
                <span class="material-symbols-outlined text-base lg:text-lg">edit</span>
              </button>
              ` : `
              <button class="editBtn w-7 h-7 lg:w-8 lg:h-8 rounded-lg flex items-center justify-center text-stone-500 hover:text-primary hover:bg-stone-200/50 transition-all" title="Edit" data-id="${book.id}">
                <span class="material-symbols-outlined text-base lg:text-lg">edit</span>
              </button>
              `}
              <button class="deleteBtn w-7 h-7 lg:w-8 lg:h-8 rounded-lg flex items-center justify-center text-stone-500 hover:text-error hover:bg-stone-200/50 transition-all" title="Delete" data-id="${book.id}" data-name="${book.title}">
                <span class="material-symbols-outlined text-base lg:text-lg">delete</span>
              </button>
            </div>
          </td>
        </tr>`;
      }).join('');

      tableBody.innerHTML = rows;

      // Pagination info
      const start = (page - 1) * perPage + 1;
      const end = Math.min(page * perPage, Number(total));
      paginationInfo.textContent = `Showing ${start}–${end} of ${total.toLocaleString()} catalog items`;

      // Pagination controls
      let pagBtns = '';
      pagBtns += `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors ${page <= 1 ? 'opacity-30 pointer-events-none' : ''}" data-page="${page - 1}" aria-label="Previous"><span class="material-symbols-outlined text-sm text-stone-400">chevron_left</span></button>`;

      for (let p = 1; p <= totalPages; p++) {
        if (totalPages > 5 && p > 3 && p < totalPages - 1 && Math.abs(p - page) > 1) {
          if (p === 4) pagBtns += `<span class="w-9 h-9 flex items-center justify-center text-stone-400 text-xs tracking-wider">...</span>`;
          continue;
        }
        pagBtns += p === page
          ? `<button class="w-9 h-9 rounded-lg flex items-center justify-center bg-primary text-white font-bold text-xs">${p}</button>`
          : `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors font-medium text-xs" data-page="${p}">${p}</button>`;
      }

      pagBtns += `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors ${page >= totalPages ? 'opacity-30 pointer-events-none' : ''}" data-page="${page + 1}" aria-label="Next"><span class="material-symbols-outlined text-sm text-stone-400">chevron_right</span></button>`;

      paginationControls.innerHTML = pagBtns;

      // Bind action buttons
      bindActionButtons();
      bindPaginationButtons();
    }

    // ─── Fetch & Render ──────────────────────────────────────────
    async function loadCatalog() {
      tableBody.innerHTML = `<tr><td colspan="7" class="py-16 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span><p class="text-stone-400 text-sm">Loading catalog...</p></div></td></tr>`;

      try {
        const { books, meta } = await getBooks(currentFilter);
        renderTable(books, Number(meta.total), meta.page, meta.total_pages);
      } catch (err: any) {
        tableBody.innerHTML = `<tr><td colspan="7" class="py-16 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-4xl text-red-300">error</span><p class="text-stone-500 text-sm">${err.message || 'Failed to load catalog'}</p><button class="retryBtn text-primary font-bold text-sm mt-2 hover:underline">Retry</button></div></td></tr>`;
        tableBody.querySelector('.retryBtn')?.addEventListener('click', loadCatalog);
      }
    }

    // ─── Action Buttons ──────────────────────────────────────────
    function bindActionButtons() {
      // View
      tableBody.querySelectorAll('.viewBtn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id!;
          try {
            const book = await getBook(id);
            document.getElementById('viewBookCover')!.setAttribute('src', book.image_url || '');
            document.getElementById('viewBookTitle')!.textContent = book.title;
            document.getElementById('viewBookAuthor')!.textContent = book.author;
            const st = getStatusClasses(book.status);
            document.getElementById('viewBookStatus')!.innerHTML = `<span class="w-1.5 h-1.5 rounded-full ${st.dot}"></span> ${st.label}`;
            document.getElementById('viewBookStatus')!.className = `inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold ${st.badge}`;
            document.getElementById('viewBookCategory')!.textContent = book.category_name || '-';
            document.getElementById('viewBookBadge')!.textContent = book.badge || 'Regular';
            document.getElementById('viewBookISBN')!.textContent = book.isbn || 'Belum Terbit';
            const ggkeyEl = document.getElementById('viewBookGGKEY');
            if (ggkeyEl) ggkeyEl.textContent = (book.ggkey === "null" || !book.ggkey) ? '-' : book.ggkey;
            const qrcbnEl = document.getElementById('viewBookQRCBN');
            if (qrcbnEl) qrcbnEl.textContent = (book.qrcbn === "null" || !book.qrcbn) ? '-' : book.qrcbn;
            document.getElementById('viewBookPrice')!.textContent = formatRupiah(book.price);
            document.getElementById('viewBookStock')!.textContent = book.stock > 0 ? `${book.stock} Units` : '--';
            document.getElementById('viewBookDate')!.textContent = formatDate(book.created_at);
            document.getElementById('viewBookDesc')!.textContent = book.description || 'No description available.';

            // Validation block logic
            const valBlock = document.getElementById('viewBookValidationBlock')!;
            const draftLink = document.getElementById('viewBookDraftLink') as HTMLAnchorElement;
            const actionBtns = document.getElementById('viewBookActionButtons')!;
            const statusMsg = document.getElementById('viewBookValidationStatusMsg')!;
            
            // Set current book ID on buttons for validation click handlers
            const appBtn = document.getElementById('viewBookApproveBtn') as HTMLButtonElement;
            const rejBtn = document.getElementById('viewBookRejectBtn') as HTMLButtonElement;
            if (appBtn) appBtn.dataset.id = book.id;
            if (rejBtn) rejBtn.dataset.id = book.id;

            if (book.validation_status && book.status === 'draft') {
              valBlock.classList.remove('hidden');
              statusMsg.classList.add('hidden');
              
              if (book.draft_url) {
                // Draft documents could be from Google Drive or local
                draftLink.href = book.draft_url.startsWith('http') ? book.draft_url : `http://localhost:8080${book.draft_url}`;
                draftLink.parentElement!.classList.remove('hidden');
              } else {
                draftLink.parentElement!.classList.add('hidden');
              }

              const notesEl = document.getElementById('viewBookNotes') as HTMLTextAreaElement;
              if (notesEl) {
                notesEl.value = book.notes || '';
                notesEl.disabled = book.validation_status !== 'pending';
              }

              if (book.validation_status === 'pending') {
                actionBtns.classList.remove('hidden');
              } else {
                actionBtns.classList.add('hidden');
                statusMsg.classList.remove('hidden');
                statusMsg.textContent = `Status: ${book.validation_status.toUpperCase()}`;
                if (book.validation_status === 'approved') {
                  statusMsg.className = 'text-xs font-bold mt-1 text-center text-green-600';
                } else {
                  statusMsg.className = 'text-xs font-bold mt-1 text-center text-red-600';
                }
              }
            } else {
              valBlock.classList.add('hidden');
            }

            openModal('viewBookModal');
          } catch { showToast('Failed to load book details', 'error'); }
        });
      });

      // Edit
      tableBody.querySelectorAll('.editBtn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id!;
          try {
            document.getElementById('editBookAlert')?.classList.add('hidden');
            const book = await getBook(id);
            const form = document.getElementById('editBookForm') as HTMLFormElement;
            (form.querySelector('[name="id"]') as HTMLInputElement).value = book.id;
            (form.querySelector('[name="title"]') as HTMLInputElement).value = book.title;
            (form.querySelector('[name="author"]') as HTMLInputElement).value = book.author;
            (form.querySelector('[name="isbn"]') as HTMLInputElement).value = book.isbn || '';
            (form.querySelector('[name="badge"]') as HTMLSelectElement).value = book.badge || 'Regular';
            (form.querySelector('[name="ggkey"]') as HTMLInputElement).value = (book.ggkey === "null" || !book.ggkey) ? '' : book.ggkey;
            (form.querySelector('[name="qrcbn"]') as HTMLInputElement).value = (book.qrcbn === "null" || !book.qrcbn) ? '' : book.qrcbn;
            (form.querySelector('[name="category"]') as HTMLSelectElement).value = book.category_id || '';
            (form.querySelector('[name="status"]') as HTMLSelectElement).value = book.status;
            (form.querySelector('[name="price"]') as HTMLInputElement).value = String(book.price);
            (form.querySelector('[name="stock"]') as HTMLInputElement).value = String(book.stock);
            (form.querySelector('[name="production_cost"]') as HTMLInputElement).value = String(book.production_cost ?? 0);
            (form.querySelector('[name="royalty_fee"]') as HTMLInputElement).value = String(book.royalty_fee ?? 0);
            (form.querySelector('[name="existing_image_url"]') as HTMLInputElement).value = book.image_url || '';
            (form.querySelector('[name="publisher"]') as HTMLInputElement).value = book.publisher || '';
            (form.querySelector('[name="publication_date"]') as HTMLInputElement).value = book.publication_date || '';
            (form.querySelector('[name="amazon_url"]') as HTMLInputElement).value = book.amazon_url || '';
            (form.querySelector('[name="gplay_books_url"]') as HTMLInputElement).value = book.gplay_books_url || '';
            (form.querySelector('[name="format"]') as HTMLSelectElement).value = book.format || '';
            (form.querySelector('[name="language"]') as HTMLInputElement).value = book.language || '';
            (form.querySelector('[name="pages"]') as HTMLInputElement).value = String(book.pages || 0);
            (form.querySelector('[name="dimensions"]') as HTMLInputElement).value = (book.dimensions === "null" || !book.dimensions) ? '' : book.dimensions;
            (form.querySelector('[name="weight"]') as HTMLInputElement).value = (book.weight === "null" || !book.weight) ? '' : book.weight;
            (form.querySelector('[name="description"]') as HTMLTextAreaElement).value = book.description || '';
            openModal('editBookModal');
          } catch { showToast('Failed to load book for editing', 'error'); }
        });
      });

      // Delete
      tableBody.querySelectorAll('.deleteBtn').forEach(btn => {
        btn.addEventListener('click', () => {
          deleteTargetId = (btn as HTMLElement).dataset.id!;
          document.getElementById('deleteBookTitle')!.textContent = (btn as HTMLElement).dataset.title || '';
          openModal('deleteModal');
        });
      });
    }

    function bindPaginationButtons() {
      paginationControls.querySelectorAll('.pagBtn').forEach(btn => {
        btn.addEventListener('click', () => {
          const page = parseInt((btn as HTMLElement).dataset.page || '1');
          currentPage = page;
          currentFilter.page = page;
          loadCatalog();
        });
      });
    }

    // ─── Create Book ─────────────────────────────────────────────
    document.getElementById('addBookBtn')?.addEventListener('click', () => {
      (document.getElementById('addBookForm') as HTMLFormElement).reset();
      document.getElementById('addBookAlert')?.classList.add('hidden');
      openModal('addBookModal');
    });

    document.getElementById('saveBookBtn')?.addEventListener('click', async () => {
      const form = document.getElementById('addBookForm') as HTMLFormElement;
      const formData = new FormData(form);
      const btn = document.getElementById('saveBookBtn') as HTMLButtonElement;
      const alertBox = document.getElementById('addBookAlert')!;
      alertBox.classList.add('hidden');

      let imageUrl = "";
      const fileInput = form.querySelector('input[name="image_upload"]') as HTMLInputElement;
      if (fileInput && fileInput.files && fileInput.files.length > 0) {
        try {
          btn.disabled = true;
          btn.textContent = 'Uploading...';
          const uploadRes = await uploadImage(fileInput.files[0]);
          imageUrl = uploadRes.url;
        } catch(err: any) {
          showModalError(alertBox, err, 'Failed to upload image');
          btn.disabled = false;
          btn.textContent = 'Save Book';
          return;
        }
      }

      const payload = {
        title: formData.get('title') as string,
        author: formData.get('author') as string,
        isbn: formData.get('isbn') as string,
        badge: formData.get('badge') as string,
        ggkey: formData.get('ggkey') as string,
        qrcbn: formData.get('qrcbn') as string,
        category_id: formData.get('category') as string,
        status: ((formData.get('status') as string) || 'draft') as Book['status'],
        validation_status: 'approved' as const,
        price: parseInt(formData.get('price') as string) || 0,
        stock: parseInt(formData.get('stock') as string) || 0,
        image_url: imageUrl,
        description: formData.get('description') as string,
        publisher: formData.get('publisher') as string,
        publication_date: formData.get('publication_date') as string,
        amazon_url: (formData.get('amazon_url') as string) || '',
        gplay_books_url: (formData.get('gplay_books_url') as string) || '',
        format: formData.get('format') as string,
        language: formData.get('language') as string,
        pages: parseInt(formData.get('pages') as string) || 0,
        dimensions: formData.get('dimensions') as string,
        weight: formData.get('weight') as string,
        production_cost: parseInt(String(formData.get('production_cost') || '0'), 10) || 0,
        royalty_fee: parseInt(String(formData.get('royalty_fee') || '0'), 10) || 0,
      };

      const prodCostRaw = formData.get('production_cost');
      const royaltyFeeRaw = formData.get('royalty_fee');
      const prodCostStr = prodCostRaw !== null ? String(prodCostRaw).trim() : '';
      const royaltyFeeStr = royaltyFeeRaw !== null ? String(royaltyFeeRaw).trim() : '';

      if (!payload.title || !payload.author) {
        showModalError(alertBox, { message: 'Title and Author are required' }, 'Validation Error');
        return;
      }

      if (prodCostStr === '' || royaltyFeeStr === '') {
        showModalError(alertBox, { message: 'Production Cost and Royalty Fee are required' }, 'Validation Error');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        await createBook(payload);
        closeModalById('addBookModal');
        showToast('Book created successfully!');
        loadCatalog();
      } catch (err: any) {
        showModalError(alertBox, err, 'Failed to create book');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save Book';
      }
    });

    // ─── Update Book ─────────────────────────────────────────────
    document.getElementById('updateBookBtn')?.addEventListener('click', async () => {
      const form = document.getElementById('editBookForm') as HTMLFormElement;
      const formData = new FormData(form);
      const btn = document.getElementById('updateBookBtn') as HTMLButtonElement;
      const id = formData.get('id') as string;
      const alertBox = document.getElementById('editBookAlert')!;
      alertBox.classList.add('hidden');

      let imageUrl = formData.get("existing_image_url") as string || "";
      const fileInput = form.querySelector('input[name="image_upload"]') as HTMLInputElement;
      if (fileInput && fileInput.files && fileInput.files.length > 0) {
        try {
          btn.disabled = true;
          btn.textContent = 'Uploading...';
          const uploadRes = await uploadImage(fileInput.files[0]);
          imageUrl = uploadRes.url;
        } catch(err: any) {
          showModalError(alertBox, err, 'Failed to upload image');
          btn.disabled = false;
          btn.textContent = 'Save Changes';
          return;
        }
      }

      const payload = {
        title: formData.get('title') as string,
        author: formData.get('author') as string,
        isbn: formData.get('isbn') as string,
        badge: formData.get('badge') as string,
        ggkey: formData.get('ggkey') as string,
        qrcbn: formData.get('qrcbn') as string,
        category_id: formData.get('category') as string,
        status: ((formData.get('status') as string) || 'draft') as Book['status'],
        price: parseInt(formData.get('price') as string) || 0,
        stock: parseInt(formData.get('stock') as string) || 0,
        image_url: imageUrl,
        description: formData.get('description') as string,
        publisher: formData.get('publisher') as string,
        publication_date: formData.get('publication_date') as string,
        amazon_url: (formData.get('amazon_url') as string) || '',
        gplay_books_url: (formData.get('gplay_books_url') as string) || '',
        format: formData.get('format') as string,
        language: formData.get('language') as string,
        pages: parseInt(formData.get('pages') as string) || 0,
        dimensions: formData.get('dimensions') as string,
        weight: formData.get('weight') as string,
        production_cost: parseInt(String(formData.get('production_cost') || '0'), 10) || 0,
        royalty_fee: parseInt(String(formData.get('royalty_fee') || '0'), 10) || 0,
      };

      const prodCostRaw = formData.get('production_cost');
      const royaltyFeeRaw = formData.get('royalty_fee');
      const prodCostStr = prodCostRaw !== null ? String(prodCostRaw).trim() : '';
      const royaltyFeeStr = royaltyFeeRaw !== null ? String(royaltyFeeRaw).trim() : '';

      if (!payload.title || !payload.author) {
        showModalError(alertBox, { message: 'Title and Author are required' }, 'Validation Error');
        return;
      }

      if (prodCostStr === '' || royaltyFeeStr === '') {
        showModalError(alertBox, { message: 'Production Cost and Royalty Fee are required' }, 'Validation Error');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        await updateBook(id, payload);
        closeModalById('editBookModal');
        showToast('Book updated successfully!');
        loadCatalog();
      } catch (err: any) {
        showModalError(alertBox, err, 'Failed to update book');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save Changes';
      }
    });

    // ─── Delete Book ─────────────────────────────────────────────
    document.getElementById('confirmDeleteBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('confirmDeleteBtn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Deleting...';

      try {
        await deleteBook(deleteTargetId);
        closeModalById('deleteModal');
        showToast('Book deleted successfully!');
        loadCatalog();
      } catch (err: any) {
        showToast(err.message || 'Failed to delete book', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Delete';
      }
    });

    // ─── Search & Filter ─────────────────────────────────────────
    let searchTimeout: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        currentFilter.search = searchInput.value.trim() || undefined;
        currentFilter.page = 1;
        currentPage = 1;
        loadCatalog();
      }, 400);
    });

    categoryFilter?.addEventListener('change', () => {
      currentFilter.category_id = categoryFilter.value || undefined;
      currentFilter.page = 1;
      currentPage = 1;
      loadCatalog();
    });

    statusFilter?.addEventListener('change', () => {
      currentFilter.status = statusFilter.value || undefined;
      currentFilter.page = 1;
      currentPage = 1;
      loadCatalog();
    });

    // ─── Initial Load ────────────────────────────────────────────
    async function init() {
      try {
        const categories = await getCategories();
        const selects = document.querySelectorAll('.dynamic-category-select, #categoryFilter');
        selects.forEach(select => {
          const asSelect = select as HTMLSelectElement;
          const firstOpt = asSelect.options[0].outerHTML;
          const options = categories.map((c: any) => `<option value="${c.id}">${c.name}</option>`).join('');
          asSelect.innerHTML = firstOpt + options;
        });
      } catch (err) {
        console.error('Failed to load categories', err);
      }
      loadCatalog();
    }
    
    init();
  </script>
</AdminLayout>



