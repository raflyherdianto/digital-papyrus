  <!-- Reject Success Modal -->
  <div id="rejectSuccessModal" class="modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-stone-900/40 backdrop-blur-sm transition-opacity opacity-0"></div>
    <div class="bg-surface rounded-2xl w-full max-w-sm overflow-hidden shadow-2xl transform scale-95 opacity-0 transition-all z-10 relative">
      <div class="p-6 md:p-8 text-center flex flex-col items-center">
