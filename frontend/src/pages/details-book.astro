---
/**
 * Book Details Page
 * Route: /details-book?id=<book-id>
 * Fetches book details dynamically from the backend API.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories, slugifyCategory } from '../lib/api';

const pendingBookId = Astro.url.searchParams.get('add_to_cart');
---

<BaseLayout title="Detail Buku — Digital Papyrus" description="Detail buku dari katalog Digital Papyrus." readingProgress={35}>
  <div class="pb-16 md:pb-20 max-w-7xl mx-auto px-4 md:px-6 lg:px-12">
    <!-- Breadcrumb -->
    <nav class="mb-8 md:mb-12 flex flex-wrap gap-2 text-xs uppercase tracking-[0.05em] text-outline" aria-label="Breadcrumb">
      <a class="hover:text-primary transition-colors" href="/katalog">Katalog</a>
      <span>/</span>
      <span id="breadCategory" class="hover:text-primary transition-colors cursor-pointer">...</span>
      <span>/</span>
      <span id="breadTitle" class="text-on-surface-variant font-semibold">Loading...</span>
    </nav>

    <!-- Loading Skeleton -->
    <div id="bookLoading" class="animate-pulse">
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16 items-start">
        <div class="lg:col-span-5"><div class="aspect-[3/4] rounded-xl bg-surface-container-low"></div></div>
        <div class="lg:col-span-7 flex flex-col gap-6">
          <div class="h-12 bg-surface-container-low rounded w-3/4"></div>
          <div class="h-6 bg-surface-container-low rounded w-1/2"></div>
          <div class="h-24 bg-surface-container-low rounded"></div>
          <div class="h-40 bg-surface-container-low rounded"></div>
        </div>
      </section>
    </div>

    <!-- Content (hidden until data loads) -->
    <section id="bookContent" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16 items-start">
      <!-- Book Cover -->
      <div class="lg:col-span-5 relative group">
        <div class="absolute -inset-4 bg-surface-container-low rounded-xl -z-10 transform translate-x-2 translate-y-2 transition-transform group-hover:translate-x-4 group-hover:translate-y-4"></div>
        <div class="aspect-[3/4] rounded-xl overflow-hidden shadow-[0px_24px_48px_rgba(26,28,28,0.12)] bg-surface-container">
          <img id="bookCover" class="w-full h-full object-cover" alt="" src="" loading="eager" />
        </div>
      </div>

      <!-- Content Details -->
      <div class="lg:col-span-7 flex flex-col gap-8 md:gap-10">
        <header>
          <span id="bookBadge" class="inline-block px-3 py-1 bg-tertiary-fixed text-on-tertiary-fixed text-[10px] font-bold uppercase tracking-widest rounded-full mb-3 md:mb-4 hidden"></span>
          <h1 id="bookTitle" class="text-3xl md:text-5xl lg:text-6xl font-headline font-extrabold tracking-tight text-primary leading-none mb-3 md:mb-4"></h1>
          <div class="flex flex-wrap items-center gap-3 md:gap-4 text-on-surface-variant">
            <p id="bookAuthor" class="font-headline font-bold text-lg md:text-xl"></p>
            <span class="w-1.5 h-1.5 rounded-full bg-outline-variant"></span>
            <div class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm text-tertiary" style="font-variation-settings: 'FILL' 1;">star</span>
              <span id="bookRating" class="font-semibold"></span>
              <span id="bookReviews" class="text-sm opacity-60"></span>
            </div>
          </div>
        </header>

        <!-- Pricing -->
        <div class="p-6 md:p-8 rounded-xl bg-surface-container-low border border-outline-variant/10 flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center justify-between gap-4 md:gap-6">
          <div>
            <span class="text-sm text-on-surface-variant font-medium">Digital & Print Bundle</span>
            <div class="flex items-baseline gap-2">
              <p id="bookPrice" class="text-3xl md:text-4xl font-headline font-extrabold text-primary"></p>
            </div>
          </div>
          <div class="flex gap-3 md:gap-4 w-full sm:w-auto">
            <button id="addToCartBtn" class="flex-1 sm:flex-none px-6 md:px-8 py-3 md:py-4 bg-gradient-to-r from-primary to-primary-container text-white font-bold rounded-lg shadow-lg shadow-primary/20 hover:opacity-90 transition-all active:scale-95 text-sm md:text-base flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-lg">add_shopping_cart</span>
              Add to Cart
            </button>
          </div>
        </div>

        <!-- External Platforms (Amazon & Google Play Books) -->
        <div id="externalPlatforms" class="hidden p-4 md:p-5 rounded-xl bg-surface-container-low border border-outline-variant/15 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div class="flex items-center gap-2 text-on-surface-variant text-xs font-bold uppercase tracking-wider">
            <span class="material-symbols-outlined text-base text-tertiary">storefront</span>
            <span>Tersedia Juga di Platform Global:</span>
          </div>
          <div id="platformLinks" class="flex flex-wrap gap-2.5 w-full sm:w-auto"></div>
        </div>

        <!-- Tabs -->
        <div class="flex flex-col gap-6 md:gap-8">
          <div class="flex gap-6 md:gap-8 border-b border-outline-variant/20 overflow-x-auto">
            <button id="tab-synopsis" class="pb-4 border-b-2 border-tertiary text-primary font-bold whitespace-nowrap text-sm md:text-base">Description</button>
            <button id="tab-details" class="pb-4 text-on-surface-variant hover:text-primary transition-colors border-b-2 border-transparent whitespace-nowrap text-sm md:text-base">Details</button>
          </div>
          <div id="content-synopsis" class="space-y-6 tab-content block">
            <p id="bookSynopsis" class="text-base md:text-lg leading-relaxed text-on-surface-variant"></p>
          </div>
          <div id="content-details" class="space-y-6 tab-content hidden">
            <div id="bookDetailsGrid" class="text-base md:text-lg leading-relaxed text-on-surface-variant"></div>
          </div>

          <!-- Specifications Grid -->
          <div id="bookSpecs" class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 py-6 md:py-8 px-2"></div>
        </div>
      </div>
    </section>

    <!-- Related Books -->
    <section id="relatedSection" class="mt-20 md:mt-32 hidden">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 md:mb-12 gap-4">
        <div>
          <h2 class="text-2xl md:text-3xl font-headline font-extrabold text-primary tracking-tight">Expand Your Curated Shelf</h2>
          <p class="text-on-surface-variant opacity-70 text-sm md:text-base">Rekomendasi buku pilihan berdasarkan katalog kami.</p>
        </div>
      </div>
      <div id="relatedGrid" class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8"></div>
    </section>
  </div>

  <!-- Success Modal -->
  <div id="cartSuccessModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/10 shadow-2xl p-8 max-w-sm w-full mx-4 text-center transform scale-95 transition-all duration-300">
      <div class="w-16 h-16 bg-green-500/10 text-green-500 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-4xl">check_circle</span>
      </div>
      <h3 class="text-xl font-bold text-primary font-headline mb-2">Berhasil!</h3>
      <p class="text-on-surface-variant font-body text-sm mb-6">Item berhasil dimasukkan ke dalam keranjang.</p>
      <div class="flex gap-3">
        <button id="modalContinueBtn" class="flex-1 py-3 bg-surface-container border border-outline-variant/30 text-primary font-bold rounded-xl text-sm hover:bg-surface-container-high transition-all">Lanjut Belanja</button>
        <a href="/customer-cart" class="flex-1 py-3 bg-primary text-white font-bold rounded-xl text-sm hover:opacity-90 transition-all text-center shadow-lg shadow-primary/10">Lihat Keranjang</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { getBook, getBooks, formatRupiah, slugifyCategory, isAuthenticated } from '../lib/api';

  // Tab switching
  const tabIds = ['synopsis', 'details'];
  tabIds.forEach(id => {
    document.getElementById(`tab-${id}`)?.addEventListener('click', () => {
      tabIds.forEach(t => {
        const tab = document.getElementById(`tab-${t}`);
        const content = document.getElementById(`content-${t}`);
        if (t === id) {
          tab!.className = 'pb-4 border-b-2 border-tertiary text-primary font-bold whitespace-nowrap text-sm md:text-base';
          content!.classList.remove('hidden');
        } else {
          tab!.className = 'pb-4 text-on-surface-variant hover:text-primary transition-colors border-b-2 border-transparent whitespace-nowrap text-sm md:text-base';
          content!.classList.add('hidden');
        }
      });
    });
  });

  // Get book ID from URL
  const urlParams = new URLSearchParams(window.location.search);
  const bookId = urlParams.get('id');

  if (!bookId) {
    window.location.href = '/katalog';
  } else {
    loadBookDetails(bookId);
  }

  function formatWeight(weight: string | number | null | undefined): string {
    if (weight === null || weight === undefined) return '-';
    const value = String(weight).trim();
    if (!value) return '-';
    return /kg$/i.test(value) ? value : `${value} kg`;
  }

  function getBadgeClasses(badge: string): string {
    switch ((badge || 'Regular').toLowerCase()) {
      case 'limited edition':
        return 'bg-rose-100 text-rose-800';
      case 'premium edition':
        return 'bg-amber-100 text-amber-800';
      default:
        return 'bg-slate-200 text-slate-700';
    }
  }

  async function loadBookDetails(id: string) {
    try {
      const book = await getBook(id);

      // Update page title
      document.title = `${book.title} — Digital Papyrus`;

      // Breadcrumb
      document.getElementById('breadCategory')!.textContent = book.category_name || 'Uncategorized';
      document.getElementById('breadTitle')!.textContent = book.title;

      // Cover
      const cover = document.getElementById('bookCover') as HTMLImageElement;
      cover.src = book.image_url || '';
      cover.alt = `Cover buku ${book.title} oleh ${book.author}`;

      // Header
      const badgeText = book.badge || 'Regular';
      const badge = document.getElementById('bookBadge')!;
      badge.textContent = badgeText;
      badge.className = `inline-block px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-full mb-3 md:mb-4 ${getBadgeClasses(badgeText)}`;
      badge.classList.remove('hidden');
      document.getElementById('bookTitle')!.textContent = book.title;
      document.getElementById('bookAuthor')!.textContent = book.author;
      document.getElementById('bookRating')!.textContent = book.rating.toFixed(1);
      document.getElementById('bookReviews')!.textContent = `(${book.review_count} reviews)`;

      // Price
      document.getElementById('bookPrice')!.textContent = formatRupiah(book.price);

      // External Platforms (Amazon & Google Play Books)
      const externalPlatforms = document.getElementById('externalPlatforms');
      const platformLinks = document.getElementById('platformLinks');
      if (externalPlatforms && platformLinks) {
        let linksHtml = '';
        if (book.amazon_url && book.amazon_url.trim() !== '') {
          linksHtml += `
            <a href="${book.amazon_url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FF9900]/10 hover:bg-[#FF9900]/20 text-[#B45309] font-bold text-xs border border-[#FF9900]/30 transition-all hover:scale-105 shadow-xs">
              <span class="material-symbols-outlined text-base text-[#FF9900]">shopping_bag</span>
              <span>Amazon Books</span>
              <span class="material-symbols-outlined text-xs opacity-60">open_in_new</span>
            </a>`;
        }
        if (book.gplay_books_url && book.gplay_books_url.trim() !== '') {
          linksHtml += `
            <a href="${book.gplay_books_url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#01875f]/10 hover:bg-[#01875f]/20 text-[#047857] font-bold text-xs border border-[#01875f]/30 transition-all hover:scale-105 shadow-xs">
              <span class="material-symbols-outlined text-base text-[#01875f]">menu_book</span>
              <span>Google Play Books</span>
              <span class="material-symbols-outlined text-xs opacity-60">open_in_new</span>
            </a>`;
        }
        if (linksHtml) {
          platformLinks.innerHTML = linksHtml;
          externalPlatforms.classList.remove('hidden');
        } else {
          externalPlatforms.classList.add('hidden');
        }
      }

      // Description
      document.getElementById('bookSynopsis')!.textContent = book.description || 'No description available.';

      // Details tab
      document.getElementById('bookDetailsGrid')!.innerHTML = `
        <p><strong>Publisher:</strong> ${book.publisher || '-'}<br/>
        <strong>Publication Date:</strong> ${book.publication_date || '-'}<br/>
        <strong>Badge:</strong> ${book.badge || 'Regular'}<br/>
        <strong>GGKEY:</strong> ${book.ggkey || '-'}<br/>
        <strong>QRCBN:</strong> ${book.qrcbn || '-'}<br/>
        <strong>Dimensions:</strong> ${book.dimensions || '-'}<br/>
        <strong>Weight:</strong> ${formatWeight(book.weight)}<br/>
        <strong>ISBN:</strong> ${book.isbn || '-'}<br/>
        <strong>Amazon Books:</strong> ${book.amazon_url && book.amazon_url.trim() !== '' ? `<a href="${book.amazon_url}" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-tertiary underline font-semibold inline-flex items-center gap-1">Buka di Amazon <span class="material-symbols-outlined text-xs">open_in_new</span></a>` : '-'}<br/>
        <strong>Google Play Books:</strong> ${book.gplay_books_url && book.gplay_books_url.trim() !== '' ? `<a href="${book.gplay_books_url}" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-tertiary underline font-semibold inline-flex items-center gap-1">Buka di Google Play Books <span class="material-symbols-outlined text-xs">open_in_new</span></a>` : '-'}</p>`;

      // Specs
      let specsHtml = `
        <div><p class="text-[10px] uppercase tracking-widest text-outline mb-1">Badge</p><p class="font-bold text-primary text-sm md:text-base">${book.badge || 'Regular'}</p></div>
        <div><p class="text-[10px] uppercase tracking-widest text-outline mb-1">ISBN-13</p><p class="font-bold text-primary text-sm md:text-base">${book.isbn || '-'}</p></div>
        <div><p class="text-[10px] uppercase tracking-widest text-outline mb-1">GGKEY</p><p class="font-bold text-primary text-sm md:text-base">${book.ggkey || '-'}</p></div>
        <div><p class="text-[10px] uppercase tracking-widest text-outline mb-1">QRCBN</p><p class="font-bold text-primary text-sm md:text-base">${book.qrcbn || '-'}</p></div>
        <div><p class="text-[10px] uppercase tracking-widest text-outline mb-1">Pages</p><p class="font-bold text-primary text-sm md:text-base">${book.pages || '-'}</p></div>
        <div><p class="text-[10px] uppercase tracking-widest text-outline mb-1">Format</p><p class="font-bold text-primary text-sm md:text-base">${book.format || '-'}</p></div>
        <div><p class="text-[10px] uppercase tracking-widest text-outline mb-1">Language</p><p class="font-bold text-primary text-sm md:text-base">${book.language || '-'}</p></div>`;
      if (book.amazon_url && book.amazon_url.trim() !== '') {
        specsHtml += `<div><p class="text-[10px] uppercase tracking-widest text-outline mb-1">Amazon</p><a href="${book.amazon_url}" target="_blank" rel="noopener noreferrer" class="font-bold text-amber-600 hover:underline text-sm md:text-base inline-flex items-center gap-1">Tersedia <span class="material-symbols-outlined text-xs">open_in_new</span></a></div>`;
      }
      if (book.gplay_books_url && book.gplay_books_url.trim() !== '') {
        specsHtml += `<div><p class="text-[10px] uppercase tracking-widest text-outline mb-1">Google Play</p><a href="${book.gplay_books_url}" target="_blank" rel="noopener noreferrer" class="font-bold text-emerald-600 hover:underline text-sm md:text-base inline-flex items-center gap-1">Tersedia <span class="material-symbols-outlined text-xs">open_in_new</span></a></div>`;
      }
      document.getElementById('bookSpecs')!.innerHTML = specsHtml;

      // Show content, hide loading
      document.getElementById('bookLoading')!.classList.add('hidden');
      document.getElementById('bookContent')!.classList.remove('hidden');

      // Load related books
      loadRelatedBooks(book.category_id, book.id);

      // Add to Cart handler
      const addToCartBtn = document.getElementById('addToCartBtn');
      if (addToCartBtn) {
        addToCartBtn.addEventListener('click', () => {
          if (!isAuthenticated()) {
            // Save current page URL so user returns after login
            sessionStorage.setItem('dp_redirect_after_login', window.location.href + '&add_to_cart=1');
            window.location.href = '/customer-login';
            return;
          }
          addBookToCart(book);
        });
      }

      // Auto-add if returning from login with pending add_to_cart
      const urlP = new URLSearchParams(window.location.search);
      if (urlP.get('add_to_cart') === '1' && isAuthenticated()) {
        addBookToCart(book);
        // Clean up URL
        urlP.delete('add_to_cart');
        const cleanUrl = `${window.location.pathname}?${urlP.toString()}`;
        window.history.replaceState({}, '', cleanUrl);
      }

    } catch (err) {
      document.getElementById('bookLoading')!.innerHTML = `
        <div class="py-20 text-center">
          <span class="material-symbols-outlined text-5xl text-red-300 mb-4 block">error</span>
          <p class="text-lg text-on-surface-variant font-semibold">Buku tidak ditemukan</p>
          <a href="/katalog" class="text-primary font-bold mt-4 inline-block hover:underline">← Kembali ke Katalog</a>
        </div>`;
    }
  }

  async function loadRelatedBooks(categoryId: string, excludeId: string) {
    try {
      const { books } = await getBooks({ per_page: 4, category_id: categoryId || undefined, status: 'published' });
      const related = books.filter(b => b.id !== excludeId).slice(0, 4);

      if (related.length > 0) {
        document.getElementById('relatedGrid')!.innerHTML = related.map(book => `
          <a href="/details-book?id=${book.id}" class="block group cursor-pointer">
            <div class="aspect-[3/4] rounded-xl overflow-hidden bg-surface-container-low mb-4 md:mb-6 transform group-hover:-translate-y-2 transition-transform duration-300">
              ${book.image_url
                ? `<img class="w-full h-full object-cover" draggable="false" alt="Cover ${book.title}" src="${book.image_url}" loading="lazy" />`
                : `<div class="w-full h-full flex items-center justify-center"><span class="material-symbols-outlined text-4xl text-stone-300">auto_stories</span></div>`}
            </div>
            <h3 class="font-headline font-bold text-primary text-base md:text-lg group-hover:text-tertiary transition-colors">${book.title}</h3>
            <p class="text-sm text-on-surface-variant">${book.author}</p>
          </a>`).join('');

        document.getElementById('relatedSection')!.classList.remove('hidden');
      }
    } catch { /* silently skip if related books fail */ }
  }

  function addBookToCart(book: any) {
    const cartRaw = localStorage.getItem('dp_cart') || '[]';
    let cart = JSON.parse(cartRaw);
    const existing = cart.find((item: any) => item.id === book.id && item.type === 'book');
    if (existing) {
      existing.qty += 1;
    } else {
      cart.push({
        id: book.id,
        type: 'book',
        title: book.title,
        author: book.author,
        price: book.price,
        image_url: book.image_url,
        qty: 1,
        weight: book.weight ? parseFloat(book.weight) || 0.3 : 0.3,
        format: book.format || ''
      });
    }
    localStorage.setItem('dp_cart', JSON.stringify(cart));
    showCartSuccessModal();
  }

  function showCartSuccessModal() {
    const modal = document.getElementById('cartSuccessModal');
    if (modal) modal.classList.remove('hidden');
  }

  // Modal close handlers
  const modal = document.getElementById('cartSuccessModal');
  const continueBtn = document.getElementById('modalContinueBtn');
  if (continueBtn && modal) {
    continueBtn.addEventListener('click', () => modal.classList.add('hidden'));
  }
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });
  }
</script>
