---
/**
 * Customer Dashboard Page
 * Route: /customer-dashboard
 * Fetches user stats and recent order activity.
 */
import CustomerLayout from '../layouts/CustomerLayout.astro';
---

<CustomerLayout title="Customer Dashboard | Digital Papyrus" activePage="dashboard">
  <!-- Header -->
  <div class="flex flex-col md:flex-row items-start md:items-baseline justify-between mb-8 md:mb-12 gap-4">
    <div>
      <h2 id="greetingText" class="text-2xl md:text-4xl font-extrabold tracking-tight text-primary font-headline mb-2">Welcome, Reader.</h2>
      <p class="text-stone-500 font-body text-sm md:text-lg max-w-xl">Your publishing journey and library in one place.</p>
    </div>
    <div class="flex gap-3 md:gap-4 w-full md:w-auto">
      <a href="/katalog" class="flex-1 md:flex-none px-4 md:px-6 py-3 bg-primary text-white font-bold rounded-xl text-xs md:text-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/10">
        <span class="material-symbols-outlined text-sm">explore</span> <span>Explore Catalog</span>
      </a>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-10 md:mb-16">
    <!-- Total Orders -->
    <div class="bg-primary p-4 sm:p-6 md:p-8 rounded-xl text-on-primary-container relative overflow-hidden group">
      <div class="absolute -right-4 -bottom-4 opacity-10 transition-transform group-hover:scale-110"><span class="material-symbols-outlined text-8xl">shopping_bag</span></div>
      <p class="text-xs font-label uppercase tracking-widest text-on-primary-container/80 mb-3 md:mb-4">Total Orders</p>
      <h3 id="statTotalOrders" class="text-2xl md:text-3xl font-headline font-extrabold text-white">--</h3>
      <div class="mt-3 md:mt-4 flex items-center gap-2 text-xs text-primary-fixed-dim"><span class="material-symbols-outlined text-sm">receipt_long</span><span>All order items</span></div>
    </div>
    <!-- Pending Payment -->
    <div class="bg-surface-container-low p-4 sm:p-6 md:p-8 rounded-xl hover:bg-surface-container-high transition-colors">
      <p class="text-xs font-label uppercase tracking-widest text-stone-500 mb-3 md:mb-4">Pending Payment</p>
      <h3 id="statPending" class="text-2xl md:text-3xl font-headline font-extrabold text-primary">--</h3>
      <div class="mt-3 md:mt-4 flex items-center gap-2 text-xs text-orange-600"><span class="material-symbols-outlined text-sm">pending_actions</span><span>Awaiting confirmation</span></div>
    </div>
    <!-- Processing -->
    <div class="bg-surface-container-low p-4 sm:p-6 md:p-8 rounded-xl hover:bg-surface-container-high transition-colors">
      <p class="text-xs font-label uppercase tracking-widest text-stone-500 mb-3 md:mb-4">Processing</p>
      <h3 id="statProcessing" class="text-2xl md:text-3xl font-headline font-extrabold text-primary">--</h3>
      <div class="mt-3 md:mt-4 flex items-center gap-2 text-xs text-teal-700"><span class="material-symbols-outlined text-sm">sync</span><span>In production</span></div>
    </div>
    <!-- Completed -->
    <div class="bg-tertiary-fixed p-4 sm:p-6 md:p-8 rounded-xl text-on-tertiary-fixed relative overflow-hidden group">
      <div class="absolute -right-4 -bottom-4 opacity-10 transition-transform group-hover:scale-110"><span class="material-symbols-outlined text-8xl">verified</span></div>
      <p class="text-xs font-label uppercase tracking-widest text-on-tertiary-fixed-variant mb-3 md:mb-4">Completed</p>
      <h3 id="statCompleted" class="text-2xl md:text-3xl font-headline font-extrabold text-tertiary">--</h3>
      <div class="mt-3 md:mt-4 flex items-center gap-2 text-xs font-medium"><span class="material-symbols-outlined text-sm">check_circle</span><span>Shipped / Delivered</span></div>
    </div>
  </div>

  <!-- Layout Grid for Orders & Profile -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Recent Orders Table (2 cols on large screen) -->
    <div id="transactions" class="lg:col-span-2 bg-surface-container-lowest rounded-xl p-4 md:p-8 border border-stone-200/10 shadow-sm min-w-0 w-full max-w-full overflow-hidden">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-6 md:mb-8 gap-4">
        <h3 class="text-xl md:text-2xl font-headline font-bold text-primary">Your Recent Orders</h3>
      </div>

      <div class="table-responsive-container overflow-x-auto w-full max-w-full block" style="-webkit-overflow-scrolling: touch;">
        <table class="w-full text-left min-w-[650px] border-collapse">
          <thead>
            <tr class="text-stone-400 font-label text-[10px] uppercase tracking-widest whitespace-nowrap">
              <th class="pb-4 md:pb-6 px-3 md:px-4 whitespace-nowrap">Invoice</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 whitespace-nowrap">Items</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 whitespace-nowrap">Total Qty</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 whitespace-nowrap">Total Price</th>
              <th class="pb-4 md:pb-6 px-3 md:px-4 whitespace-nowrap">Status</th>
            </tr>
          </thead>
          <tbody id="recentOrdersBody" class="text-sm font-body">
            <tr>
              <td colspan="5" class="py-12 text-center">
                <span class="material-symbols-outlined text-3xl text-stone-300 animate-spin">progress_activity</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div id="ordersPagInfo" class="mt-6 md:mt-8 flex items-center justify-between border-t border-stone-200/20 pt-6 md:pt-8">
        <p class="text-xs text-stone-400 font-medium">Loading...</p>
      </div>
    </div>

    <!-- Account Details Panel -->
    <div id="profile" class="bg-surface-container-low rounded-xl p-6 md:p-8 border border-stone-200/10 shadow-sm flex flex-col justify-between">
      <div>
        <h3 class="text-xl font-headline font-bold text-primary mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined">badge</span>
          Profile Details
        </h3>
        
        <div class="space-y-4 text-sm font-body">
          <div>
            <p class="text-xs text-stone-400 uppercase tracking-wider font-semibold">Name</p>
            <p id="profileName" class="font-bold text-primary text-base mt-0.5">--</p>
          </div>
          <div>
            <p class="text-xs text-stone-400 uppercase tracking-wider font-semibold">Email</p>
            <p id="profileEmail" class="text-stone-700 mt-0.5">--</p>
          </div>
          <div>
            <p class="text-xs text-stone-400 uppercase tracking-wider font-semibold">Status Role</p>
            <span class="inline-block mt-1 px-3 py-1 bg-stone-200 text-stone-700 rounded-full font-bold text-[10px] uppercase tracking-wider">Customer</span>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-stone-200/30">
        <div class="bg-primary/5 rounded-xl p-4 border border-primary/10">
          <h4 class="font-bold text-primary text-xs uppercase tracking-wider mb-2 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">support_agent</span>
            Need assistance?
          </h4>
          <p class="text-xs text-stone-600 leading-relaxed mb-3">Questions about formatting, printing, or publishing packages?</p>
          <a href="https://wa.me/628123456789" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-white text-xs font-bold rounded-lg hover:opacity-90 transition-all">
            <span class="material-symbols-outlined text-xs">chat</span> Contact Support
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { getCustomerOrders, cancelCustomerOrder, formatRupiah, isAuthenticated, removeToken } from '../lib/api';

    // Auth guard
    if (!isAuthenticated()) {
      window.location.href = '/customer-login';
    }

    // Greeting with user name & load profile
    const userData = localStorage.getItem('dp_user');
    if (userData) {
      try {
        const user = JSON.parse(userData);
        const hour = new Date().getHours();
        const greeting = hour < 12 ? 'Morning' : hour < 17 ? 'Afternoon' : 'Evening';
        document.getElementById('greetingText')!.textContent = `Good ${greeting}, ${user.name.split(' ')[0]}.`;
        
        // Populate profile card
        document.getElementById('profileName')!.textContent = user.name || '--';
        document.getElementById('profileEmail')!.textContent = user.email || '--';
      } catch {}
    }

    // Status helper matching customer-transactions.astro styling
    function getStatusHTML(status: string) {
      const map: Record<string, { badge: string; dot: string; label: string }> = {
        completed: { badge: 'bg-teal-100 text-teal-800', dot: 'bg-teal-600', label: 'Completed' },
        processed: { badge: 'bg-sky-100 text-sky-800', dot: 'bg-sky-600', label: 'Diproses' },
        diproses: { badge: 'bg-sky-100 text-sky-800', dot: 'bg-sky-600', label: 'Diproses' },
        processing: { badge: 'bg-sky-100 text-sky-800', dot: 'bg-sky-600', label: 'Diproses' },
        confirmed: { badge: 'bg-emerald-100 text-emerald-800', dot: 'bg-emerald-600', label: 'Confirmed' },
        shipped: { badge: 'bg-purple-100 text-purple-800', dot: 'bg-purple-600', label: 'Shipped' },
        delivered: { badge: 'bg-green-100 text-green-800', dot: 'bg-green-600', label: 'Delivered' },
        pending: { badge: 'bg-orange-100 text-orange-800', dot: 'bg-orange-600', label: 'Pending' },
        waiting_confirmation: { badge: 'bg-indigo-100 text-indigo-800', dot: 'bg-indigo-600', label: 'Waiting Confirmation' },
        'menunggu konfirmasi': { badge: 'bg-indigo-100 text-indigo-800', dot: 'bg-indigo-600', label: 'Waiting Confirmation' },
        unpaid: { badge: 'bg-red-100 text-red-800', dot: 'bg-red-600', label: 'Unpaid' },
        cancelled: { badge: 'bg-stone-200 text-stone-600', dot: 'bg-stone-400', label: 'Cancelled' },
      };
      const st = map[status.toLowerCase()] || map.pending;
      return `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold ${st.badge}"><span class="w-1.5 h-1.5 rounded-full ${st.dot}"></span>${st.label}</span>`;
    }

    // Load customer dashboard stats and table data
    async function loadDashboard() {
      try {
        const { orders, meta } = await getCustomerOrders({ per_page: 50 });

        // Auto-cancel expired pending/waiting_confirmation orders (matching transactions page)
        orders.forEach(order => {
          const createdAt = new Date(order.created_at).getTime();
          const expireTime = createdAt + 24 * 60 * 60 * 1000;
          const isExpired = Date.now() > expireTime;
          const stLower = (order.status || '').toLowerCase();
          if ((stLower === 'pending' || stLower === 'waiting_confirmation') && isExpired) {
            order.status = 'cancelled';
            cancelCustomerOrder(order.id).catch(err => console.error("Failed auto-cancel order:", err));
          }
        });
        
        // Calculate statistics
        const total = meta?.total !== undefined ? meta.total : orders.length;
        const pending = orders.filter(o => {
          const s = (o.status || '').toLowerCase();
          return s === 'pending' || s === 'unpaid' || s === 'waiting_confirmation' || s === 'menunggu konfirmasi';
        }).length;
        const processing = orders.filter(o => {
          const s = (o.status || '').toLowerCase();
          return s === 'processing' || s === 'processed' || s === 'diproses' || s === 'confirmed';
        }).length;
        const completed = orders.filter(o => {
          const s = (o.status || '').toLowerCase();
          return s === 'completed' || s === 'done' || s === 'success' || s === 'shipped' || s === 'delivered';
        }).length;

        document.getElementById('statTotalOrders')!.textContent = total.toLocaleString();
        document.getElementById('statPending')!.textContent = pending.toLocaleString();
        document.getElementById('statProcessing')!.textContent = processing.toLocaleString();
        document.getElementById('statCompleted')!.textContent = completed.toLocaleString();

        // Populate Table
        const tbody = document.getElementById('recentOrdersBody')!;
        if (!orders || orders.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" class="py-12 text-center text-stone-400">You have no orders yet</td></tr>`;
          document.getElementById('ordersPagInfo')!.innerHTML = `<p class="text-xs text-stone-400 font-medium">Showing 0 of 0 orders</p>`;
        } else {
          // Limit to recent 5 in the table view for visual consistency
          const recentOrders = orders.slice(0, 5);
          tbody.innerHTML = recentOrders.map(order => {
            let itemsLabel = 'Order';
            if (order.items && order.items.length > 0) {
              const hasBook = order.items.some((i: any) => i.book_id);
              const hasService = order.items.some((i: any) => i.service_id);
              if (hasBook && hasService) itemsLabel = 'Order Service & Book';
              else if (hasBook) itemsLabel = 'Order Book';
              else if (hasService) itemsLabel = 'Order Service';
            }

            return `
            <tr class="group hover:bg-surface-container-low/50 transition-colors whitespace-nowrap">
              <td class="py-4 md:py-6 px-3 md:px-4 font-bold text-primary whitespace-nowrap">${order.invoice}</td>
              <td class="py-4 md:py-6 px-3 md:px-4 text-stone-600 whitespace-nowrap">${itemsLabel}</td>
              <td class="py-4 md:py-6 px-3 md:px-4 text-stone-500 whitespace-nowrap">${order.total_qty}</td>
              <td class="py-4 md:py-6 px-3 md:px-4 font-bold text-primary whitespace-nowrap">${formatRupiah(order.total_price)}</td>
              <td class="py-4 md:py-6 px-3 md:px-4 whitespace-nowrap">${getStatusHTML(order.status)}</td>
            </tr>`;
          }).join('');

          document.getElementById('ordersPagInfo')!.innerHTML = `<p class="text-xs text-stone-400 font-medium">Showing ${recentOrders.length} of ${Number(meta.total).toLocaleString()} orders</p>`;
        }

      } catch (err: any) {
        if (err?.status === 401) {
          removeToken();
          localStorage.removeItem('dp_user');
          window.location.href = '/customer-login';
          return;
        }
        document.getElementById('recentOrdersBody')!.innerHTML = `<tr><td colspan="5" class="py-12 text-center text-red-400">Failed to load orders history</td></tr>`;
        document.getElementById('ordersPagInfo')!.textContent = '';
      }
    }

    loadDashboard();
  </script>
</CustomerLayout>
