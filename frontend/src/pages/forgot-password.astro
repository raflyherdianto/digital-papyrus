---
/**
 * Forgot Password Page
 * Route: /forgot-password
 */
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Forgot Password | Digital Papyrus">
  <div class="w-full max-w-md bg-surface-container-lowest rounded-2xl shadow-xl p-8 md:p-10 border border-outline-variant/10">
    <div class="text-center mb-8 md:mb-10">
      <h2 class="font-headline text-2xl md:text-3xl font-bold tracking-tight text-primary">Forgot Password</h2>
      <p class="text-on-surface-variant text-sm md:text-base mt-2">Enter your email to receive a password reset link.</p>
    </div>

    <form class="space-y-6" id="forgot-form" novalidate>
      <div>
        <label class="block text-sm font-medium text-primary mb-2" for="email-input">Email Address</label>
        <div class="relative flex items-center bg-surface-container px-4 py-3 rounded-xl border border-outline-variant/30 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/30 transition-all">
          <span class="material-symbols-outlined text-outline text-lg mr-3">mail</span>
          <input
            id="email-input"
            type="email"
            placeholder="email@example.com"
            required
            class="bg-transparent w-full text-sm focus:outline-none text-on-surface placeholder:text-outline-variant"
          />
        </div>
      </div>

      <!-- Puzzle CAPTCHA Section -->
      <div id="captcha-container" class="space-y-4 py-2">
        <div class="text-center">
          <p class="text-[10px] uppercase tracking-[0.2em] text-outline-variant font-bold mb-3">Security Verification</p>
        </div>
        
        <div class="relative w-full aspect-[16/9] bg-surface-container rounded-xl overflow-hidden shadow-inner border border-outline-variant/20" id="puzzle-box">
          <canvas id="puzzle-main" class="w-full h-full object-cover"></canvas>
          <canvas id="puzzle-piece" class="absolute top-0 left-0 w-full h-full pointer-events-none"></canvas>
          
          <!-- Success Overlay -->
          <div id="puzzle-success" class="absolute inset-0 bg-green-500/20 backdrop-blur-[2px] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
            <div class="bg-white rounded-full p-2 shadow-lg">
              <span class="material-symbols-outlined text-green-600 text-3xl">check_circle</span>
            </div>
          </div>
        </div>

        <div class="relative w-full h-12 bg-surface-container rounded-full border border-outline-variant/30 flex items-center p-1 group">
          <div id="slider-track" class="absolute left-0 top-0 h-full bg-primary/10 rounded-full w-0"></div>
          <input 
            type="range" 
            id="puzzle-slider" 
            min="0" 
            max="100" 
            value="0" 
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
          />
          <div id="slider-thumb" class="relative z-10 w-10 h-10 bg-primary text-on-primary rounded-full shadow-lg flex items-center justify-center transition-transform group-hover:scale-105 active:scale-95">
            <span class="material-symbols-outlined text-base">chevron_right</span>
          </div>
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <span class="text-[10px] font-bold uppercase tracking-widest text-outline-variant animate-pulse" id="slider-text">Slide to complete puzzle</span>
          </div>
        </div>
      </div>

      <button
        type="submit"
        id="submit-btn"
        disabled
        class="w-full py-4 bg-primary text-on-primary font-bold rounded-xl shadow-md hover:bg-primary/90 flex items-center justify-center gap-2 transition-all text-base disabled:opacity-40 disabled:grayscale disabled:cursor-not-allowed"
      >
        <span class="material-symbols-outlined text-sm" id="btn-icon">send</span>
        <span id="btn-text">Send Reset Link</span>
      </button>

      <div class="text-center mt-6">
        <p class="text-on-surface-variant text-sm">
          Remember your password? <a href="/customer-login" class="text-primary font-bold hover:underline">Sign in here</a>
        </p>
      </div>
    </form>
  </div>

  <!-- Custom Status Modal Popup -->
  <div id="status-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-900/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant/20 rounded-2xl max-w-sm w-full p-6 shadow-2xl scale-95 transition-transform duration-300" id="status-modal-content">
      <div class="flex flex-col items-center text-center">
        <!-- Status Icon Circle -->
        <div id="status-modal-icon-bg" class="w-16 h-16 rounded-full flex items-center justify-center mb-4">
          <span id="status-modal-icon" class="material-symbols-outlined text-3xl">info</span>
        </div>
        <h3 id="status-modal-title" class="font-headline font-bold text-lg text-primary mb-2">Notice</h3>
        <p id="status-modal-message" class="text-sm text-on-surface-variant leading-relaxed mb-6"></p>
        <button id="status-modal-close" class="w-full py-3 bg-primary text-on-primary font-bold rounded-xl shadow-md hover:bg-primary/90 transition-all text-sm">
          Okay
         </button>
      </div>
    </div>
  </div>
</AuthLayout>

<script>
  import { requestPasswordReset } from '../lib/api';

  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnIcon = document.getElementById('btn-icon')!;
  const btnText = document.getElementById('btn-text')!;

  // Modal elements
  const statusModal = document.getElementById('status-modal')!;
  const statusModalContent = document.getElementById('status-modal-content')!;
  const statusModalIconBg = document.getElementById('status-modal-icon-bg')!;
  const statusModalIcon = document.getElementById('status-modal-icon')!;
  const statusModalTitle = document.getElementById('status-modal-title')!;
  const statusModalMessage = document.getElementById('status-modal-message')!;
  const statusModalClose = document.getElementById('status-modal-close')!;

  let redirectUrlOnClose = '';

  // Puzzle CAPTCHA Logic
  const mainCanvas = document.getElementById('puzzle-main') as HTMLCanvasElement;
  const pieceCanvas = document.getElementById('puzzle-piece') as HTMLCanvasElement;
  const slider = document.getElementById('puzzle-slider') as HTMLInputElement;
  const thumb = document.getElementById('slider-thumb');
  const track = document.getElementById('slider-track');
  const successOverlay = document.getElementById('puzzle-success');
  const sliderText = document.getElementById('slider-text');

  let puzzleX = 0;
  let puzzleY = 0;
  let isSolved = false;

  async function initPuzzle() {
    if (!mainCanvas || !pieceCanvas) return;
    
    if (mainCanvas.clientWidth === 0) {
      requestAnimationFrame(initPuzzle);
      return;
    }

    const ctx = mainCanvas.getContext('2d')!;
    const pCtx = pieceCanvas.getContext('2d')!;
    
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.src = "https://images.unsplash.com/photo-1614850523296-d8c1af93d400?auto=format&fit=crop&w=600&q=80";
    
    img.onerror = () => {
      img.src = "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=600&q=80";
    };

    img.onload = () => {
      const w = mainCanvas.clientWidth;
      const h = mainCanvas.clientHeight;
      mainCanvas.width = w;
      mainCanvas.height = h;
      pieceCanvas.width = w;
      pieceCanvas.height = h;

      ctx.drawImage(img, 0, 0, w, h);

      puzzleX = Math.floor(Math.random() * (w / 2 - 80)) + w / 2;
      puzzleY = Math.floor(Math.random() * (h - 70)) + 20;

      const size = 45;
      const drawPiece = (c: CanvasRenderingContext2D, x: number, y: number) => {
        c.beginPath();
        c.moveTo(x, y);
        c.lineTo(x + size / 2 - 5, y);
        c.arc(x + size / 2, y, 8, Math.PI, 0);
        c.lineTo(x + size, y);
        c.lineTo(x + size, y + size / 2 - 5);
        c.arc(x + size, y + size / 2, 8, 1.5 * Math.PI, 0.5 * Math.PI);
        c.lineTo(x + size, y + size);
        c.lineTo(x, y + size);
        c.closePath();
      };

      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      drawPiece(ctx, puzzleX, puzzleY);
      ctx.fill();
      ctx.strokeStyle = 'rgba(255,255,255,0.6)';
      ctx.stroke();

      pCtx.save();
      drawPiece(pCtx, 0, puzzleY);
      pCtx.clip();
      pCtx.drawImage(img, -puzzleX, 0, w, h);
      pCtx.restore();
      
      pCtx.strokeStyle = 'rgba(255,255,255,0.9)';
      pCtx.lineWidth = 2;
      drawPiece(pCtx, 0, puzzleY);
      pCtx.stroke();
    };
  }

  if (slider && thumb && track) {
    slider.addEventListener('input', (e) => {
      if (isSolved) return;
      const val = parseInt((e.target as HTMLInputElement).value);
      const moveX = (val / 100) * (mainCanvas.clientWidth - 50);
      
      pieceCanvas.style.transform = `translateX(${moveX}px)`;
      thumb.style.transform = `translateX(${moveX}px)`;
      track.style.width = `${moveX + 20}px`;
    });

    slider.addEventListener('change', (e) => {
      if (isSolved) return;
      const val = parseInt((e.target as HTMLInputElement).value);
      const moveX = (val / 100) * (mainCanvas.clientWidth - 50);
      
      const diff = Math.abs(moveX - puzzleX);
      if (diff < 6) {
        isSolved = true;
        successOverlay?.classList.remove('opacity-0');
        successOverlay?.classList.add('opacity-100');
        sliderText!.textContent = "Verification Success";
        sliderText!.classList.remove('animate-pulse');
        sliderText!.classList.add('text-green-600');
        slider.disabled = true;
        submitBtn.disabled = false;
      } else {
        slider.value = "0";
        pieceCanvas.style.transform = 'translateX(0)';
        thumb.style.transform = 'translateX(0)';
        track.style.width = '0';
      }
    });
  }

  initPuzzle();

  function showModal(title: string, message: string, type: 'info' | 'error' | 'success' = 'info', redirectUrl = '') {
    redirectUrlOnClose = redirectUrl;
    statusModalTitle.textContent = title;
    statusModalMessage.textContent = message;

    statusModalIconBg.className = 'w-16 h-16 rounded-full flex items-center justify-center mb-4';
    statusModalIcon.className = 'material-symbols-outlined text-3xl';

    if (type === 'success') {
      statusModalIconBg.classList.add('bg-green-500/10', 'text-green-600');
      statusModalIcon.textContent = 'check_circle';
      statusModalClose.className = 'w-full py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-xl shadow-md transition-all text-sm';
    } else if (type === 'error') {
      statusModalIconBg.classList.add('bg-red-500/10', 'text-red-600');
      statusModalIcon.textContent = 'error';
      statusModalClose.className = 'w-full py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl shadow-md transition-all text-sm';
    } else {
      statusModalIconBg.classList.add('bg-primary/10', 'text-primary');
      statusModalIcon.textContent = 'info';
      statusModalClose.className = 'w-full py-3 bg-primary hover:bg-primary/90 text-on-primary font-bold rounded-xl shadow-md transition-all text-sm';
    }

    statusModal.classList.remove('hidden');
    requestAnimationFrame(() => {
      statusModal.classList.remove('opacity-0');
      statusModal.classList.add('opacity-100');
      statusModalContent.classList.remove('scale-95');
      statusModalContent.classList.add('scale-100');
    });
  }

  function hideModal() {
    statusModal.classList.remove('opacity-100');
    statusModal.classList.add('opacity-0');
    statusModalContent.classList.remove('scale-100');
    statusModalContent.classList.add('scale-95');
    setTimeout(() => {
      statusModal.classList.add('hidden');
      if (redirectUrlOnClose) {
        window.location.href = redirectUrlOnClose;
      }
    }, 300);
  }

  if (statusModalClose) {
    statusModalClose.addEventListener('click', hideModal);
  }
  if (statusModal) {
    statusModal.addEventListener('click', (e) => {
      if (e.target === statusModal) {
        hideModal();
      }
    });
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Sending link...' : 'Send Reset Link';
    btnIcon.textContent = loading ? 'hourglass_empty' : 'send';
    if (loading) btnIcon.classList.add('animate-spin');
    else btnIcon.classList.remove('animate-spin');
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();

      if (!email || !email.includes('@')) {
        showModal('Error', 'Silakan masukkan alamat email yang valid.', 'error');
        return;
      }

      if (!isSolved) {
        showModal('Verification Required', 'Silakan selesaikan puzzle verifikasi terlebih dahulu.', 'error');
        return;
      }

      setLoading(true);

      try {
        await requestPasswordReset(email);
        setLoading(false);
        showModal('Success', 'Link reset password telah dikirim ke email Anda.', 'success', '/customer-login');
      } catch (err: any) {
        setLoading(false);
        if (err.status === 404 && err.message === 'Email tidak terdaftar') {
          showModal('Error', 'Email tidak valid!', 'error');
        } else {
          showModal('Error', err.message || 'Gagal memproses permintaan reset password.', 'error');
        }
      }
    });
  }
</script>
