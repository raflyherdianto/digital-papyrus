---
/**
 * Admin User Management Page
 * Route: /admin-user
 * Dynamically fetches and manages user data via the backend API.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="User Management | Digital Papyrus" activePage="users">
  <div class="flex flex-col md:flex-row items-start md:items-baseline justify-between mb-6 md:mb-8 gap-4">
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-primary font-headline mb-2">User Management</h2>
      <p class="text-stone-500 font-body text-sm max-w-xl">Manage administrators, authors, and customers across the platform.</p>
    </div>
    <div class="flex gap-3 md:gap-4 w-full md:w-auto">
      <button id="addUserBtn" class="flex-1 md:flex-none px-4 md:px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-xs md:text-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/10">
        <span class="material-symbols-outlined text-sm">person_add</span> <span class="hidden sm:inline">Add New User</span>
      </button>
    </div>
  </div>

  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-6 border border-stone-200/20 shadow-sm mb-6 md:mb-8 flex flex-col md:flex-row flex-wrap items-start md:items-center gap-3 md:gap-4 justify-between">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4 flex-1 w-full md:w-auto">
      <div class="relative w-full sm:max-w-sm">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm">search</span>
        <input id="searchInput" class="w-full bg-surface-container py-2.5 pl-10 pr-4 rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-stone-400" placeholder="Search by name or email..." type="text" />
      </div>
      <select id="roleFilter" class="bg-surface-container py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border-none focus:ring-2 focus:ring-primary/20 text-stone-600 outline-none w-full sm:w-auto">
        <option value="">All Roles</option>
        <option value="superadmin">Superadmin</option>
        <option value="author">Author</option>
        <option value="customer">Customer</option>
      </select>
    </div>
  </div>

  <div class="bg-surface-container-lowest rounded-xl p-4 md:p-8 border border-stone-200/10 shadow-sm w-full max-w-full min-w-0 overflow-hidden">
    <div class="table-responsive-container overflow-x-auto w-full max-w-full block">
      <table class="w-full text-left min-w-[800px] border-collapse">
        <thead>
          <tr class="text-stone-400 font-label text-[10px] uppercase tracking-widest border-b border-stone-200/30">
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">User Details</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Role</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Status</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 font-semibold whitespace-nowrap">Joined Date</th>
            <th class="pb-4 md:pb-6 px-3 md:px-4 text-right whitespace-nowrap">Actions</th>
          </tr>
        </thead>
        <tbody id="userTableBody" class="text-sm font-body">
          <tr id="loadingRow">
            <td colspan="5" class="py-16 text-center">
              <div class="flex flex-col items-center gap-3">
                <span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span>
                <p class="text-stone-400 text-sm">Loading users...</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between border-t border-stone-200/20 pt-6 gap-4">
      <p id="paginationInfo" class="text-xs text-stone-400 font-medium">Loading...</p>
      <div id="paginationControls" class="flex gap-1.5"></div>
    </div>
  </div>

  <div id="toast" class="fixed bottom-6 right-6 z-[10000] hidden transform translate-y-4 opacity-0 transition-all duration-300">
    <div class="flex items-center gap-3 bg-stone-800 text-white px-5 py-3 rounded-xl shadow-2xl text-sm font-medium">
      <span id="toastIcon" class="material-symbols-outlined text-lg text-teal-400">check_circle</span>
      <span id="toastMsg">Operation successful</span>
    </div>
  </div>

  <!-- Add User Modal -->
  <div id="addUserModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-xl mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="addUserModalContent">
      <div class="px-6 md:px-8 py-6 border-b border-stone-200/50 flex items-center justify-between">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Add New User</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="addUserModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6">
        <form id="addUserForm" class="space-y-4">
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Full Name *</label>
            <input name="name" type="text" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: John Doe" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Email Address *</label>
            <input name="email" type="email" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: john@example.com" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Password *</label>
            <input name="password" type="password" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Min. 8 characters" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Phone Number</label>
            <input name="phone_number" type="tel" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: 081234567890" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Address</label>
            <input name="address" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Street name, building, house number" />
          </div>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Province</label>
              <input name="province" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Province" />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">City</label>
              <input name="city" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="City" />
            </div>
            <div class="space-y-2 col-span-2 md:col-span-1">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Zip Code</label>
              <input name="zip_code" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Zip Code" />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Role *</label>
              <select name="role" required class="w-full bg-surface py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                <option value="customer">Customer</option>
                <option value="author">Author</option>
                <option value="superadmin">Superadmin</option>
              </select>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Status</label>
              <select name="is_active" class="w-full bg-surface py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="px-6 md:px-8 py-5 bg-surface-container flex items-center justify-end gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn px-5 py-2.5 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="addUserModal">Cancel</button>
        <button id="saveUserBtn" class="px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-sm hover:opacity-90 transition-all shadow-lg shadow-primary/10 disabled:opacity-50" type="button">Save User</button>
      </div>
    </div>
  </div>

  <!-- Edit User Modal -->
  <div id="editUserModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-2xl mx-4 rounded-2xl shadow-xl transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh] overflow-hidden" id="editUserModalContent">
      <div class="px-6 md:px-8 py-5 border-b border-stone-200/50 flex items-center justify-between flex-shrink-0">
        <h3 class="text-lg md:text-xl font-bold text-primary font-headline">Edit User</h3>
        <button class="closeModalBtn text-stone-400 hover:text-stone-600 transition-colors" data-modal="editUserModal"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 md:px-8 py-6 overflow-y-auto flex-1 custom-scrollbar">
        <form id="editUserForm" class="space-y-4">
          <input type="hidden" name="id" />
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Full Name *</label>
            <input name="name" type="text" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: John Doe" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Email Address *</label>
            <input name="email" type="email" required class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: john@example.com" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">New Password <span class="text-stone-400 lowercase normal-case">(Leave blank to keep current)</span></label>
            <input name="password" type="password" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="New password" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Phone Number</label>
            <input name="phone_number" type="tel" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Example: 081234567890" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Address</label>
            <input name="address" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Street name, building, house number" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
            <!-- Province -->
            <div class="space-y-1.5 relative" id="edit_province_wrapper">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Province</label>
              <div class="relative">
                <input id="edit_province_input" name="province" type="text" autocomplete="off" class="w-full bg-surface py-2.5 pl-4 pr-10 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-stone-400" placeholder="Search province..." />
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none text-xl">arrow_drop_down</span>
              </div>
              <div id="edit_province_list" class="hidden absolute left-0 right-0 top-full mt-1.5 z-[100] bg-surface-container-lowest border border-stone-200 rounded-xl shadow-2xl max-h-56 overflow-y-auto custom-scrollbar"></div>
            </div>

            <!-- City / Regency -->
            <div class="space-y-1.5 relative" id="edit_city_wrapper">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">City / Regency</label>
              <div class="relative">
                <input id="edit_city_input" name="city" type="text" autocomplete="off" class="w-full bg-surface py-2.5 pl-4 pr-10 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-stone-400" placeholder="Search city/regency..." />
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none text-xl">arrow_drop_down</span>
              </div>
              <div id="edit_city_list" class="hidden absolute left-0 right-0 top-full mt-1.5 z-[100] bg-surface-container-lowest border border-stone-200 rounded-xl shadow-2xl max-h-56 overflow-y-auto custom-scrollbar"></div>
            </div>

            <!-- District (Kecamatan) -->
            <div class="space-y-1.5 relative" id="edit_district_wrapper">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">District (Kecamatan)</label>
              <div class="relative">
                <input id="edit_district_input" name="district" type="text" autocomplete="off" class="w-full bg-surface py-2.5 pl-4 pr-10 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-stone-400" placeholder="Search district..." />
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none text-xl">arrow_drop_down</span>
              </div>
              <div id="edit_district_list" class="hidden absolute left-0 right-0 top-full mt-1.5 z-[100] bg-surface-container-lowest border border-stone-200 rounded-xl shadow-2xl max-h-56 overflow-y-auto custom-scrollbar"></div>
            </div>

            <!-- Village (Kelurahan) -->
            <div class="space-y-1.5 relative" id="edit_village_wrapper">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Village (Kelurahan)</label>
              <div class="relative">
                <input id="edit_village_input" name="village" type="text" autocomplete="off" class="w-full bg-surface py-2.5 pl-4 pr-10 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-stone-400" placeholder="Search village..." />
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none text-xl">arrow_drop_down</span>
              </div>
              <div id="edit_village_list" class="hidden absolute left-0 right-0 top-full mt-1.5 z-[100] bg-surface-container-lowest border border-stone-200 rounded-xl shadow-2xl max-h-56 overflow-y-auto custom-scrollbar"></div>
            </div>

            <!-- Zip Code -->
            <div class="space-y-1.5 sm:col-span-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Zip Code</label>
              <input id="edit_zip_code_input" name="zip_code" type="text" class="w-full bg-surface py-2.5 px-4 rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Zip Code" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Role *</label>
              <select name="role" required class="w-full bg-surface py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                <option value="customer">Customer</option>
                <option value="author">Author</option>
                <option value="superadmin">Superadmin</option>
              </select>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-stone-500 uppercase tracking-wider">Status</label>
              <select name="is_active" class="w-full bg-surface py-2.5 pl-4 pr-10 cursor-pointer rounded-xl text-sm border border-stone-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="px-6 md:px-8 py-5 bg-surface-container flex items-center justify-end gap-3 border-t border-stone-200/50 flex-shrink-0">
        <button class="closeModalBtn px-5 py-2.5 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="editUserModal">Cancel</button>
        <button id="updateUserBtn" class="px-5 py-2.5 bg-primary text-white font-bold rounded-xl text-sm hover:opacity-90 transition-all shadow-lg shadow-primary/10 disabled:opacity-50" type="button">Save Changes</button>
      </div>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-surface-container-lowest w-full max-w-sm mx-4 rounded-2xl shadow-xl overflow-hidden transform scale-95 transition-transform duration-300" id="deleteModalContent">
      <div class="p-6 md:p-8 text-center">
        <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-3xl text-red-500">person_remove</span>
        </div>
        <h3 class="text-lg font-bold text-primary font-headline mb-2">Delete User?</h3>
        <p class="text-sm text-stone-500">This action cannot be undone. User "<span id="deleteUserName" class="font-semibold text-stone-700"></span>" will be permanently removed.</p>
      </div>
      <div class="px-6 md:px-8 py-4 bg-surface-container flex items-center justify-center gap-3 border-t border-stone-200/50">
        <button class="closeModalBtn flex-1 px-5 py-2.5 text-stone-600 font-bold rounded-xl text-sm hover:bg-stone-200/50 transition-all" data-modal="deleteModal">Cancel</button>
        <button id="confirmDeleteBtn" class="flex-1 px-5 py-2.5 bg-red-500 text-white font-bold rounded-xl text-sm hover:bg-red-600 transition-all disabled:opacity-50">Delete</button>
      </div>
    </div>
  </div>

  <script>
    import { getUsers, createUser, updateUser, deleteUser, isAuthenticated, getProvinces, getRegencies, getDistricts, getVillages } from '../lib/api';
    import type { User, RegionOption } from '../lib/api';

    if (!isAuthenticated()) {
      window.location.href = '/admin-login';
    }

    const tableBody = document.getElementById('userTableBody')!;
    const paginationInfo = document.getElementById('paginationInfo')!;
    const paginationControls = document.getElementById('paginationControls')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const roleFilter = document.getElementById('roleFilter') as HTMLSelectElement;

    let allUsers: User[] = [];
    let currentPage = 1;
    const perPage = 10;
    let searchKeyword = '';
    let selectedRole = '';
    let deleteTargetId = '';

    document.querySelectorAll('#addUserModal, #editUserModal, #deleteModal, #toast').forEach(el => {
      document.body.appendChild(el);
    });

    function formatDate(dateStr: string): string {
      if (!dateStr) return '--';
      return new Date(dateStr).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function showToast(msg: string, type: 'success' | 'error' = 'success') {
      const toast = document.getElementById('toast')!;
      const toastMsg = document.getElementById('toastMsg')!;
      const toastIcon = document.getElementById('toastIcon')!;
      toastMsg.textContent = msg;
      toastIcon.textContent = type === 'success' ? 'check_circle' : 'error';
      toastIcon.className = `material-symbols-outlined text-lg ${type === 'success' ? 'text-teal-400' : 'text-red-400'}`;
      toast.classList.remove('hidden', 'translate-y-4', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('translate-y-4', 'opacity-0');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3000);
    }

    function openModal(id: string) {
      const wrap = document.getElementById(id);
      const content = document.getElementById(id + 'Content');
      if (!wrap || !content) return;
      wrap.classList.remove('hidden');
      setTimeout(() => {
        wrap.classList.remove('opacity-0');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
      }, 10);
    }

    function closeModalById(id: string) {
      const wrap = document.getElementById(id);
      const content = document.getElementById(id + 'Content');
      if (!wrap || !content) return;
      wrap.classList.add('opacity-0');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
      setTimeout(() => wrap.classList.add('hidden'), 300);
      if (id === 'editUserModal') {
        [editProvList, editCityList, editDistList, editVillList].forEach(el => el?.classList.add('hidden'));
      }
    }

    // --- Searchable Region Dropdowns (Edit User Modal) ---
    interface DropdownInstance {
      setOptions: (opts: RegionOption[]) => void;
      getOptions: () => RegionOption[];
      getSelectedCode: () => string;
      getSelectedName: () => string;
      setSelected: (val: string) => void;
      clear: () => void;
    }

    function initSearchableDropdown(
      inputEl: HTMLInputElement,
      listEl: HTMLDivElement,
      fetchFn: () => Promise<RegionOption[]>,
      onSelect: (option: RegionOption) => void,
      onClear: () => void
    ): DropdownInstance {
      let allOptions: RegionOption[] = [];
      let selectedCode: string | null = null;
      let selectedName: string = '';

      function renderOptions(opts: RegionOption[]) {
        listEl.innerHTML = '';
        if (opts.length === 0) {
          listEl.innerHTML = '<div class="px-4 py-3 text-stone-400 text-xs italic text-center">No results found</div>';
          return;
        }
        opts.forEach(opt => {
          const item = document.createElement('div');
          item.className = 'w-full px-4 py-2.5 text-stone-700 hover:bg-primary/10 hover:text-primary cursor-pointer text-sm transition-colors border-b border-stone-100 last:border-b-0 whitespace-normal break-words leading-relaxed text-left font-medium select-none';
          item.textContent = opt.name;
          item.addEventListener('click', (e) => {
            e.stopPropagation();
            inputEl.value = opt.name;
            selectedCode = opt.code;
            selectedName = opt.name;
            listEl.classList.add('hidden');
            onSelect(opt);
          });
          listEl.appendChild(item);
        });
      }

      // Open on focus
      inputEl.addEventListener('focus', async () => {
        if (allOptions.length === 0) {
          listEl.innerHTML = '<div class="px-4 py-3 text-stone-400 text-xs italic text-center">Loading options...</div>';
          listEl.classList.remove('hidden');
          try {
            allOptions = await fetchFn();
            renderOptions(allOptions);
          } catch (err) {
            listEl.innerHTML = '<div class="px-4 py-3 text-red-500 text-xs text-center">Failed to load options</div>';
          }
        } else {
          const term = inputEl.value.toLowerCase().trim();
          const filtered = term ? allOptions.filter(opt => opt.name.toLowerCase().includes(term) || opt.code.toLowerCase().includes(term)) : allOptions;
          renderOptions(filtered);
          listEl.classList.remove('hidden');
        }
      });

      // Toggle / reopen on click
      inputEl.addEventListener('click', (e) => {
        e.stopPropagation();
        if (listEl.classList.contains('hidden') && allOptions.length > 0) {
          const term = inputEl.value.toLowerCase().trim();
          const filtered = term ? allOptions.filter(opt => opt.name.toLowerCase().includes(term) || opt.code.toLowerCase().includes(term)) : allOptions;
          renderOptions(filtered);
          listEl.classList.remove('hidden');
        }
      });

      // Filter on input
      inputEl.addEventListener('input', () => {
        const term = inputEl.value.toLowerCase().trim();
        const filtered = allOptions.filter(opt => opt.name.toLowerCase().includes(term) || opt.code.toLowerCase().includes(term));
        renderOptions(filtered);
        listEl.classList.remove('hidden');
        if (term === '') {
          selectedCode = null;
          selectedName = '';
          onClear();
        } else {
          const exact = allOptions.find(opt => opt.name.toLowerCase() === term || opt.code.toLowerCase() === term);
          if (exact) {
            selectedCode = exact.code;
            selectedName = exact.name;
          } else {
            selectedCode = null;
            selectedName = '';
          }
        }
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (!inputEl.parentElement?.contains(target) && !listEl.contains(target)) {
          listEl.classList.add('hidden');
        }
      });

      return {
        setOptions: (opts: RegionOption[]) => {
          allOptions = opts;
          if (selectedCode) {
            const found = opts.find(opt => opt.code === selectedCode || opt.name.toLowerCase() === selectedCode?.toLowerCase());
            if (found) {
              inputEl.value = found.name;
              selectedCode = found.code;
              selectedName = found.name;
            }
          }
        },
        getOptions: () => allOptions,
        getSelectedCode: () => selectedCode || inputEl.value.trim(),
        getSelectedName: () => selectedName || inputEl.value.trim(),
        setSelected: (val: string) => {
          if (!val) {
            inputEl.value = '';
            selectedCode = null;
            selectedName = '';
            return;
          }
          const found = allOptions.find(opt => opt.code === val || opt.name.toLowerCase() === val.toLowerCase());
          if (found) {
            inputEl.value = found.name;
            selectedCode = found.code;
            selectedName = found.name;
          } else {
            inputEl.value = val;
            selectedCode = val;
            selectedName = val;
          }
        },
        clear: () => {
          inputEl.value = '';
          selectedCode = null;
          selectedName = '';
          allOptions = [];
          listEl.innerHTML = '';
          listEl.classList.add('hidden');
        }
      };
    }

    const editProvInput = document.getElementById('edit_province_input') as HTMLInputElement;
    const editProvList = document.getElementById('edit_province_list') as HTMLDivElement;
    const editCityInput = document.getElementById('edit_city_input') as HTMLInputElement;
    const editCityList = document.getElementById('edit_city_list') as HTMLDivElement;
    const editDistInput = document.getElementById('edit_district_input') as HTMLInputElement;
    const editDistList = document.getElementById('edit_district_list') as HTMLDivElement;
    const editVillInput = document.getElementById('edit_village_input') as HTMLInputElement;
    const editVillList = document.getElementById('edit_village_list') as HTMLDivElement;
    const editZipInput = document.getElementById('edit_zip_code_input') as HTMLInputElement;

    const provDropdown = initSearchableDropdown(
      editProvInput,
      editProvList,
      async () => getProvinces(),
      async (prov) => {
        cityDropdown.clear();
        districtDropdown.clear();
        villageDropdown.clear();
        const cities = await getRegencies(prov.code);
        cityDropdown.setOptions(cities);
      },
      () => {
        cityDropdown.clear();
        districtDropdown.clear();
        villageDropdown.clear();
      }
    );

    const cityDropdown = initSearchableDropdown(
      editCityInput,
      editCityList,
      async () => {
        const provCode = provDropdown.getSelectedCode();
        if (!provCode) return [];
        return getRegencies(provCode);
      },
      async (city) => {
        districtDropdown.clear();
        villageDropdown.clear();
        const districts = await getDistricts(city.code);
        districtDropdown.setOptions(districts);
      },
      () => {
        districtDropdown.clear();
        villageDropdown.clear();
      }
    );

    const districtDropdown = initSearchableDropdown(
      editDistInput,
      editDistList,
      async () => {
        const cityCode = cityDropdown.getSelectedCode();
        if (!cityCode) return [];
        return getDistricts(cityCode);
      },
      async (dist) => {
        villageDropdown.clear();
        const villages = await getVillages(dist.code);
        villageDropdown.setOptions(villages);
      },
      () => {
        villageDropdown.clear();
      }
    );

    const villageDropdown = initSearchableDropdown(
      editVillInput,
      editVillList,
      async () => {
        const distCode = districtDropdown.getSelectedCode();
        if (!distCode) return [];
        return getVillages(distCode);
      },
      (vill) => {
        if (vill.postal_codes && vill.postal_codes.length > 0 && editZipInput) {
          editZipInput.value = vill.postal_codes[0];
        }
      },
      () => {}
    );

    async function populateUserRegions(user: User) {
      provDropdown.clear();
      cityDropdown.clear();
      districtDropdown.clear();
      villageDropdown.clear();

      try {
        const provinces = await getProvinces();
        provDropdown.setOptions(provinces);

        if (user.province) {
          provDropdown.setSelected(user.province);
          const provCode = provDropdown.getSelectedCode();
          if (provCode) {
            const cities = await getRegencies(provCode);
            cityDropdown.setOptions(cities);

            const userCity = user.city;
            if (userCity) {
              cityDropdown.setSelected(userCity);
              const cityCode = cityDropdown.getSelectedCode();
              if (cityCode) {
                const districts = await getDistricts(cityCode);
                districtDropdown.setOptions(districts);

                const userDist = user.district || user.regency;
                if (userDist) {
                  districtDropdown.setSelected(userDist);
                  const distCode = districtDropdown.getSelectedCode();
                  if (distCode) {
                    const villages = await getVillages(distCode);
                    villageDropdown.setOptions(villages);

                    if (user.village) {
                      villageDropdown.setSelected(user.village);
                    }
                  }
                }
              }
            }
          }
        }
      } catch (err) {
        console.error('Failed to populate regions for user:', err);
      }
    }

    document.querySelectorAll('.closeModalBtn').forEach(btn => {
      btn.addEventListener('click', () => {
        const modalId = (btn as HTMLElement).dataset.modal;
        if (modalId) closeModalById(modalId);
      });
    });

    ['addUserModal', 'editUserModal', 'deleteModal'].forEach(id => {
      document.getElementById(id)?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).id === id) closeModalById(id);
      });
    });

    function getFilteredUsers(): User[] {
      const keyword = searchKeyword.toLowerCase();
      return allUsers
        .filter((u) => {
          const matchSearch = u.name.toLowerCase().includes(keyword) || u.email.toLowerCase().includes(keyword);
          const matchRole = !selectedRole || u.role === selectedRole;
          return matchSearch && matchRole;
        })
        .sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());
    }

    function renderTable() {
      const filtered = getFilteredUsers();
      const total = filtered.length;
      const totalPages = Math.max(1, Math.ceil(total / perPage));
      if (currentPage > totalPages) currentPage = totalPages;
      const startIdx = (currentPage - 1) * perPage;
      const paged = filtered.slice(startIdx, startIdx + perPage);

      if (paged.length === 0) {
        tableBody.innerHTML = `
          <tr><td colspan="5" class="py-16 text-center">
            <div class="flex flex-col items-center gap-3">
              <span class="material-symbols-outlined text-4xl text-stone-300">group_off</span>
              <p class="text-stone-400 text-sm">No users found</p>
            </div>
          </td></tr>`;
        paginationInfo.textContent = total === 0 ? 'No users' : `Showing 0 of ${total.toLocaleString()} users`;
        paginationControls.innerHTML = '';
        return;
      }

      tableBody.innerHTML = paged.map((user, idx) => {
        const borderCls = idx < paged.length - 1 ? 'border-b border-stone-200/10' : '';
        const roleBadge = user.role === 'superadmin' ? 'bg-primary/10 text-primary' : (user.role === 'author' ? 'bg-amber-100 text-amber-800' : 'bg-stone-200 text-stone-600');
        const statusBadge = user.is_active 
          ? '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-teal-100 text-teal-800"><span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>Active</span>'
          : '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-red-100 text-red-800"><span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>Inactive</span>';

        return `<tr class="group hover:bg-surface-container-low/50 transition-colors ${borderCls}" data-id="${user.id}">
          <td class="py-4 md:py-5 px-3 md:px-4 whitespace-nowrap">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-stone-200 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-stone-500">person</span>
              </div>
              <div>
                <p class="font-bold text-primary text-sm md:text-base">${user.name}</p>
                <p class="text-stone-500 text-xs">${user.email}</p>
              </div>
            </div>
          </td>
          <td class="py-4 md:py-5 px-3 md:px-4 whitespace-nowrap">
            <span class="font-bold px-2.5 py-1 rounded-full text-[11px] uppercase tracking-wider ${roleBadge}">${user.role}</span>
          </td>
          <td class="py-4 md:py-5 px-3 md:px-4 whitespace-nowrap">${statusBadge}</td>
          <td class="py-4 md:py-5 px-3 md:px-4 font-medium text-stone-600 whitespace-nowrap">${formatDate(user.created_at)}</td>
          <td class="py-4 md:py-5 px-3 md:px-4 text-right whitespace-nowrap">
            <div class="flex items-center justify-end gap-2">
              <button class="editBtn w-8 h-8 rounded-lg flex items-center justify-center text-stone-500 hover:text-primary hover:bg-stone-200/50 transition-all" title="Edit" data-id="${user.id}">
                <span class="material-symbols-outlined text-lg">edit</span>
              </button>
              <button class="deleteBtn w-8 h-8 rounded-lg flex items-center justify-center text-stone-500 hover:text-error hover:bg-stone-200/50 transition-all" title="Delete" data-id="${user.id}" data-name="${user.name}">
                <span class="material-symbols-outlined text-lg">delete</span>
              </button>
            </div>
          </td>
        </tr>`;
      }).join('');

      const start = startIdx + 1;
      const end = Math.min(startIdx + perPage, total);
      paginationInfo.textContent = `Showing ${start}-${end} of ${total.toLocaleString()} users`;

      let pagBtns = '';
      pagBtns += `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors ${currentPage <= 1 ? 'opacity-30 pointer-events-none' : ''}" data-page="${currentPage - 1}" aria-label="Previous"><span class="material-symbols-outlined text-sm text-stone-400">chevron_left</span></button>`;

      for (let p = 1; p <= totalPages; p++) {
        if (totalPages > 5 && p > 3 && p < totalPages - 1 && Math.abs(p - currentPage) > 1) {
          if (p === 4) pagBtns += `<span class="w-9 h-9 flex items-center justify-center text-stone-400 text-xs tracking-wider">...</span>`;
          continue;
        }
        pagBtns += p === currentPage
          ? `<button class="w-9 h-9 rounded-lg flex items-center justify-center bg-primary text-white font-bold text-xs">${p}</button>`
          : `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors font-medium text-xs" data-page="${p}">${p}</button>`;
      }

      pagBtns += `<button class="pagBtn w-9 h-9 rounded-lg flex items-center justify-center border border-stone-200/50 hover:bg-surface-container-low transition-colors ${currentPage >= totalPages ? 'opacity-30 pointer-events-none' : ''}" data-page="${currentPage + 1}" aria-label="Next"><span class="material-symbols-outlined text-sm text-stone-400">chevron_right</span></button>`;

      paginationControls.innerHTML = pagBtns;
      bindActionButtons();
      bindPaginationButtons();
    }

    function bindActionButtons() {
      tableBody.querySelectorAll('.editBtn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id!;
          const user = allUsers.find(u => u.id === id);
          if (!user) {
            showToast('User not found', 'error');
            return;
          }
          const form = document.getElementById('editUserForm') as HTMLFormElement;
          (form.querySelector('[name="id"]') as HTMLInputElement).value = user.id;
          (form.querySelector('[name="name"]') as HTMLInputElement).value = user.name;
          (form.querySelector('[name="email"]') as HTMLInputElement).value = user.email;
          (form.querySelector('[name="role"]') as HTMLSelectElement).value = user.role;
          (form.querySelector('[name="is_active"]') as HTMLSelectElement).value = String(user.is_active);
          (form.querySelector('[name="password"]') as HTMLInputElement).value = '';
          (form.querySelector('[name="phone_number"]') as HTMLInputElement).value = user.phone_number || '';
          (form.querySelector('[name="address"]') as HTMLInputElement).value = user.address || '';
          editZipInput.value = user.zip_code || '';
          openModal('editUserModal');
          populateUserRegions(user);
        });
      });

      tableBody.querySelectorAll('.deleteBtn').forEach(btn => {
        btn.addEventListener('click', () => {
          deleteTargetId = (btn as HTMLElement).dataset.id!;
          document.getElementById('deleteUserName')!.textContent = (btn as HTMLElement).dataset.name || '';
          openModal('deleteModal');
        });
      });
    }

    function bindPaginationButtons() {
      paginationControls.querySelectorAll('.pagBtn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentPage = parseInt((btn as HTMLElement).dataset.page || '1');
          renderTable();
        });
      });
    }

    async function loadUsers() {
      tableBody.innerHTML = `<tr><td colspan="5" class="py-16 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-4xl text-stone-300 animate-spin">progress_activity</span><p class="text-stone-400 text-sm">Loading users...</p></div></td></tr>`;
      try {
        allUsers = await getUsers();
        renderTable();
      } catch (err: any) {
        tableBody.innerHTML = `<tr><td colspan="5" class="py-16 text-center"><div class="flex flex-col items-center gap-3"><span class="material-symbols-outlined text-4xl text-red-300">error</span><p class="text-stone-500 text-sm">${err.message || 'Failed to load users'}</p><button class="retryBtn text-primary font-bold text-sm mt-2 hover:underline">Retry</button></div></td></tr>`;
        tableBody.querySelector('.retryBtn')?.addEventListener('click', loadUsers);
      }
    }

    document.getElementById('addUserBtn')?.addEventListener('click', () => {
      (document.getElementById('addUserForm') as HTMLFormElement).reset();
      openModal('addUserModal');
    });

    document.getElementById('saveUserBtn')?.addEventListener('click', async () => {
      const form = document.getElementById('addUserForm') as HTMLFormElement;
      const formData = new FormData(form);
      const btn = document.getElementById('saveUserBtn') as HTMLButtonElement;

      const payload: Partial<User> & { password?: string } = {
        name: formData.get('name') as string,
        email: formData.get('email') as string,
        password: formData.get('password') as string,
        role: formData.get('role') as any,
        is_active: formData.get('is_active') === 'true',
        phone_number: formData.get('phone_number') as string,
        address: formData.get('address') as string,
        province: formData.get('province') as string,
        city: formData.get('city') as string,
        zip_code: formData.get('zip_code') as string,
      };

      if (!payload.name || !payload.email || !payload.password) {
        showToast('Name, email, and password are required', 'error');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';
      try {
        await createUser(payload);
        closeModalById('addUserModal');
        showToast('User created successfully!');
        await loadUsers();
      } catch (err: any) {
        showToast(err.message || 'Failed to create user', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save User';
      }
    });

    document.getElementById('updateUserBtn')?.addEventListener('click', async () => {
      const form = document.getElementById('editUserForm') as HTMLFormElement;
      const formData = new FormData(form);
      const id = formData.get('id') as string;
      const btn = document.getElementById('updateUserBtn') as HTMLButtonElement;

      const payload: Partial<User> & { password?: string; district?: string } = {
        name: formData.get('name') as string,
        email: formData.get('email') as string,
        role: formData.get('role') as any,
        is_active: formData.get('is_active') === 'true',
        phone_number: formData.get('phone_number') as string,
        address: formData.get('address') as string,
        province: provDropdown.getSelectedCode(),
        city: cityDropdown.getSelectedCode(),
        regency: districtDropdown.getSelectedCode(),
        district: districtDropdown.getSelectedCode(),
        village: villageDropdown.getSelectedCode(),
        zip_code: editZipInput.value.trim(),
      };

      const password = formData.get('password') as string;
      if (password) {
        payload.password = password;
      }

      if (!payload.name || !payload.email) {
        showToast('Name and email are required', 'error');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';
      try {
        await updateUser(id, payload);
        closeModalById('editUserModal');
        showToast('User updated successfully!');
        await loadUsers();
      } catch (err: any) {
        showToast(err.message || 'Failed to update user', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save Changes';
      }
    });

    document.getElementById('confirmDeleteBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('confirmDeleteBtn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Deleting...';

      try {
        await deleteUser(deleteTargetId);
        closeModalById('deleteModal');
        showToast('User deleted successfully!');
        await loadUsers();
      } catch (err: any) {
        showToast(err.message || 'Failed to delete user', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Delete';
      }
    });

    let searchTimeout: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        searchKeyword = searchInput.value.trim();
        currentPage = 1;
        renderTable();
      }, 300);
    });

    roleFilter?.addEventListener('change', () => {
      selectedRole = roleFilter.value;
      currentPage = 1;
      renderTable();
    });

    loadUsers();
  </script>
</AdminLayout>
