# Server Configuration
APP_ENV=production
APP_PORT=8080
APP_NAME=digital-papyrus-api

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=digital_papyrus
DB_SSLMODE=disable
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/digital_papyrus?sslmode=disable

# JWT
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRY_HOURS=24

# CORS
CORS_ALLOWED_ORIGINS=https://digitalpapyrus.web.id

# Rate Limiting
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5

# Bcrypt
BCRYPT_COST=12

# User Seeding Credentials
SEED_SUPERADMIN_EMAIL=superadmin@digitalpapyrus.web.id
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_NOW
SEED_SUPERADMIN_NAME=Super Admin

SEED_DEMO_AUTHOR_EMAIL=author@digitalpapyrus.web.id
SEED_DEMO_AUTHOR_PASSWORD=CHANGE_ME_NOW
SEED_DEMO_AUTHOR_NAME=Demo Author

SEED_DEMO_CUSTOMER_EMAIL=customer@digitalpapyrus.web.id
SEED_DEMO_CUSTOMER_PASSWORD=CHANGE_ME_NOW
SEED_DEMO_CUSTOMER_NAME=Demo Customer

# SMTP Mail Server (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
